#!/bin/bash
#
# multi-surround.sh — HDMI Multi-Format Surround Encoding (AC3/DTS/EAC3)
#
# Enables real-time Dolby Digital (AC-3), DTS, or Dolby Digital Plus (E-AC-3)
# encoding over HDMI/DisplayPort via eARC.
# All audio (games, browsers, media players) is encoded to the selected format
# by the native ALSA plugin, with zero added latency and ~1-2% CPU overhead.
# Stereo content is automatically upmixed to 5.1 by PipeWire's channel mixer.
#
# This script is self-contained and can be used on any Linux system with
# PipeWire + WirePlumber (SteamOS, CachyOS, Arch, etc.) that has:
#   - An HDMI audio device (HDA ATI HDMI or similar)
#   - alsa-plugins (provides a52, dts plugins)
#   - ffmpeg (provides libavcodec used by the plugins)
#   - alsa-card-profile (provides profile set framework)
#
# Usage:
#   sudo ./multi-surround.sh install <format>   — enable surround encoding
#   sudo ./multi-surround.sh revert             — restore default HDMI stereo
#   sudo ./multi-surround.sh status             — check current state
#
# Where <format> is one of: ac3, dts, eac3
#
set -euo pipefail

# --- Colors -------------------------------------------------------------------
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
DIM='\033[2m'
RESET='\033[0m'

# --- Paths --------------------------------------------------------------------
UDEV_RULE="/etc/udev/rules.d/91-surround-audio.rules"
WP_CONF_DIR="${SUDO_USER:+$(getent passwd "$SUDO_USER" | cut -d: -f6)}${HOME:-/root}/.config/wireplumber/wireplumber.conf.d"
WP_CONF="$WP_CONF_DIR/surround-profile.conf"
ACP_PROFILE_DIR="/usr/share/alsa-card-profile/mixer/profile-sets"

# Format to profile mapping
declare -A FORMAT_PROFILES=(
    [ac3]="hdmi-ac3.conf"
    [dts]="hdmi-dts.conf"
    [eac3]="hdmi-eac3.conf"
)
declare -A FORMAT_DESC=(
    [ac3]="Dolby Digital (AC-3)"
    [dts]="DTS"
    [eac3]="Dolby Digital Plus (E-AC-3)"
)
declare -A FORMAT_PLUGIN=(
    [ac3]="a52"
    [dts]="dts"
    [eac3]="eac3"
)

# Resolve real home directory when running under sudo
if [[ -n "${SUDO_USER:-}" ]] && [[ "${SUDO_USER}" != "root" ]]; then
    REAL_HOME=$(getent passwd "$SUDO_USER" | cut -d: -f6)
    WP_CONF_DIR="$REAL_HOME/.config/wireplumber/wireplumber.conf.d"
    WP_CONF="$WP_CONF_DIR/surround-profile.conf"
else
    REAL_HOME="${HOME:-/root}"
fi

# --- Helpers ------------------------------------------------------------------
print_info()  { echo -e "  ${CYAN}i${RESET} $*"; }
print_ok()    { echo -e "  ${GREEN}✓${RESET} $*"; }
print_error() { echo -e "  ${RED}✗${RESET} $*"; }
print_warn()  { echo -e "  ${YELLOW}⚠${RESET} $*"; }
print_step()  { echo -e "\n${BOLD}${CYAN}[$1]${RESET} $2"; }

confirm() {
    local resp
    read -rp "$(echo -e "  ${BOLD}${YELLOW}$1 (y/N): ${RESET}")" resp
    [[ "${resp,,}" == "y" || "${resp,,}" == "yes" ]]
}

is_steamos() {
    [[ -f /etc/os-release ]] && grep -q "SteamOS" /etc/os-release 2>/dev/null
}

steamos_rw() {
    if is_steamos; then
        # Try to disable read-only, but don't fail if we can't
        steamos-readonly disable 2>/dev/null || {
            print_warn "Could not disable SteamOS read-only mode"
            print_info "You may need to run: steamos-readonly disable"
            print_info "Then re-run this script"
            return 1
        }
    fi
}

steamos_ro() {
    if is_steamos; then
        steamos-readonly enable 2>/dev/null || true
    fi
}

# --- Check if we can write to system directories ------------------------------
can_write_system() {
    # Test if we can write to /etc and /usr/share
    if touch /etc/.steamos-test-write 2>/dev/null; then
        rm -f /etc/.steamos-test-write
        return 0
    else
        return 1
    fi
}

# --- Create profile sets for all formats --------------------------------------
create_all_profiles() {
    print_info "Checking/create surround profile sets for all formats..."

    # Try to enable write access on SteamOS
    if is_steamos; then
        steamos_rw || true  # Continue even if it fails
    fi

    mkdir -p "$ACP_PROFILE_DIR"

    # AC-3 profile
    if [[ ! -f "$ACP_PROFILE_DIR/hdmi-ac3.conf" ]]; then
        print_info "Creating hdmi-ac3.conf (AC-3)..."
        cat > "$ACP_PROFILE_DIR/hdmi-ac3.conf" << 'ACPEOF'
; Profile set with HDMI/AC3 profiles.
; Enables AC-3 (Dolby Digital) encoding via the ALSA a52 plugin.
; The a52 plugin encodes 6-channel PCM to AC-3 in real-time using libavcodec.

.include default.conf

[Mapping hdmi-ac3-surround]
description = Digital Surround 5.1 (HDMI/AC3)
device-strings = plug:{SLAVE="a52:%f,'hw:%f,3'"}
paths-output = hdmi-output-0
channel-map = front-left,front-right,rear-left,rear-right,front-center,lfe
priority = 1
direction = output

[Profile output:hdmi-ac3-surround]
description = Digital Surround 5.1 (HDMI/AC3) Output
output-mappings = hdmi-ac3-surround
priority = 100
skip-probe = no
ACPEOF
        print_ok "Created hdmi-ac3.conf"
    fi

    # DTS profile
    if [[ ! -f "$ACP_PROFILE_DIR/hdmi-dts.conf" ]]; then
        print_info "Creating hdmi-dts.conf (DTS)..."
        cat > "$ACP_PROFILE_DIR/hdmi-dts.conf" << 'DTSEOF'
; Profile set with HDMI/DTS profiles.
; Enables DTS encoding via the ALSA dts plugin.
; The dts plugin encodes 6-channel PCM to DTS in real-time using libavcodec.

.include default.conf

[Mapping hdmi-dts-surround]
description = Digital Surround 5.1 (HDMI/DTS)
device-strings = plug:{SLAVE="dts:%f,'hw:%f,3'"}
paths-output = hdmi-output-0
channel-map = front-left,front-right,rear-left,rear-right,front-center,lfe
priority = 1
direction = output

[Profile output:hdmi-dts-surround]
description = Digital Surround 5.1 (HDMI/DTS) Output
output-mappings = hdmi-dts-surround
priority = 100
skip-probe = no
DTSEOF
        print_ok "Created hdmi-dts.conf"
    fi

    # E-AC-3 profile
    if [[ ! -f "$ACP_PROFILE_DIR/hdmi-eac3.conf" ]]; then
        print_info "Creating hdmi-eac3.conf (E-AC-3)..."
        cat > "$ACP_PROFILE_DIR/hdmi-eac3.conf" << 'EAC3EOF'
; Profile set with HDMI/EAC3 profiles.
; Enables E-AC-3 (Dolby Digital Plus) encoding via the ALSA eac3 plugin.
; The eac3 plugin encodes 6-channel PCM to E-AC-3 in real-time using libavcodec.

.include default.conf

[Mapping hdmi-eac3-surround]
description = Digital Surround 5.1 (HDMI/EAC3)
device-strings = plug:{SLAVE="eac3:%f,'hw:%f,3'"}
paths-output = hdmi-output-0
channel-map = front-left,front-right,rear-left,rear-right,front-center,lfe
priority = 1
direction = output

[Profile output:hdmi-eac3-surround]
description = Digital Surround 5.1 (HDMI/EAC3) Output
output-mappings = hdmi-eac3-surround
priority = 100
skip-probe = no
EAC3EOF
        print_ok "Created hdmi-eac3.conf"
    fi

    # Restore read-only on SteamOS if we successfully disabled it
    if is_steamos && mount | grep -q " / .*ro,"; then
        # Only re-enable if we actually disabled it
        steamos_ro
    fi
}

# --- Install dependencies (SteamOS-specific handling) ------------------------
install_dependencies() {
    local format="$1"
    local missing=()

    # Check ALSA plugins (a52 covers both a52 and dts on most systems)
    [[ -f /usr/lib/alsa-lib/libasound_module_pcm_a52.so ]] || missing+=("alsa-plugins")
    [[ -f /usr/lib/alsa-lib/libasound_module_pcm_dts.so ]] || :  # dts plugin may be separate
    [[ -f /usr/lib/alsa-lib/libasound_module_pcm_eac3.so ]] || :  # eac3 plugin may not exist yet

    # Check FFmpeg
    ldconfig -p 2>/dev/null | grep -q libavcodec || missing+=("ffmpeg")

    if (( ${#missing[@]} == 0 )); then
        print_ok "All dependencies found"
        return 0
    fi

    print_warn "Missing dependencies: ${missing[*]}"

    if is_steamos; then
        print_info "On SteamOS, you may need to:"
        print_info "  1. Enable write mode: steamos-readonly disable"
        print_info "  2. Install packages: sudo pacman -S ${missing[*]}"
        print_info "  3. Re-run this script"
        print_info "Or test if audio works anyway - sometimes plugins are available under different names"
        return 1  # Warning but not failure
    else
        # On non-SteamOS systems, try to install
        print_info "Attempting to install missing dependencies: ${missing[*]}"
        if command -v pacman &>/dev/null; then
            # Try to enable write access if needed
            local write_enabled=0
            if ! can_write_system; then
                print_info "Attempting to enable write access for package installation..."
                if [[ "$(id -u)" -eq 0 ]]; then
                    # We're root, try to remount if needed
                    mount -o remount,rw / 2>/dev/null || true
                    write_enabled=1
                fi
            fi

            if pacman -S --needed --noconfirm "${missing[@]}" 2>&1 | tail -5; then
                print_ok "Dependencies installed successfully"
                return 0
            else
                print_error "Failed to install dependencies: ${missing[*]}"
                return 1
            fi
        elif command -v apt &>/dev/null; then
            local apt_pkgs=()
            [[ " ${missing[*]} " == *" alsa-plugins "* ]] && apt_pkgs+=("libasound2-plugins")
            [[ " ${missing[*]} " == *" ffmpeg "* ]] && apt_pkgs+=("ffmpeg")
            apt-get update -qq && apt-get install -y "${apt_pkgs[@]}" 2>&1 | tail -5 || {
                print_error "Failed to install dependencies: ${apt_pkgs[*]}"
                return 1
            }
        else
            print_error "Unknown package manager. Please install manually: ${missing[*]}"
            return 1
        fi
    fi
}

# --- Install ------------------------------------------------------------------
do_install() {
    local format="$1"
    local profile="${FORMAT_PROFILES[$format]}"
    local desc="${FORMAT_DESC[$format]}"
    local plugin="${FORMAT_PLUGIN[$format]}"

    if [[ -z "$format" || -z "$profile" ]]; then
        print_error "Invalid format. Use: ac3, dts, or eac3"
        return 1
    fi

    print_step "SURROUND" "Installing HDMI $desc Surround Encoding"

    echo -e "  ${DIM}Enables $desc encoding over HDMI/DP for 5.1 surround${RESET}"
    echo -e "  ${DIM}via eARC. Bypasses TV LPCM downmix — receiver gets true $desc.${RESET}"
    echo -e "  ${DIM}Zero added latency, minimal CPU overhead (native $plugin encoding).${RESET}"
    echo -e "  ${DIM}After installing, select the $desc sink in your desktop audio settings.${RESET}"
    echo ""

    # Check that an HDMI/DP audio card exists
    local hdmi_card_name
    hdmi_card_name=$(pactl list cards 2>/dev/null | grep -B1 "alsa.mixer_name = \"ATI R6xx HDMI\"" | grep "Name:" | awk '{print $2}' | head -1)
    if [[ -z "$hdmi_card_name" ]]; then
        # Broader fallback: any card with HDMI in the PCM device names
        hdmi_card_name=$(pactl list cards 2>/dev/null | grep -B5 "HDMI / DisplayPort" | grep "Name:" | awk '{print $2}' | head -1)
    fi
    if [[ -z "$hdmi_card_name" ]]; then
        print_error "No HDMI/DP audio card found."
        print_info "If your audio card has a different name, edit the WirePlumber"
        print_info "config device.nick match after installation."
        return 1
    fi

    if ! confirm "Continue with $desc Surround Encoding installation?"; then
        print_info "Cancelled."
        return 0
    fi

    # 0. Create all profile sets (needed for configuration)
    create_all_profiles

    # 1. Check dependencies (warn but continue - user can test if it works)
    print_info "Checking dependencies..."
    install_dependencies "$format" || true  # Continue even if deps missing

    # 2. Install udev rule to set ACP_PROFILE_SET for the HDMI audio card
    # Skip if we can't write to system directories
    if can_write_system || ! is_steamos; then
        print_info "Installing udev rule for ACP_PROFILE_SET=$profile..."
        steamos_rw
        echo "SUBSYSTEM==\"sound\", KERNEL==\"card0\", ENV{ACP_PROFILE_SET}=\"$profile\"" > "$UDEV_RULE"
        udevadm control --reload-rules 2>/dev/null || true
        udevadm trigger /sys/class/sound/card0 2>/dev/null || true
        steamos_ro
    else
        print_warn "Skipping udev rule (read-only filesystem)."
        print_info "To enable surround sound, manually create:"
        print_info "  echo 'SUBSYSTEM==\"sound\", KERNEL==\"card0\", ENV{ACP_PROFILE_SET}=\"$profile\"' > /etc/udev/rules.d/91-surround-audio.rules"
        print_info "Then run: udevadm control --reload-rules && udevadm trigger /sys/class/sound/card0"
    fi

    # 3. Install WirePlumber config (user directory - should always be writable)
    print_info "Installing WirePlumber config for $desc profiles..."
    mkdir -p "$WP_CONF_DIR"
    cat > "$WP_CONF" << 'WPEOF'
# Enable surround encoding profiles for HDMI/DP audio.
# This config activates the selected profile set, which uses the ALSA
# plugin to encode multichannel PCM to the target format in real-time.
#
# On SteamOS (BC-250), the DMI identifies as "AMD BC-250" instead of "OEM F7F",
# so the valve-fremont hardware profile that normally loads this is skipped.
# On other distros, this config is what makes the profiles available.
monitor.alsa.rules = [
  {
    matches = [
      {
        device.name = "~alsa_card.pci-.*"
        device.nick = "~HD-Audio Generic"
      }
    ]
    actions = {
      update-props = {
        device.description = "HDMI / DisplayPort"
        api.acp.disable-pro-audio = true
        device.profile-set = __PROFILE__
        device.routes.default-sink-volume = 1.0
      }
    }
  }
  {
    matches = [
      {
        node.name = "~alsa_output.pci-.*hdmi.*"
      }
    ]
    actions = {
      update-props = {
        # Keep sink alive for 1 hour after last sound to prevent receiver
        # from falling back to PCM between tracks/dialogue pauses.
        session.suspend-timeout-seconds = 3600
      }
    }
  }
  {
    matches = [
      {
        node.name = "~alsa_output.pci-.*hdmi.*"
        alsa.name = "~__PLUGIN__.*"
      }
    ]
    actions = {
      update-props = {
        # Collect one frame (1536 samples) before starting playback,
        # else the plugin EPIPEs on startup.
        api.alsa.start-delay = 1536
      }
    }
  }
]
WPEOF
    # Replace placeholders
    sed -i "s|__PROFILE__|$profile|g" "$WP_CONF"
    sed -i "s|__PLUGIN__|$plugin|g" "$WP_CONF"

    if [[ -n "${SUDO_USER:-}" ]] && [[ "${SUDO_USER}" != "root" ]]; then
        chown -R "$SUDO_USER":"$SUDO_USER" "$WP_CONF_DIR" 2>/dev/null || true
    fi

    # 4. Restart WirePlumber and select the profile
    print_info "Restarting WirePlumber and selecting $desc profile..."

    # WirePlumber runs as a user service — restart it as the real user
    local restart_cmd="systemctl --user restart wireplumber"
    if [[ -n "${SUDO_USER:-}" ]] && [[ "${SUDO_USER}" != "root" ]]; then
        su - "$SUDO_USER" -c "$restart_cmd" 2>/dev/null || true
    else
        $restart_cmd 2>/dev/null || true
    fi
    sleep 3

    # Find and select the surround profile
    local card_name
    card_name=$(pactl list cards 2>/dev/null | grep -B5 "hdmi-${format}-surround" | grep "Name:" | awk '{print $2}' | head -1)
    if [[ -z "$card_name" ]]; then
        card_name="$hdmi_card_name"
    fi

    pactl set-card-profile "$card_name" "output:hdmi-${format}-surround" 2>/dev/null || true
    sleep 1

    # Set the surround sink as default
    local surround_sink
    surround_sink=$(pactl list sinks short 2>/dev/null | grep "hdmi-${format}-surround" | awk '{print $2}' | head -1)
    if [[ -n "$surround_sink" ]]; then
        pactl set-default-sink "$surround_sink" 2>/dev/null
        print_ok "$desc Surround Encoding installed!"
        print_ok "Profile: output:hdmi-${format}-surround"
        print_ok "Default sink: $surround_sink"
        echo ""
        print_info "Now go to Desktop Mode and select this device in your audio settings:"
        print_info "  \"HD-Audio Generic Digital Surround 5.1 (HDMI/$desc)\""
        echo ""
        if [[ -n "$(pactl list sinks short 2>/dev/null | grep "hdmi-${format}-surround")" ]]; then
            print_info "Your receiver should show $desc when audio plays."
            print_info "The sink stays active for 1 hour after last sound to prevent PCM fallback."
        else
            print_warn "No surround sink was created - check if dependencies are installed correctly"
            print_info "Troubleshooting steps:"
            print_info "  1. Verify ALSA plugin exists: ls /usr/lib/alsa-lib/libasound_module_pcm_${plugin}.so"
            print_info "  2. Check WirePlumber logs: journalctl --user -u wireplumber -b"
            print_info "  3. Test with: pactl set-card-profile $card_name output:hdmi-${format}-surround"
        fi
    else
        print_error "$desc profile was selected but no sink was created."
        print_info "Check: pactl list cards | grep $format"
        print_info "Try manually: pactl set-card-profile $card_name output:hdmi-${format}-surround"
        return 1
    fi
}

# --- Revert -------------------------------------------------------------------
do_revert() {
    print_step "SURROUND" "Reverting HDMI Surround Encoding"

    if [[ ! -f "$UDEV_RULE" && ! -f "$WP_CONF" ]]; then
        print_info "Surround Encoding is not installed — nothing to revert."
        return 0
    fi

    if ! confirm "This will restore the default HDMI stereo profile. Proceed?"; then
        print_info "Cancelled."
        return 0
    fi

    # Remove udev rule (if we can write)
    if can_write_system || ! is_steamos; then
        steamos_rw
        rm -f "$UDEV_RULE"
        udevadm control --reload-rules 2>/dev/null || true
        udevadm trigger /sys/class/sound/card0 2>/dev/null || true
        steamos_ro
    else
        print_warn "Skipping udev rule removal (read-only filesystem)."
        print_info "To manually remove: sudo rm /etc/udev/rules.d/91-surround-audio.rules"
    fi

    # Remove WirePlumber config
    rm -f "$WP_CONF"

    # Restart WirePlumber
    local restart_cmd="systemctl --user restart wireplumber"
    if [[ -n "${SUDO_USER:-}" ]] && [[ "${SUDO_USER}" != "root" ]]; then
        su - "$SUDO_USER" -c "$restart_cmd" 2>/dev/null || true
    else
        $restart_cmd 2>/dev/null || true
    fi
    sleep 3

    # Restore default HDMI stereo profile
    local card_name
    card_name=$(pactl list cards 2>/dev/null | grep -B5 "hdmi-stereo" | grep "Name:" | awk '{print $2}' | head -1)
    if [[ -z "$card_name" ]]; then
        # fallback to first card
        card_name=$(pactl list cards 2>/dev/null | grep "Name:" | awk '{print $2}' | head -1)
    fi

    pactl set-card-profile "$card_name" output:hdmi-stereo 2>/dev/null || true
    sleep 1

    local stereo_sink
    stereo_sink=$(pactl list sinks short 2>/dev/null | grep "hdmi-stereo" | awk '{print $2}' | head -1)
    if [[ -n "$stereo_sink" ]]; then
        pactl set-default-sink "$stereo_sink" 2>/dev/null
    fi

    print_ok "Surround Encoding reverted. HDMI stereo profile restored."
}

# --- Status -------------------------------------------------------------------
do_status() {
    print_step "SURROUND" "HDMI Surround Encoding Status"
    echo ""

    if [[ -f "$UDEV_RULE" ]]; then
        print_ok "Udev rule: $UDEV_RULE"
        cat "$UDEV_RULE" | sed 's/^/    /'
    else
        print_error "Udev rule: not installed"
    fi

    if [[ -f "$WP_CONF" ]]; then
        print_ok "WirePlumber config: $WP_CONF"
    else
        print_error "WirePlumber config: not installed"
    fi

    echo ""
    print_info "Available profile sets:"
    for fmt in ac3 dts eac3; do
        if [[ -f "$ACP_PROFILE_DIR/hdmi-${fmt}.conf" ]]; then
            print_ok "  hdmi-${fmt}.conf: found"
        else
            print_error "  hdmi-${fmt}.conf: missing"
        fi
    done
    echo ""

    # Check dependencies
    print_info "Dependency check:"
    [[ -f /usr/lib/alsa-lib/libasound_module_pcm_a52.so ]] && print_ok "  alsa-plugins (a52): found" || print_error "  alsa-plugins (a52): missing"
    [[ -f /usr/lib/alsa-lib/libasound_module_pcm_dts.so ]] && print_ok "  alsa-plugins (dts): found" || print_error "  alsa-plugins (dts): missing"
    [[ -f /usr/lib/alsa-lib/libasound_module_pcm_eac3.so ]] && print_ok "  alsa-plugins (eac3): found" || print_error "  alsa-plugins (eac3): missing (may not be available yet)"
    ldconfig -p 2>/dev/null | grep -q libavcodec && print_ok "  ffmpeg: found" || print_error "  ffmpeg: missing"

    echo ""

    # Check current card profile
    local card_name active_profile
    card_name=$(pactl list cards 2>/dev/null | grep -B1 "HDA ATI HDMI" | grep "Name:" | awk '{print $2}' | head -1)
    if [[ -n "$card_name" ]]; then
        active_profile=$(pactl list cards 2>/dev/null | grep -A20 "Name: $card_name" | grep "Active Profile" | awk -F': ' '{print $2}')
        print_info "Card: $card_name"
        print_info "Active profile: ${active_profile:-unknown}"
    else
        print_error "No HDA ATI HDMI card found."
    fi

    # Check current default sink
    local default_sink
    default_sink=$(pactl get-default-sink 2>/dev/null)
    if [[ -n "$default_sink" ]]; then
        print_info "Default sink: $default_sink"
    fi

    # Check available surround profiles
    echo ""
    print_info "Available surround profiles:"
    for fmt in ac3 dts eac3; do
        local profiles
        profiles=$(pactl list cards 2>/dev/null | grep "hdmi-${fmt}" | head -2)
        if [[ -n "$profiles" ]]; then
            print_ok "  $fmt:"
            echo "$profiles" | sed 's/^/    /'
        else
            print_error "  $fmt: none"
        fi
    done
}

# --- Main ---------------------------------------------------------------------
case "${1:-}" in
    install)
        if [[ -z "${2:-}" ]]; then
            echo "Error: missing format argument"
            echo "Usage: sudo $0 install <format>  (format: ac3, dts, eac3)"
            exit 1
        fi
        do_install "$2"
        ;;
    revert)
        do_revert
        ;;
    status)
        do_status
        ;;
    *)
        echo "Usage: sudo $0 {install <format>|revert|status}"
        echo ""
        echo "  install <format>  — Enable surround encoding (format: ac3, dts, eac3)"
        echo "  revert            — Restore default HDMI stereo profile"
        echo "  status            — Show current surround encoding state"
        echo ""
        echo "After install, select the appropriate sink in your desktop audio settings."
        exit 1
        ;;
esac