@@ -66,6 +66,24 @@ static uint16_t cyan_skillfish_get_gpu_activity(struct smu_context *smu)
 	return DIV_ROUND_CLOSEST(busy * 10000, 32);
 }
 
+static int cyan_skillfish_get_gfxclk_frequency(struct smu_context *smu,
+					       uint32_t *value)
+{
+	int ret;
+
+	ret = smu_cmn_send_smc_msg(smu, SMU_MSG_GetGfxclkFrequency, value);
+	if (ret)
+		return ret;
+	if (*value < CYAN_SKILLFISH_SCLK_MIN ||
+	    *value > CYAN_SKILLFISH_SCLK_MAX) {
+		dev_dbg(smu->adev->dev, "discarding invalid GFX clock %u MHz\n",
+			*value);
+		return -ERANGE;
+	}
+
+	return 0;
+}
+
 #define FEATURE_MASK(feature) (1ULL << feature)
 #define SMC_DPM_FEATURE ( \
 	FEATURE_MASK(FEATURE_FCLK_DPM_BIT)	|	\
@@ -96,6 +114,7 @@ static struct cmn2asic_msg_mapping cyan_skillfish_message_map[SMU_MSG_MAX_COUNT]
 	MSG_MAP(TransferTableSmu2Dram,          PPSMC_MSG_TransferTableSmu2Dram,	0),
 	MSG_MAP(TransferTableDram2Smu,          PPSMC_MSG_TransferTableDram2Smu,	0),
 	MSG_MAP(GetEnabledSmuFeatures,          PPSMC_MSG_GetEnabledSmuFeatures,	0),
+	MSG_MAP(GetGfxclkFrequency,             PPSMC_MSG_GetGfxFrequency,		0),
 	MSG_MAP(RequestGfxclk,                  PPSMC_MSG_RequestGfxclk,		0),
 	MSG_MAP(ForceGfxVid,                    PPSMC_MSG_ForceGfxVid,			0),
 	MSG_MAP(UnforceGfxVid,                  PPSMC_MSG_UnforceGfxVid,		0),
@@ -161,7 +180,7 @@ cyan_skillfish_get_smu_metrics_data(struct smu_context *smu,
 
 	switch (member) {
 	case METRICS_CURR_GFXCLK:
-		*value = metrics->Current.GfxclkFrequency;
+		ret = cyan_skillfish_get_gfxclk_frequency(smu, value);
 		break;
 	case METRICS_CURR_SOCCLK:
 		*value = metrics->Current.SocclkFrequency;
@@ -414,11 +433,23 @@ static ssize_t cyan_skillfish_get_gpu_metrics(struct smu_context *smu,
 	struct gpu_metrics_v2_2 *gpu_metrics =
 		(struct gpu_metrics_v2_2 *)smu_table->gpu_metrics_table;
 	SmuMetrics_t metrics;
+	uint32_t gfxclk;
 	int i, ret = 0;
 
 	ret = smu_cmn_get_metrics_table(smu, &metrics, true);
 	if (ret)
 		return ret;
+	/*
+	 * A range-invalid (or transient) GFX clock reading must not abort
+	 * the whole metrics readout below -- temperature, GPU activity%,
+	 * and per-core CPU metrics all live in this same gpu_metrics struct
+	 * and are populated by this same function call. Discarding just the
+	 * gfxclk field and falling back to the raw metrics-table value keeps
+	 * every other sensor updating (fan control depends on it) even when
+	 * the direct SMU clock query is momentarily unreliable.
+	 */
+	if (cyan_skillfish_get_gfxclk_frequency(smu, &gfxclk))
+		gfxclk = metrics.Current.GfxclkFrequency;
 
 	smu_cmn_init_soft_gpu_metrics(gpu_metrics, 2, 2);
 
