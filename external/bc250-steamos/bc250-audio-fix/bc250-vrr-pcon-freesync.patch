+static bool parse_amd_vsdb_cea_direct(u8 *edid_ext, int len,
+		struct amdgpu_hdmi_vsdb_info *vsdb_info)
+{
+	int i = 4;
+	int dtd_start = edid_ext[2];
+
+	if (dtd_start == 0 || dtd_start >= len)
+		dtd_start = len;
+
+	while (i < dtd_start) {
+		u8 tag = (edid_ext[i] >> 5) & 0x07;
+		u8 db_len = edid_ext[i] & 0x1F;
+
+		if (db_len == 0 && tag == 0)
+			break;
+
+		if (tag == 3 && db_len >= 7) {
+			u8 *db = &edid_ext[i + 1];
+			unsigned int oui = (db[2] << 16) | (db[1] << 8) | db[0];
+
+			if (oui == HDMI_AMD_VENDOR_SPECIFIC_DATA_BLOCK_IEEE_REGISTRATION_ID) {
+				u8 version = db[3];
+
+				if (version == 1 && db_len >= 7) {
+					vsdb_info->freesync_supported = 1;
+					vsdb_info->amd_vsdb_version = 1;
+					vsdb_info->min_refresh_rate_hz = db[4] | (db[5] << 8);
+					vsdb_info->max_refresh_rate_hz = db[6] | (db[7] << 8);
+					return true;
+				}
+			}
+		}
+
+		i += 1 + db_len;
+	}
+
+	return false;
+}
