 static uint32_t cyan_skillfish_sclk_default;
 
+static uint16_t cyan_skillfish_get_gpu_activity(struct smu_context *smu)
+{
+	struct amdgpu_device *adev = smu->adev;
+	unsigned int busy = 0;
+	int i;
+
+	/* The firmware table has no GFX activity field. Sample GUI_ACTIVE over
+	 * a short window so gpu_metrics does not expose the 0xffff sentinel.
+	 */
+	for (i = 0; i < 32; i++) {
+		busy += !!(RREG32_SOC15(GC, 0, mmGRBM_STATUS) &
+			  GRBM_STATUS__GUI_ACTIVE_MASK);
+		if (i != 31)
+			udelay(50);
+	}
+
+	return DIV_ROUND_CLOSEST(busy * 10000, 32);
+}
