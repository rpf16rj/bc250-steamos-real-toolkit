 #define SWSMU_CODE_LAYER_L2
+#include <linux/delay.h>
 
 #include "amdgpu.h"
 #include "amdgpu_smu.h"
@@ -44,6 +45,32 @@ static struct gfx_user_settings {
 
 static uint32_t cyan_skillfish_sclk_default;
 
+static uint16_t cyan_skillfish_get_gpu_activity(struct smu_context *smu)
+{
+	struct amdgpu_device *adev = smu->adev;
+	unsigned int busy = 0;
+	int i;
+
+	/*
+	 * Cyan Skillfish does not publish GFX activity in SmuMetrics_t, and
+	 * GRBM_STATUS reads back all-ones on this ASIC regardless of GPU
+	 * state (bus-fault sentinel, not a valid GUI_ACTIVE bit), which
+	 * previously pegged this at 100% even when the GPU was verifiably
+	 * idle. Approximate busy state from the GFX ring's emitted-fence
+	 * count instead: it is the same software-tracked activity signal
+	 * that already backs the reliable fdinfo drm-engine-gfx accounting,
+	 * and amdgpu_fence_count_emitted() is an existing core helper used
+	 * historically for exactly this kind of ring activity tracking.
+	 */
+	for (i = 0; i < 32; i++) {
+		busy += !!amdgpu_fence_count_emitted(&adev->gfx.gfx_ring[0]);
+		if (i != 31)
+			udelay(50);
+	}
+
+	return DIV_ROUND_CLOSEST(busy * 10000, 32);
+}
+
 #define FEATURE_MASK(feature) (1ULL << feature)
 #define SMC_DPM_FEATURE ( \
 	FEATURE_MASK(FEATURE_FCLK_DPM_BIT)	|	\
@@ -245,6 +271,11 @@ static int cyan_skillfish_read_sensor(struct smu_context *smu,
 						   (uint32_t *)data);
 		*size = 4;
 		break;
+	case AMDGPU_PP_SENSOR_GPU_LOAD:
+		*(uint32_t *)data =
+			cyan_skillfish_get_gpu_activity(smu) / 100;
+		*size = 4;
+		break;
 	default:
 		ret = -EOPNOTSUPP;
 		break;
@@ -391,6 +422,7 @@ static ssize_t cyan_skillfish_get_gpu_metrics(struct smu_context *smu,
 
