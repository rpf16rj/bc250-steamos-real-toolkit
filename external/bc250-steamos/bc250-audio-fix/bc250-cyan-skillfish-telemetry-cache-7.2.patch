+static uint16_t cyan_skillfish_get_gpu_activity(struct smu_context *smu)
+{
+	struct cyan_skillfish_metrics_cache *cache = smu->smu_table.metrics_table;
+	struct amdgpu_device *adev = smu->adev;
+	unsigned long flags, now = jiffies;
+	uint16_t activity;
+	unsigned int busy = 0;
+	unsigned int cache_ms = cs_activity_cache_ms;
+	int i;
+
+	/*
+	 * Sensor and GPU Metrics consumers can request activity back-to-back.
+	 * Reuse a very recent sample so those reads do not each spend ~1.55 ms
+	 * busy-waiting on the same ring sampling window. Keep the lock
+	 * outside that sampling window; concurrent misses may sample twice but
+	 * cannot corrupt the cached value.
+	 */
+	spin_lock_irqsave(&cache->gpu_activity_lock, flags);
+	if (cache_ms && cache->gpu_activity_time &&
+	    time_before(now, cache->gpu_activity_time +
+			msecs_to_jiffies(cache_ms))) {
+		activity = cache->gpu_activity;
+		spin_unlock_irqrestore(&cache->gpu_activity_lock, flags);
+		return activity;
+	}
+	spin_unlock_irqrestore(&cache->gpu_activity_lock, flags);
+
+	/*
+	 * Cyan Skillfish does not publish GFX activity in SmuMetrics_t, and
+	 * GRBM_STATUS reads back all-ones on this ASIC regardless of GPU
+	 * state (bus-fault sentinel, not a valid GUI_ACTIVE bit), which
+	 * previously pegged this at 100% even when the GPU was verifiably
+	 * idle. Approximate busy state from the GFX ring's emitted-fence
+	 * count instead: it is the same software-tracked activity signal
+	 * that already backs the reliable fdinfo drm-engine-gfx accounting,
+	 * and amdgpu_fence_count_emitted() is an existing core helper used
+	 * historically for exactly this kind of ring activity tracking.
+	 */
+	for (i = 0; i < 32; i++) {
+		busy += !!amdgpu_fence_count_emitted(&adev->gfx.gfx_ring[0]);
+		if (i != 31)
+			udelay(50);
+	}
+
+	activity = DIV_ROUND_CLOSEST(busy * 10000, 32);
+
+	spin_lock_irqsave(&cache->gpu_activity_lock, flags);
+	cache->gpu_activity = activity;
+	cache->gpu_activity_time = jiffies;
+	spin_unlock_irqrestore(&cache->gpu_activity_lock, flags);
+
+	return activity;
+}
+
+/*
+ * GFXCLK is read through the SMU mailbox. @fallback is the table's own
+ * GfxclkFrequency, used only if the mailbox call fails; @fallback_valid says
+ * whether the active layout actually has that field (the pre-patch 8-core
+ * layout does not).
+ */
+static int cyan_skillfish_get_current_gfxclk(struct smu_context *smu,
+					     uint32_t *value, uint32_t fallback,
+					     bool fallback_valid)
+{
+	struct cyan_skillfish_metrics_cache *cache = smu->smu_table.metrics_table;
+	unsigned long flags, now = jiffies;
+	unsigned int cache_ms = cs_gfxclk_cache_ms;
+	int ret;
+
+	if (cache_ms) {
+		spin_lock_irqsave(&cache->gfxclk_lock, flags);
+		if (cache->gfxclk_valid &&
+		    time_before(now, cache->gfxclk_time +
+				msecs_to_jiffies(cache_ms))) {
+			*value = cache->gfxclk;
+			spin_unlock_irqrestore(&cache->gfxclk_lock, flags);
+			return 0;
+		}
+		spin_unlock_irqrestore(&cache->gfxclk_lock, flags);
+	}
+
+	ret = smu_cmn_send_smc_msg(smu, SMU_MSG_GetGfxclkFrequency, value);
+	if (ret && fallback_valid) {
+		*value = fallback;
+		ret = 0;
+	}
+
+	if (!ret && cache_ms) {
+		spin_lock_irqsave(&cache->gfxclk_lock, flags);
+		cache->gfxclk = *value;
+		cache->gfxclk_time = jiffies;
+		cache->gfxclk_valid = true;
+		spin_unlock_irqrestore(&cache->gfxclk_lock, flags);
+	}
+
+	return ret;
+}
