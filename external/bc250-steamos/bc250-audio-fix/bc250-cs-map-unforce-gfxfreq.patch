From: MastaG <mastag@gmail.com>
Subject: [PATCH] drm/amd/pm: map UnForceGfxFreq so a Cyan Skillfish clock override can actually be released

The driver could force the GFX clock but never un-force it.
PP_OD_COMMIT_DPM_TABLE sends RequestGfxclk, which is a manual request
whatever value it carries, and PMFW keeps honouring it until told otherwise.
PP_OD_RESTORE_DEFAULT_TABLE did not tell it otherwise -- it just requested
the *default* clock, still a manual request. Only the voltage was ever
released, via UnforceGfxVid.

The firmware has had the missing message all along: smu_v11_8_ppsmc.h
declares PPSMC_MSG_UnForceGfxFreq (0x3A) right beside the ForceGfxVid /
UnforceGfxVid pair the driver does map. It was simply never added to
cyan_skillfish_message_map, so there was no way back to firmware DPM control
short of a reboot. cyan-skillfish-governor's own SMU backend sends 0x3A on
both startup and shutdown, which is where this came to light.

This matters beyond tidiness. On a board driving a DP->HDMI 2.1 PCON, a
mode change fails once the GFX clock has been put under manual control, and
stays failing: releasing the voltage alone does not help, because the clock
is still latched. The one condition that reliably switched modes all night
was a boot where the governor had never run and RequestGfxclk had therefore
never been sent.

So make a release an actual release: when PP_OD_RESTORE_DEFAULT_TABLE has
selected CYAN_SKILLFISH_VDDC_MAGIC, send UnForceGfxFreq + UnforceGfxVid and
skip RequestGfxclk entirely. The forcing path is unchanged.

This also gives cs_od_force_suspend() -- which releases the override across a
link bring-up -- something that actually releases, rather than swapping one
manual clock request for another.

NOT yet hardware-tested. The missing message is established from the firmware
header and the governor's own use of it; that releasing the clock fixes the
mode switch is the hypothesis this is meant to test.

--- a/drivers/gpu/drm/amd/pm/swsmu/inc/smu_types.h
+++ b/drivers/gpu/drm/amd/pm/swsmu/inc/smu_types.h
@@ -246,6 +246,7 @@
 	__SMU_DUMMY_MAP(ForceGfxVid),             \
 	__SMU_DUMMY_MAP(Spare0),                  \
 	__SMU_DUMMY_MAP(UnforceGfxVid),           \
+	__SMU_DUMMY_MAP(UnForceGfxFreq),          \
 	__SMU_DUMMY_MAP(HeavySBR),			\
 	__SMU_DUMMY_MAP(SetBadHBMPagesRetiredFlagsPerChannel), \
 	__SMU_DUMMY_MAP(EnableGfxImu), \
--- a/drivers/gpu/drm/amd/pm/swsmu/smu11/cyan_skillfish_ppt.c
+++ b/drivers/gpu/drm/amd/pm/swsmu/smu11/cyan_skillfish_ppt.c
@@ -394,6 +394,7 @@
 	MSG_MAP(RequestGfxclk,                  PPSMC_MSG_RequestGfxclk,		0),
 	MSG_MAP(ForceGfxVid,                    PPSMC_MSG_ForceGfxVid,			0),
 	MSG_MAP(UnforceGfxVid,                  PPSMC_MSG_UnforceGfxVid,		0),
+	MSG_MAP(UnForceGfxFreq,                 PPSMC_MSG_UnForceGfxFreq,		0),
 };
 
 static struct cmn2asic_mapping cyan_skillfish_table_map[SMU_TABLE_COUNT] = {
@@ -999,31 +1000,47 @@
 	uint32_t vid;
 	int ret;
 
-	ret = smu_cmn_send_smc_msg_with_param(smu, SMU_MSG_RequestGfxclk,
-					      sclk, NULL);
-	if (ret) {
-		dev_err(smu->adev->dev, "Set sclk failed!\n");
-		return ret;
-	}
-
+	/*
+	 * A release has to hand the clock back to the firmware's own DPM, not
+	 * merely request the default one. RequestGfxclk is a manual request
+	 * whatever value it carries, and PMFW keeps honouring it until told
+	 * otherwise -- there is no "request nothing". UnForceGfxFreq is that
+	 * "otherwise", and the driver never used to map it, so before this
+	 * there was no way back to automatic control short of a reboot.
+	 */
 	if (vddc == CYAN_SKILLFISH_VDDC_MAGIC) {
-		ret = smu_cmn_send_smc_msg(smu, SMU_MSG_UnforceGfxVid, NULL);
+		ret = smu_cmn_send_smc_msg(smu, SMU_MSG_UnForceGfxFreq, NULL);
 		if (ret) {
-			dev_err(smu->adev->dev, "Unforce vddc failed!\n");
+			dev_err(smu->adev->dev, "Unforce sclk failed!\n");
 			return ret;
 		}
-	} else {
-		/*
-		 * PMFW accepts SVI2 VID code, convert voltage to VID:
-		 * vid = (uint32_t)((1.55 - voltage) * 160.0 + 0.00001)
-		 */
-		vid = (1550 - vddc) * 160 / 1000;
-		ret = smu_cmn_send_smc_msg_with_param(smu, SMU_MSG_ForceGfxVid,
-						      vid, NULL);
+
+		ret = smu_cmn_send_smc_msg(smu, SMU_MSG_UnforceGfxVid, NULL);
 		if (ret) {
-			dev_err(smu->adev->dev, "Force vddc failed!\n");
+			dev_err(smu->adev->dev, "Unforce vddc failed!\n");
 			return ret;
 		}
+
+		return 0;
+	}
+
+	ret = smu_cmn_send_smc_msg_with_param(smu, SMU_MSG_RequestGfxclk,
+					      sclk, NULL);
+	if (ret) {
+		dev_err(smu->adev->dev, "Set sclk failed!\n");
+		return ret;
+	}
+
+	/*
+	 * PMFW accepts SVI2 VID code, convert voltage to VID:
+	 * vid = (uint32_t)((1.55 - voltage) * 160.0 + 0.00001)
+	 */
+	vid = (1550 - vddc) * 160 / 1000;
+	ret = smu_cmn_send_smc_msg_with_param(smu, SMU_MSG_ForceGfxVid,
+					      vid, NULL);
+	if (ret) {
+		dev_err(smu->adev->dev, "Force vddc failed!\n");
+		return ret;
 	}
 
 	return 0;
