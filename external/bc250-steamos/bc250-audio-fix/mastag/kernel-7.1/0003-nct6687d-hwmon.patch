diff --git a/drivers/hwmon/Kconfig b/drivers/hwmon/Kconfig
index f42a40b..a0487ea 100644
--- a/drivers/hwmon/Kconfig
+++ b/drivers/hwmon/Kconfig
@@ -1733,6 +1733,21 @@ config SENSORS_NCT6683
 	  This driver can also be built as a module. If so, the module
 	  will be called nct6683.
 
+config SENSORS_NCT6687
+	tristate "Nuvoton NCT6683D/NCT6686D/NCT6687D extended driver"
+	depends on HAS_IOPORT
+	depends on !PPC
+	depends on !SENSORS_NCT6683
+	help
+	  Say yes here for the extended hardware-monitoring and PWM fan-control
+	  driver for Nuvoton NCT6683D, NCT6686D and NCT6687D Super-I/O chips.
+
+	  This driver is maintained outside the upstream kernel and is integrated
+	  into this kernel package from https://github.com/Fred78290/nct6687d.
+
+	  This driver can also be built as a module. If so, the module
+	  will be called nct6687.
+
 config SENSORS_NCT6694
 	tristate "Nuvoton NCT6694 Hardware Monitor support"
 	depends on MFD_NCT6694
diff --git a/drivers/hwmon/Makefile b/drivers/hwmon/Makefile
index bb8d481..73b0b2a 100644
--- a/drivers/hwmon/Makefile
+++ b/drivers/hwmon/Makefile
@@ -178,6 +178,7 @@ obj-$(CONFIG_SENSORS_MLXREG_FAN) += mlxreg-fan.o
 obj-$(CONFIG_SENSORS_MENF21BMC_HWMON) += menf21bmc_hwmon.o
 obj-$(CONFIG_SENSORS_MR75203)	+= mr75203.o
 obj-$(CONFIG_SENSORS_NCT6683)	+= nct6683.o
+obj-$(CONFIG_SENSORS_NCT6687)	+= nct6687.o
 obj-$(CONFIG_SENSORS_NCT6694)	+= nct6694-hwmon.o
 obj-$(CONFIG_SENSORS_NCT6775_CORE) += nct6775-core.o
 nct6775-objs			:= nct6775-platform.o
