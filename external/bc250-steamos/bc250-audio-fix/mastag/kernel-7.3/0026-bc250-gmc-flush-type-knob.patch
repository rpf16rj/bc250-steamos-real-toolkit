From 01f9730bf78ede25bd61b5191c75d33abc7439f6 Mon Sep 17 00:00:00 2001
From: MastaG <mastag@gmail.com>
Date: Mon, 2 Nov 2026 18:33:37 +0100
Subject: [PATCH] drm/amdgpu/gmc10: BC-250 knob to force the TLB flush type

A heavyweight invalidation (flush type 2) waits for the VMID's
outstanding requests. On this board it did not complete while a KFD
queue's GL2 flush was in flight: no ACK, the KIQ waiting for it stopped,
and with it the GPU.

The GFX1013 PASID path already downgrades its flushes to type 0, so the
default of -1 (keep the caller's type) changes nothing for it; the knob
is here to validate the flushes that stay heavyweight without a rebuild,
which is how Kyty's bring-up runs (bc250_tlb_flush_type=0).

Based on KytyPS5-Native's bc250-amdgpu patch (faf53a5).
---
 drivers/gpu/drm/amd/amdgpu/gmc_v10_0.c | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/drivers/gpu/drm/amd/amdgpu/gmc_v10_0.c b/drivers/gpu/drm/amd/amdgpu/gmc_v10_0.c
index adb90b07aff6..5ae0e326115f 100644
--- a/drivers/gpu/drm/amd/amdgpu/gmc_v10_0.c
+++ b/drivers/gpu/drm/amd/amdgpu/gmc_v10_0.c
@@ -51,6 +51,18 @@
 #include "athub_v2_0.h"
 #include "athub_v2_1.h"
 
+/* BC-250: a heavyweight invalidation (flush type 2) of a KFD VMID waits for that
+ * VMID's outstanding requests and did not complete while a KFD queue's GL2 flush
+ * was in flight: no ACK, the KIQ waiting for it stopped, and with it the GPU. The
+ * PASID path of this board is already forced to type 0 (see
+ * gmc_v10_0_flush_gpu_tlb_internal); this knob covers every flush so the paths
+ * that stay heavyweight can be validated without a rebuild. -1 keeps the type the
+ * caller asked for.
+ */
+static int bc250_tlb_flush_type = -1;
+module_param(bc250_tlb_flush_type, int, 0644);
+MODULE_PARM_DESC(bc250_tlb_flush_type, "BC-250: TLB flush type for every GPU TLB flush (-1 = as requested, 0 = legacy)");
+
 static int gmc_v10_0_ecc_interrupt_state(struct amdgpu_device *adev,
 					 struct amdgpu_irq_src *src,
 					 unsigned int type,
@@ -251,6 +263,9 @@ static void gmc_v10_0_flush_gpu_tlb_internal(struct amdgpu_device *adev,
 	    flush_type == 2)
 		flush_type = 0;
 
+	if (bc250_tlb_flush_type >= 0)
+		flush_type = bc250_tlb_flush_type;
+
 	use_semaphore = gmc_v10_0_use_invalidate_semaphore(adev, vmhub) ||
 		(gfx1013_pasid_path && vmhub == AMDGPU_GFXHUB(0));
 	inv_req = hub->vmhub_funcs->get_invalidate_req(vmid, flush_type);
