 extern bool cs_od_defer_debug;
 
+/*
+ * Releases a held GFX clock/voltage override for the duration of the link
+ * bring-up. Defined in drivers/gpu/drm/amd/pm/swsmu/smu11/cyan_skillfish_ppt.c
+ * -- see the comment there for why the override has to come off rather than
+ * merely have commits deferred around it.
+ */
+extern void cs_od_force_suspend(void);
+
 #define DC_LOGGER \
 	link->ctx->logger
 
@@ -1862,6 +1870,13 @@
