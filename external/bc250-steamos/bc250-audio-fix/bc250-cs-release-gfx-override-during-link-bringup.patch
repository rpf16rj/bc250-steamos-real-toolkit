 		pr_info("amdgpu: cs_od_defer: DP link training started, deferring OD clock/voltage commits\n");
 
+	/*
+	 * Deferring commits is not enough on its own -- a *held* override
+	 * breaks the bring-up even with no commit anywhere near it -- so take
+	 * the override off for the duration.
+	 */
