-			ret = smu_cmn_send_smc_msg_with_param(smu, SMU_MSG_ForceGfxVid, vid, NULL);
-			if (ret) {
-				dev_err(smu->adev->dev, "Force vddc failed!\n");
-				return ret;
-			}
-		}
 
 		if (cyan_skillfish_user_settings.sclk != cyan_skillfish_sclk_default ||
 		    cyan_skillfish_user_settings.vddc != CYAN_SKILLFISH_VDDC_MAGIC)
@@ -1069,7 +1272,7 @@
 	.init_power = smu_v11_0_init_power,
 	.fini_power = smu_v11_0_fini_power,
 	.init_smc_tables = cyan_skillfish_init_smc_tables,
-	.fini_smc_tables = smu_v11_0_fini_smc_tables,
+	.fini_smc_tables = cyan_skillfish_fini_smc_tables,
 	.read_sensor = cyan_skillfish_read_sensor,
 	.emit_clk_levels = cyan_skillfish_emit_clk_levels,
 	.get_enabled_mask = cyan_skillfish_get_enabled_mask,
--- a/drivers/gpu/drm/amd/display/dc/link/link_dpms.c
+++ b/drivers/gpu/drm/amd/display/dc/link/link_dpms.c
@@ -80,6 +80,12 @@
 extern bool cs_od_defer_debug;
 
 /*
+ * Releases a held GFX clock/voltage override across a link bring-up. Defined
+ * in drivers/gpu/drm/amd/pm/swsmu/smu11/cyan_skillfish_ppt.c.
+ */
+extern void cs_od_force_suspend(void);
+
+/*
  * Deadline, in jiffies, until which cyan_skillfish_od_edit_dpm_table() keeps
  * deferring OD commits for a PCON that has just been through a modeset.
  *
@@ -135,6 +141,13 @@
 	WRITE_ONCE(cs_pcon_frl_defer_until,
 		   jiffies + msecs_to_jiffies(cs_pcon_frl_defer_ms));
 
+	/*
+	 * The PCON trains its HDMI side from here on, and a held override
+	 * makes that fail. Re-arm the release so it stays off across the
+	 * part DC cannot observe.
+	 */
+	cs_od_force_suspend();
+
 	if (cs_od_defer_debug)
 		pr_info("amdgpu: cs_od_defer: DP-HDMI21 PCON modeset, deferring OD clock/voltage commits for %ums\n",
 			cs_pcon_frl_defer_ms);
--- a/drivers/gpu/drm/amd/display/dc/link/protocols/link_dp_training.c
+++ b/drivers/gpu/drm/amd/display/dc/link/protocols/link_dp_training.c
@@ -59,6 +59,14 @@
