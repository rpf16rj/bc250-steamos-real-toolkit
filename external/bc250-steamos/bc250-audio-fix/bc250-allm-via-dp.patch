--- a/drivers/gpu/drm/amd/display/dc/dio/dcn10/dcn10_stream_encoder.c
+++ b/drivers/gpu/drm/amd/display/dc/dio/dcn10/dcn10_stream_encoder.c
@@ -758,6 +758,32 @@ void enc1_stream_encoder_update_dp_info_packets(
 				5,  /* packetIndex */
 				&info_frame->adaptive_sync);
 
+	/* Remap AVI infoframe to DP SDP format for PCON forwarding.
+	 * The PCON in Source Control Mode uses AVI content_type to autonomously
+	 * generate HF-VSIF with ALLM. We do NOT send HF-VSIF SDP — the PCON
+	 * generates it based on the AVI content_type=Game hint.
+	 * HDMI infoframe: hb0=type, hb1=version, hb2=length, sb[0]=checksum, sb[1+]=payload
+	 * DP SDP: HB0=0x00, HB1=type, HB2=0x1F-(type&0x0F),
+	 *         HB3=(0x13<<2)=0x4C, DB0=version, DB1=length, DB2+=payload (no checksum)
+	 */
+	if (info_frame->avi.valid) {
+		struct dc_info_packet dp_avi;
+		int i;
+
+		memset(&dp_avi, 0, sizeof(dp_avi));
+		dp_avi.valid = true;
+		dp_avi.hb0 = 0x00;
+		dp_avi.hb1 = info_frame->avi.hb0; /* type 0x02 */
+		dp_avi.hb2 = 0x1F - (info_frame->avi.hb0 & 0x0F); /* 0x1D */
+		dp_avi.hb3 = (0x13 & 0x3f) << 2; /* 0x4C */
+		dp_avi.sb[0] = info_frame->avi.hb1; /* version */
+		dp_avi.sb[1] = info_frame->avi.hb2; /* length */
+		for (i = 0; i < 13; i++)
+			dp_avi.sb[2 + i] = info_frame->avi.sb[1 + i];
+
+		enc1_update_generic_info_packet(enc1, 6, &dp_avi);
+	}
+
 	/* enable/disable transmission of packet(s).
 	 * If enabled, packet transmission begins on the next frame
 	 */
