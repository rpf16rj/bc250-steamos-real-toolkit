+/* BC-250 ungate instrumentation: at bc250_vcn_ungate>=3 emit a
+ * breadcrumb and settle 200ms before each MMIO stage, so journald
+ * keeps the last marker if a register access wedges the fabric.
+ * The step name is also persisted to the EFI variable
+ * "BC250VcnStep-<guid>" — a fabric wedge can stall the CPU so hard that
+ * NMI/panic/pstore/journald/console all die, but an NVRAM write that
+ * already completed survives. On the next boot the variable holds the
+ * last completed step; the killer is the next stage in the sequence.
+ * Read with: cat /sys/firmware/efi/efivars/BC250VcnStep-* */
+#define BC250_STEP_EFI_GUID \
+	EFI_GUID(0xb250cafe, 0xf00d, 0x4b1c, 0x8a, 0x3d, 0x00, 0x11, 0x22, 0x33, 0x44, 0x55)
+
+static void bc250_vcn_persist_step(const char *msg)
+{
+#ifdef CONFIG_EFI
+	static efi_char16_t name[] =
+		{ 'B','C','2','5','0','V','c','n','S','t','e','p', 0 };
+	efi_guid_t guid = BC250_STEP_EFI_GUID;
+
+	if (!efi_enabled(EFI_RUNTIME_SERVICES))
+		return;
+
+	efivar_set_variable(name, &guid,
+			    EFI_VARIABLE_NON_VOLATILE |
+			    EFI_VARIABLE_BOOTSERVICE_ACCESS |
+			    EFI_VARIABLE_RUNTIME_ACCESS,
+			    strlen(msg) + 1, (void *)msg);
+#endif
+}
+MODULE_IMPORT_NS("EFIVAR");
+
+#define BC250_VCN_STEP(_adev, _msg)					\
+	do {								\
+		if (amdgpu_bc250_vcn_ungate >= 3) {			\
+			dev_warn((_adev)->dev, "BC-250: VCN %s\n", _msg); \
+			bc250_vcn_persist_step(_msg);			\
+			msleep(200);					\
+		}							\
+	} while (0)
