+static bool
+bc250_nested_context(nir_scalar index, nir_block *block, struct bc250_nested_context *ctx)
+{
+   memset(ctx,0,sizeof(*ctx));
+   if (!bc250_nested_collect(index,ctx,0) || (ctx->count!=1 && ctx->count!=3)) return false;
+   /* Sort by actual nesting ancestry, not pointer addresses or stale indices. */
+   for (unsigned i=0;i<ctx->count;i++) for (unsigned j=i+1;j<ctx->count;j++) {
+      nir_loop *a=bc250_nested_owner(&nir_def_instr(ctx->phis[i])->block->cf_node);
+      nir_loop *b=bc250_nested_owner(&nir_def_instr(ctx->phis[j])->block->cf_node);
+      if (!a || !b || a==b) return false;
+      if (bc250_nested_inside(&a->cf_node,&b->cf_node)) {
+         nir_def *tmp=ctx->phis[i];ctx->phis[i]=ctx->phis[j];ctx->phis[j]=tmp;
+      } else if (!bc250_nested_inside(&b->cf_node,&a->cf_node)) return false;
+   }
+   ctx->columns=1;
+   for (unsigned i=0;i<ctx->count;i++) {
+      nir_loop *loop=bc250_nested_owner(&nir_def_instr(ctx->phis[i])->block->cf_node);
+      if (!loop || !bc250_nested_inside(&block->cf_node,&loop->cf_node) ||
+          !bc250_nested_trip(ctx->phis[i],&ctx->trips[i])) return false;
+      ctx->columns*=ctx->trips[i];
+   }
+   if (ctx->columns>32 || nir_def_instr(ctx->phis[ctx->count-1])->block!=block) return false;
+   if (ctx->count==1) return ctx->trips[0]==8 || ctx->trips[0]==16 || ctx->trips[0]==32;
+   return ctx->trips[0]==2 && ctx->trips[1]==2 && ctx->trips[2]==8;
+}
+
+static bool
+bc250_nested_same_context(const struct bc250_nested_context *a,const struct bc250_nested_context *b)
+{
+   if (a->count!=b->count || a->columns!=b->columns) return false;
+   for (unsigned i=0;i<a->count;i++) if (a->phis[i]!=b->phis[i] || a->trips[i]!=b->trips[i]) return false;
+   return true;
+}
+
+static bool
+bc250_nested_plan_groups(nir_def *dots[400],nir_def *loads[400],unsigned maximum,
+                         struct bc250_nested_groups *plan)
+{
+   if (maximum!=4 && maximum!=16) return false;
+   memset(plan,0,sizeof(*plan));
+   int parent[400],child[400];struct bc250_nested_context contexts[400];
+   int8_t (*coefficients)[32][4]=calloc(400,sizeof(*coefficients));
+   if (!coefficients) return false;
+   bool valid=false;unsigned single[3]={0},nested=0;
+   for (unsigned i=0;i<400;i++) { parent[i]=child[i]=-1;plan->previous[i]=plan->first[i]=-1; }
+   for (unsigned i=0;i<400;i++) {
+      nir_alu_instr *dot=nir_instr_as_alu(nir_def_instr(dots[i]));
+      for (unsigned s=0;s<3;s++)
+         if (dot->src[s].swizzle[0] || dot->src[s].src.ssa->num_components!=1 || dot->src[s].src.ssa->bit_size!=32) goto done;
+      for (unsigned j=0;j<400;j++) if (dot->src[2].src.ssa==dots[j]) {
+         if (j>=i || child[j]!=-1 || nir_def_instr(dots[j])->block!=dot->instr.block) goto done;
+         unsigned uses=0;
+         nir_foreach_use_including_if(use,dots[j]) {
+            if (nir_src_is_if(use) || nir_src_use_instr(use)!=&dot->instr) goto done;
+            uses++;
+         }
+         if (uses!=1) goto done;
+         parent[i]=j;child[j]=i;
+      }
+      nir_intrinsic_instr *load=nir_instr_as_intrinsic(nir_def_instr(loads[i]));
+      nir_deref_instr *array=nir_src_as_deref(load->src[0]);nir_scalar index=nir_get_scalar(array->arr.index.ssa,0);
+      struct bc250_nested_context *ctx=&contexts[i];
