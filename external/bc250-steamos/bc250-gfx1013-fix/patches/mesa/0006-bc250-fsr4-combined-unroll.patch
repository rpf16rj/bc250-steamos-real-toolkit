+      }
+   }
+   if (single[0]!=144 || single[1]!=128 || single[2]!=64 || nested!=64) goto done;
+   unsigned roots=0,covered=0;
+   for (unsigned root=0;root<400;root++) if (parent[root]==-1) {
+      roots++;int current=root;
+      while (current!=-1) {
+         int start=current,previous=-1;unsigned length=0;int32_t bounds[32][2][2]={0};
+         while (current!=-1 && length<maximum) {
+            if (!bc250_nested_same_context(&contexts[current],&contexts[start])) goto done;
+            int32_t proposed[32][2][2];memcpy(proposed,bounds,sizeof(bounds));bool fits=true;
+            for (unsigned column=0;column<contexts[current].columns;column++) for (unsigned pair=0;pair<2;pair++) {
+               for (unsigned channel=2*pair;channel<2*pair+2;channel++) {
+                  int32_t value=coefficients[current][column][channel],a=-128*value,b=127*value;
+                  proposed[column][pair][0]+=MIN2(a,b);proposed[column][pair][1]+=MAX2(a,b);
+               }
+               fits &= proposed[column][pair][0]>=-32768 && proposed[column][pair][1]<=32767;
+            }
