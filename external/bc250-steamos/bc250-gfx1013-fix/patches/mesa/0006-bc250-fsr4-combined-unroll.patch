+}
+
+static bool
+bc250_nested_unroll_plan(nir_if *outer, nir_def *counters[6])
+{
+   const unsigned trips[6] = {8,32,16,2,2,8};
+   const unsigned depths[6] = {1,1,1,1,2,3};
+   unsigned count=0;
+   nir_foreach_block_in_cf_node(block,&outer->cf_node) {
+      if (block->cf_node.parent->type != nir_cf_node_loop) continue;
+      nir_loop *loop=nir_cf_node_as_loop(block->cf_node.parent);
+      if (block != nir_loop_first_block(loop)) continue;
+      if (count==6) return false;
+      unsigned depth=0;
+      for (nir_cf_node *node=&loop->cf_node; node && node!=&outer->cf_node; node=node->parent)
+         if (node->type==nir_cf_node_loop) depth++;
+      if (depth!=depths[count]) return false;
+      unsigned found=0;
+      nir_foreach_instr(instr,block) {
+         if (instr->type!=nir_instr_type_phi) continue;
+         nir_def *def=&nir_instr_as_phi(instr)->def;
+         unsigned trip;
+         if (!bc250_nested_trip(def,&trip)) continue;
+         if (trip!=trips[count]) return false;
+         counters[count]=def;found++;
+      }
+      if (found!=1) return false;
+      count++;
+   }
+   return count==6;
+}
