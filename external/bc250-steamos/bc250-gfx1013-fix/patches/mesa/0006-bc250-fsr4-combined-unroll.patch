+static void
+bc250_fsr4_unpack_pairs(nir_builder *b, nir_def *packed, nir_def **even, nir_def **odd)
+{
+   *even = nir_ishr_imm(b, nir_unpack_32_2x16(b, nir_ishl_imm(b, packed, 8)), 8);
+   *odd = nir_ishr_imm(b, nir_unpack_32_2x16(b, packed), 8);
+}
+
+static bool
+bc250_fsr4_count(nir_builder *b, nir_alu_instr *alu, void *data)
+{
+   (void)b;
+   struct bc250_fsr4_counts *s = data;
+   if (alu->op != nir_op_sdot_4x8_iadd)
+      return false;
+   s->dots++;
+   s->constant_dots += nir_src_is_const(alu->src[0].src) || nir_src_is_const(alu->src[1].src);
+   s->zero_acc += nir_src_is_const(alu->src[2].src) && nir_src_as_uint(alu->src[2].src) == 0;
+   return false;
+}
+
+static bool
+bc250_fsr4_dot(nir_builder *b, nir_alu_instr *alu, void *data)
+{
+   enum bc250_fsr4_dot_mode mode = *(enum bc250_fsr4_dot_mode *)data;
+   if (alu->op != nir_op_sdot_4x8_iadd) return false;
+   bool constant = nir_src_is_const(alu->src[0].src) || nir_src_is_const(alu->src[1].src);
+   if ((mode == BC250_FSR4_FIXED) != constant) return false;
+   b->cursor = nir_before_instr(&alu->instr);
+   nir_def *a = nir_ssa_for_alu_src(b, alu, 0);
+   nir_def *v = nir_ssa_for_alu_src(b, alu, 1);
+   nir_def *c = nir_ssa_for_alu_src(b, alu, 2), *r;
+   if (mode == BC250_FSR4_FIXED) {
+      nir_def *ae, *ao, *ve, *vo;
+      bc250_fsr4_unpack_pairs(b, a, &ae, &ao);
+      bc250_fsr4_unpack_pairs(b, v, &ve, &vo);
+      nir_def *pair = nir_iadd(b, nir_imul(b, ae, ve), nir_imul(b, ao, vo));
+      uint32_t weights = nir_alu_src_as_uint(alu->src[nir_src_is_const(alu->src[0].src) ? 0 : 1]);
+      /* Only (-128,-128) can exceed signed i16; use the exact biased fallback. */
+      bool bounded = (weights & 0xffff) != 0x8080 && (weights >> 16) != 0x8080;
+      nir_def *wide;
+      if (bounded) {
+         wide = nir_i2i32(b, pair);
+         r = nir_iadd(b, nir_channel(b, wide, 0), nir_channel(b, wide, 1));
+      } else {
+         pair = nir_iadd(b, pair, nir_imm_intN_t(b, 32512, 16));
+         wide = nir_u2u32(b, pair);
+         r = nir_iadd_imm(b, nir_iadd(b, nir_channel(b, wide, 0), nir_channel(b, wide, 1)), -65024);
+      }
+      r = nir_iadd(b, r, c);
+   } else if (mode == BC250_FSR4_CHAIN2) {
+      nir_def *lo = nir_build_alu2(b, nir_op_imul24_relaxed,
+                                  nir_extract_i8_imm(b, a, 0), nir_extract_i8_imm(b, v, 0));
+      lo = nir_imad24_ir3(b, nir_extract_i8_imm(b, a, 1), nir_extract_i8_imm(b, v, 1), lo);
+      nir_def *hi = nir_build_alu2(b, nir_op_imul24_relaxed,
+                                  nir_extract_i8_imm(b, a, 2), nir_extract_i8_imm(b, v, 2));
+      hi = nir_imad24_ir3(b, nir_extract_i8_imm(b, a, 3), nir_extract_i8_imm(b, v, 3), hi);
+      r = nir_iadd(b, nir_iadd(b, lo, hi), c);
+   } else {
+      r = c;
+      for (unsigned i = 0; i < 4; i++)
+         r = nir_imad24_ir3(b, nir_extract_i8_imm(b, a, i), nir_extract_i8_imm(b, v, i), r);
+   }
+   nir_def_replace(&alu->def, r);
+   return true;
+}
+
+static bool
+bc250_fsr4_lower(nir_shader *nir)
+{
+   struct bc250_fsr4_counts s = {0};
+   nir_shader_alu_pass(nir, bc250_fsr4_count, nir_metadata_all, &s);
+   if (s.dots < 16) return false;
+   enum bc250_fsr4_dot_mode mode = BC250_FSR4_FIXED;
+   if (s.constant_dots == 0) {
+      if (s.dots == 512 || s.dots == 272) mode = BC250_FSR4_CHAIN;
+      else if (s.dots == 336) mode = BC250_FSR4_CHAIN2;
+   }
+   return nir_shader_alu_pass(nir, bc250_fsr4_dot, nir_metadata_control_flow, &mode);
+}
+
+static bool
+bc250_group_eligible(nir_alu_instr *alu)
+{
+   return alu->op == nir_op_sdot_4x8_iadd && alu->def.num_components == 1 &&
+          (nir_src_is_const(alu->src[0].src) || nir_src_is_const(alu->src[1].src));
+}
+
+static bool
+bc250_group_one(nir_builder *b, nir_alu_instr *alu, void *data)
+{
+   struct bc250_group_options *options = data;
+   if (!bc250_group_eligible(alu) || nir_def_is_unused(&alu->def)) return false;
+   /* Visit only reduction tails. DCE and another pass expose the remaining
+    * tails when an interval or group-size limit splits a longer chain. */
+   nir_foreach_use(use, &alu->def) {
+      nir_instr *parent = nir_src_use_instr(use);
+      if (parent->type != nir_instr_type_alu) continue;
+      nir_alu_instr *next = nir_instr_as_alu(parent);
+      if (bc250_group_eligible(next) && use == &next->src[2].src) return false;
+   }
+   nir_alu_instr *chain[16]; unsigned count = 0;
+   int minimum[2] = {0,0}, maximum[2] = {0,0};
+   nir_alu_instr *current = alu;
+   while (count < options->limit && bc250_group_eligible(current)) {
+      uint32_t weights = nir_alu_src_as_uint(current->src[nir_src_is_const(current->src[0].src) ? 0 : 1]);
+      int lo[2] = {minimum[0],minimum[1]}, hi[2] = {maximum[0],maximum[1]};
+      for (unsigned i = 0; i < 4; i++) {
+         int w = (int8_t)(weights >> (8*i));
+         lo[i/2] += w >= 0 ? -128*w : 127*w;
+         hi[i/2] += w >= 0 ? 127*w : -128*w;
+      }
+      if (lo[0] < -32768 || lo[1] < -32768 || hi[0] > 32767 || hi[1] > 32767) break;
+      memcpy(minimum,lo,sizeof(lo)); memcpy(maximum,hi,sizeof(hi)); chain[count++] = current;
+      nir_def *previous = current->src[2].src.ssa;
+      if (previous->num_components != 1 || current->src[2].swizzle[0] != 0 ||
+          nir_def_instr(previous)->type != nir_instr_type_alu) break;
+      unsigned uses = 0; nir_foreach_use_including_if(use, previous) uses++;
+      if (uses != 1) break;
+      current = nir_instr_as_alu(nir_def_instr(previous));
+   }
+   if (count < 2) return false;
+   b->cursor = nir_before_instr(&alu->instr);
+   nir_def *base = nir_ssa_for_alu_src(b, chain[count-1], 2), *sum = NULL;
+   for (unsigned i = 0; i < count; i++) {
+      nir_def *a = nir_ssa_for_alu_src(b, chain[i], 0), *v = nir_ssa_for_alu_src(b, chain[i], 1);
+      nir_def *ae, *ao, *ve, *vo;
+      bc250_fsr4_unpack_pairs(b, a, &ae, &ao);
+      bc250_fsr4_unpack_pairs(b, v, &ve, &vo);
+      nir_def *pair = nir_iadd(b, nir_imul(b,ae,ve), nir_imul(b,ao,vo));
+      sum = sum ? nir_iadd(b,sum,pair) : pair;
+   }
+   nir_def *wide = nir_i2i32(b,sum);
+   nir_def *result = nir_iadd(b,base,nir_iadd(b,nir_channel(b,wide,0),nir_channel(b,wide,1)));
+   nir_def_replace(&alu->def,result); options->groups++; options->dots += count;
+   return true;
+}
+
+static bool
+bc250_fsr4_grouped_dot(nir_shader *nir, bool paired_outputs)
+{
+   struct bc250_fsr4_counts counts = {0};
+   nir_shader_alu_pass(nir, bc250_fsr4_count, nir_metadata_all, &counts);
+   if (!paired_outputs && !((counts.dots == 832 || counts.dots == 1600 || counts.dots == 960) &&
+                            counts.constant_dots == counts.dots)) return false;
+   struct bc250_group_options options = {.limit = 16};
+   bool progress = false;
+   while (nir_shader_alu_pass(nir, bc250_group_one, nir_metadata_control_flow, &options)) {
+      progress = true;
+      nir_opt_dce(nir);
+   }
+   return progress;
+}
+
+static bool
+bc250_collect_dynamic_column(nir_builder *b, nir_alu_instr *alu, void *data)
+{
+   (void)b;
+   struct bc250_dynamic_columns *set = data;
+   if (set->count >= 512 || !bc250_group_eligible(alu) || nir_def_is_unused(&alu->def)) return false;
+   nir_foreach_use(use, &alu->def) {
+      nir_instr *parent = nir_src_use_instr(use);
+      if (parent->type == nir_instr_type_alu && bc250_group_eligible(nir_instr_as_alu(parent)) &&
+          use == &nir_instr_as_alu(parent)->src[2].src) return false;
+   }
+   nir_alu_instr *chain[128], *current = alu;
+   unsigned length = 0;
+   while (length < 128 && bc250_group_eligible(current) && current->instr.block == alu->instr.block) {
+      unsigned c = nir_src_is_const(current->src[0].src) ? 0 : 1;
+      if (nir_src_is_const(current->src[1-c].src)) break;
+      chain[length++] = current;
+      nir_def *prev = current->src[2].src.ssa;
+      if (prev->num_components != 1 || current->src[2].swizzle[0] || nir_def_instr(prev)->type != nir_instr_type_alu) break;
+      unsigned uses = 0; nir_foreach_use_including_if(use, prev) uses++;
+      if (uses != 1) break;
+      current = nir_instr_as_alu(nir_def_instr(prev));
+   }
+   if (!length) return false;
+   struct bc250_dynamic_column column = {.base = chain[length-1]->src[2]};
+   int lo = 0, hi = 0;
+   for (unsigned j = length; j && column.count < 32; j--) {
+      current = chain[j-1];
+      unsigned c = nir_src_is_const(current->src[0].src) ? 0 : 1;
+      uint32_t weights = nir_alu_src_as_uint(current->src[c]);
+      for (unsigned byte = 0; byte < 4; byte++) {
+         int w = (int8_t)(weights >> (8*byte));
+         lo += w >= 0 ? -128*w : 127*w;
+         hi += w >= 0 ? 127*w : -128*w;
+      }
+      if (lo < -32768 || hi > 32767) break;
+      unsigned k = column.count++;
+      column.inputs[k] = current->src[1-c];
+      column.weights[k] = weights;
+      column.tails[k] = current;
+   }
+   if (column.count) set->columns[set->count++] = column;
+   return false;
+}
+
+static bool
+bc250_column_source_available(nir_alu_src src, nir_instr *before)
+{
+   nir_instr *def = nir_def_instr(src.src.ssa);
+   return def->block == before->block ? nir_instr_is_before(def, before) :
+          nir_block_dominates(def->block, before->block);
+}
+
+static bool
+bc250_column_instr_before_indexed(nir_instr *first, nir_instr *second)
+{
+   bool before = first->block == second->block && first->index < second->index;
+   assert(before == nir_instr_is_before(first, second));
+   return before;
+}
+
+static bool
+bc250_column_source_available_indexed(nir_alu_src src, nir_instr *before)
+{
+   nir_instr *def = nir_def_instr(src.src.ssa);
+   return def->block == before->block ? bc250_column_instr_before_indexed(def, before) :
+          nir_block_dominates(def->block, before->block);
+}
+
+static bool
+bc250_pair_dynamic_columns_once_baseline(nir_shader *nir, unsigned *covered)
+{
+   struct bc250_dynamic_columns set = {.columns = calloc(512, sizeof(struct bc250_dynamic_column))};
+   if (!set.columns) return false;
+   nir_shader_alu_pass(nir, bc250_collect_dynamic_column, nir_metadata_all, &set);
+   nir_foreach_function_impl(impl, nir)
+      nir_metadata_require(impl, nir_metadata_instr_index | nir_metadata_dominance);
+   bool progress = false;
+   for (unsigned i = 0; i < set.count && !progress; i++) {
+      struct bc250_dynamic_column *a = &set.columns[i];
+      for (unsigned j = i + 1; j < set.count && !progress; j++) {
+         struct bc250_dynamic_column *v = &set.columns[j];
+         unsigned count = MIN2(a->count, v->count);
+         nir_alu_instr *at = a->tails[count-1], *vt = v->tails[count-1];
+         if (at->instr.block != vt->instr.block) continue;
+         nir_instr *first = bc250_column_instr_before_indexed(&at->instr, &vt->instr) ? &at->instr : &vt->instr;
+         bool legal = bc250_column_source_available_indexed(a->base, first) && bc250_column_source_available_indexed(v->base, first);
+         for (unsigned k = 0; k < count && legal; k++)
+            legal = a->inputs[k].src.ssa == v->inputs[k].src.ssa &&
+                    a->inputs[k].swizzle[0] == v->inputs[k].swizzle[0] &&
+                    bc250_column_source_available_indexed(a->inputs[k], first);
+         if (!legal) continue;
+         nir_builder b = nir_builder_at(nir_before_instr(first));
+         nir_def *sum = NULL;
+         for (unsigned k = 0; k < count; k++) {
+            nir_def *packed = nir_channel(&b, a->inputs[k].src.ssa, a->inputs[k].swizzle[0]);
+            nir_def *even, *odd;
+            bc250_fsr4_unpack_pairs(&b, packed, &even, &odd);
+            for (unsigned byte = 0; byte < 4; byte++) {
+               nir_def *input = nir_channel(&b, byte & 1 ? odd : even, byte / 2);
+               nir_def *weights = nir_vec2(&b, nir_imm_intN_t(&b, (int8_t)(a->weights[k] >> (8*byte)), 16),
+                                              nir_imm_intN_t(&b, (int8_t)(v->weights[k] >> (8*byte)), 16));
+               nir_def *product = nir_imul(&b, nir_vec2(&b, input, input), weights);
+               sum = sum ? nir_iadd(&b, sum, product) : product;
+            }
+         }
+         nir_def *wide = nir_i2i32(&b, sum);
+         nir_def *out0 = nir_iadd(&b, nir_channel(&b, wide, 0), nir_channel(&b, a->base.src.ssa, a->base.swizzle[0]));
+         nir_def *out1 = nir_iadd(&b, nir_channel(&b, wide, 1), nir_channel(&b, v->base.src.ssa, v->base.swizzle[0]));
+         nir_def_replace(&at->def, out0); nir_def_replace(&vt->def, out1);
+         *covered += 2*count; progress = true;
+      }
+   }
+   free(set.columns);
+   if (progress) nir_opt_dce(nir);
+   return progress;
+}
+
+static bool
+bc250_collect_stream_column(nir_builder *b, nir_alu_instr *alu, void *data)
+{
+   (void)b;
+   struct bc250_stream_columns *set = data;
+   if (set->excess || !bc250_group_eligible(alu) || nir_def_is_unused(&alu->def)) return false;
+   nir_foreach_use(use, &alu->def) {
+      nir_instr *parent = nir_src_use_instr(use);
+      if (parent->type == nir_instr_type_alu && bc250_group_eligible(nir_instr_as_alu(parent)) &&
+          use == &nir_instr_as_alu(parent)->src[2].src) return false;
+   }
+   nir_alu_instr *chain[37], *current = alu;
+   unsigned length = 0;
+   while (length < 37 && bc250_group_eligible(current) && current->instr.block == alu->instr.block) {
+      unsigned c = nir_src_is_const(current->src[0].src) ? 0 : 1;
+      if (nir_src_is_const(current->src[1-c].src)) break;
+      chain[length++] = current;
+      nir_def *prev = current->src[2].src.ssa;
+      if (prev->num_components != 1 || current->src[2].swizzle[0] ||
+          nir_def_instr(prev)->type != nir_instr_type_alu) break;
+      unsigned uses = 0; nir_foreach_use_including_if(use, prev) uses++;
+      if (uses != 1) break;
+      current = nir_instr_as_alu(nir_def_instr(prev));
+   }
+   if (length != 36) return false;
+   if (set->count == 16) { set->excess = true; return false; }
+   struct bc250_stream_column *column = &set->columns[set->count++];
+   column->tail = alu;
+   column->base = chain[35]->src[2];
+   for (unsigned k = 0; k < 36; k++) {
+      current = chain[35-k];
+      unsigned c = nir_src_is_const(current->src[0].src) ? 0 : 1;
+      column->inputs[k] = current->src[1-c];
+      column->weights[k] = nir_alu_src_as_uint(current->src[c]);
+   }
+   return false;
+}
+
+static bool
+bc250_stream_primary(nir_shader *nir)
+{
+   struct bc250_stream_columns *set = calloc(1, sizeof(*set));
+   if (!set) return false;
+   nir_shader_alu_pass(nir, bc250_collect_stream_column, nir_metadata_all, set);
+   if (set->excess || set->count != 16) { free(set); return false; }
+   nir_foreach_function_impl(impl, nir)
+      nir_metadata_require(impl, nir_metadata_dominance | nir_metadata_instr_index);
+   nir_instr *first = &set->columns[0].tail->instr;
+   bool legal = true;
+   for (unsigned o = 0; o < 16; o++) {
+      struct bc250_stream_column *column = &set->columns[o];
+      if (column->tail->instr.block != first->block) legal = false;
+      else if (nir_instr_is_before(&column->tail->instr, first)) first = &column->tail->instr;
+      for (unsigned k = 0; k < 36; k++) {
+         nir_alu_src input = column->inputs[k], common = set->columns[0].inputs[k];
+         if (input.src.ssa != common.src.ssa || input.swizzle[0] != common.swizzle[0] ||
+             input.src.ssa->bit_size != 32) legal = false;
+      }
+      if (!bc250_column_source_available(column->base, &column->tail->instr)) legal = false;
+      /* Keep copied base references independent of tails replaced below. */
+      for (unsigned other = 0; other < 16; other++)
+         if (column->base.src.ssa == &set->columns[other].tail->def) legal = false;
+   }
+   for (unsigned k = 0; k < 36; k++)
+      if (!bc250_column_source_available(set->columns[0].inputs[k], first)) legal = false;
+   if (!legal) { free(set); return false; }
+
+   nir_builder b = nir_builder_at(nir_before_instr(first));
+   nir_def *partial[8] = {0}, *sums[8] = {0};
+   int minimum[8][2] = {{0}}, maximum[8][2] = {{0}};
+   unsigned flushes = 0;
+   for (unsigned k = 0; k < 36; k++) {
+      nir_alu_src src = set->columns[0].inputs[k];
+      nir_def *packed = nir_channel(&b, src.src.ssa, src.swizzle[0]);
+      nir_def *even, *odd;
+      bc250_fsr4_unpack_pairs(&b, packed, &even, &odd);
+      for (unsigned byte = 0; byte < 4; byte++) {
+         nir_def *input = nir_channel(&b, byte & 1 ? odd : even, byte / 2);
+         nir_def *replicated = nir_vec2(&b, input, input);
+         for (unsigned pair = 0; pair < 8; pair++) {
+            int weights[2], lo[2], hi[2];
+            bool overflow = false;
+            for (unsigned lane = 0; lane < 2; lane++) {
+               int w = (int8_t)(set->columns[2*pair+lane].weights[k] >> (8*byte));
+               weights[lane] = w;
+               lo[lane] = w >= 0 ? -128*w : 127*w;
+               hi[lane] = w >= 0 ? 127*w : -128*w;
+               overflow |= minimum[pair][lane] + lo[lane] < -32768 ||
+                           maximum[pair][lane] + hi[lane] > 32767;
+            }
+            if (overflow) {
+               /* A single signed-i8 product always fits i16, so the first
+                * product of a group can never take this branch. */
+               assert(partial[pair]);
+               nir_def *wide = nir_i2i32(&b, partial[pair]);
+               sums[pair] = sums[pair] ? nir_iadd(&b, sums[pair], wide) : wide;
+               partial[pair] = NULL;
+               minimum[pair][0] = minimum[pair][1] = 0;
+               maximum[pair][0] = maximum[pair][1] = 0;
+               flushes++;
+            }
+            for (unsigned lane = 0; lane < 2; lane++) {
+               minimum[pair][lane] += lo[lane];
+               maximum[pair][lane] += hi[lane];
+            }
+            nir_def *weight = nir_vec2(&b, nir_imm_intN_t(&b, weights[0], 16),
+                                           nir_imm_intN_t(&b, weights[1], 16));
+            nir_def *product = nir_imul(&b, replicated, weight);
+            partial[pair] = partial[pair] ? nir_iadd(&b, partial[pair], product) : product;
+         }
+      }
+   }
+   for (unsigned pair = 0; pair < 8; pair++) {
+      nir_def *wide = nir_i2i32(&b, partial[pair]);
+      sums[pair] = sums[pair] ? nir_iadd(&b, sums[pair], wide) : wide;
+   }
+   for (unsigned o = 0; o < 16; o++) {
+      struct bc250_stream_column *column = &set->columns[o];
+      nir_builder tail = nir_builder_at(nir_before_instr(&column->tail->instr));
+      nir_def *delta = nir_channel(&tail, sums[o/2], o%2);
+      nir_def *base = nir_channel(&tail, column->base.src.ssa, column->base.swizzle[0]);
+      nir_def *result = nir_iadd(&tail, delta, base);
+      nir_def_replace(&column->tail->def, result);
+   }
+   
+   free(set);
+   nir_foreach_function_impl(impl, nir) nir_progress(true, impl, nir_metadata_control_flow);
+   nir_opt_dce(nir);
+   return true;
+}
+
+static bool
+bc250_collect_point_column(nir_builder *b, nir_alu_instr *alu, void *data)
+{
+   (void)b;
+   struct bc250_point_set *set = data;
+   if (set->count == set->limit || !bc250_group_eligible(alu) || nir_def_is_unused(&alu->def)) return false;
+   nir_foreach_use(use, &alu->def) {
+      nir_instr *parent = nir_src_use_instr(use);
+      if (parent->type == nir_instr_type_alu && bc250_group_eligible(nir_instr_as_alu(parent)) &&
+          use == &nir_instr_as_alu(parent)->src[2].src) return false;
+   }
+   nir_alu_instr *chain[17], *current = alu;
+   unsigned length = 0;
+   while (length < 17 && bc250_group_eligible(current) && current->instr.block == alu->instr.block) {
+      unsigned c = nir_src_is_const(current->src[0].src) ? 0 : 1;
+      if (nir_src_is_const(current->src[1-c].src)) break;
+      chain[length++] = current;
+      nir_def *prev = current->src[2].src.ssa;
+      if (prev->num_components != 1 || current->src[2].swizzle[0] ||
+          nir_def_instr(prev)->type != nir_instr_type_alu) break;
+      unsigned uses = 0; nir_foreach_use_including_if(use, prev) uses++;
+      if (uses != 1) break;
+      current = nir_instr_as_alu(nir_def_instr(prev));
+   }
+   if (length != 4 && length != 8 && length != 16) return false;
+   struct bc250_point_column column = {.tail = alu, .base = chain[length-1]->src[2], .length = length};
+   for (unsigned k = 0; k < length; k++) {
+      current = chain[length-1-k];
+      unsigned c = nir_src_is_const(current->src[0].src) ? 0 : 1;
+      column.inputs[k] = current->src[1-c];
+      column.weights[k] = nir_alu_src_as_uint(current->src[c]);
+   }
+   if (set->count) {
+      struct bc250_point_column *first = &set->columns[0];
+      if (length != first->length || alu->instr.block != first->tail->instr.block) return false;
+      for (unsigned k = 0; k < length; k++)
+         if (column.inputs[k].src.ssa != first->inputs[k].src.ssa ||
+             column.inputs[k].swizzle[0] != first->inputs[k].swizzle[0]) return false;
+   }
+   set->columns[set->count++] = column;
+   return false;
+}
+
+static bool
+bc250_stream_point_chunk(nir_shader *nir, unsigned limit, unsigned *dots, unsigned *flush_count)
+{
+   struct bc250_point_set *set = calloc(1, sizeof(*set));
+   if (!set) return false;
+   set->limit = limit;
+   nir_shader_alu_pass(nir, bc250_collect_point_column, nir_metadata_all, set);
+   if (set->count < 2 || set->count % 2) { free(set); return false; }
+   nir_foreach_function_impl(impl, nir)
+      nir_metadata_require(impl, nir_metadata_dominance | nir_metadata_instr_index);
+   nir_instr *first = &set->columns[0].tail->instr;
+   bool legal = true;
+   for (unsigned o = 0; o < set->count; o++) {
+      struct bc250_point_column *column = &set->columns[o];
+      if (nir_instr_is_before(&column->tail->instr, first)) first = &column->tail->instr;
+      if (!bc250_column_source_available(column->base, &column->tail->instr)) legal = false;
+      for (unsigned other = 0; other < set->count; other++)
+         if (column->base.src.ssa == &set->columns[other].tail->def) legal = false;
+   }
+   unsigned length = set->columns[0].length;
+   for (unsigned k = 0; k < length; k++) {
+      nir_alu_src src = set->columns[0].inputs[k];
+      if (src.src.ssa->bit_size != 32 || !bc250_column_source_available(src, first)) legal = false;
+   }
+   if (!legal) { free(set); return false; }
+
+   nir_builder b = nir_builder_at(nir_before_instr(first));
+   nir_def *partial[8] = {0}, *sums[8] = {0};
+   int minimum[8][2] = {{0}}, maximum[8][2] = {{0}};
+   for (unsigned k = 0; k < length; k++) {
+      nir_alu_src src = set->columns[0].inputs[k];
+      nir_def *packed = nir_channel(&b, src.src.ssa, src.swizzle[0]);
+      nir_def *even, *odd;
+      bc250_fsr4_unpack_pairs(&b, packed, &even, &odd);
+      for (unsigned byte = 0; byte < 4; byte++) {
+         nir_def *input = nir_channel(&b, byte & 1 ? odd : even, byte / 2);
+         nir_def *replicated = nir_vec2(&b, input, input);
+         for (unsigned pair = 0; pair < set->count/2; pair++) {
+            int weights[2], lo[2], hi[2];
+            bool overflow = false;
+            for (unsigned lane = 0; lane < 2; lane++) {
+               int w = (int8_t)(set->columns[2*pair+lane].weights[k] >> (8*byte));
+               weights[lane] = w;
+               lo[lane] = w >= 0 ? -128*w : 127*w;
+               hi[lane] = w >= 0 ? 127*w : -128*w;
+               overflow |= minimum[pair][lane]+lo[lane] < -32768 || maximum[pair][lane]+hi[lane] > 32767;
+            }
+            if (overflow) {
+               assert(partial[pair]);
+               nir_def *wide = nir_i2i32(&b, partial[pair]);
+               sums[pair] = sums[pair] ? nir_iadd(&b, sums[pair], wide) : wide;
+               partial[pair] = NULL;
+               minimum[pair][0] = minimum[pair][1] = 0;
+               maximum[pair][0] = maximum[pair][1] = 0;
+               (*flush_count)++;
+            }
+            for (unsigned lane = 0; lane < 2; lane++) {
+               minimum[pair][lane] += lo[lane]; maximum[pair][lane] += hi[lane];
+            }
+            nir_def *weight = nir_vec2(&b, nir_imm_intN_t(&b, weights[0], 16), nir_imm_intN_t(&b, weights[1], 16));
+            nir_def *product = nir_imul(&b, replicated, weight);
+            partial[pair] = partial[pair] ? nir_iadd(&b, partial[pair], product) : product;
+         }
+      }
+   }
+   for (unsigned pair = 0; pair < set->count/2; pair++) {
+      nir_def *wide = nir_i2i32(&b, partial[pair]);
+      sums[pair] = sums[pair] ? nir_iadd(&b, sums[pair], wide) : wide;
+   }
+   for (unsigned o = 0; o < set->count; o++) {
+      struct bc250_point_column *column = &set->columns[o];
+      nir_builder tail = nir_builder_at(nir_before_instr(&column->tail->instr));
+      nir_def *base = nir_channel(&tail, column->base.src.ssa, column->base.swizzle[0]);
+      nir_def *result = nir_iadd(&tail, base, nir_channel(&tail, sums[o/2], o%2));
+      nir_def_replace(&column->tail->def, result);
+   }
+   *dots += set->count*length;
+   free(set);
+   nir_foreach_function_impl(impl, nir) nir_progress(true, impl, nir_metadata_control_flow);
+   nir_opt_dce(nir);
+   return true;
+}
+
+static bool
+bc250_stream_pointwise(nir_shader *nir, unsigned chunk, unsigned *covered)
+{
+   assert(chunk == 4 || chunk == 8 || chunk == 16);
+   unsigned chunks = 0, dots = 0, flushes = 0;
+   while (chunks < 128 && bc250_stream_point_chunk(nir, chunk, &dots, &flushes)) chunks++;
+   
+   *covered = dots;
+   return chunks != 0;
+}
+
+static bool
+bc250_partial_eligible(nir_alu_instr *alu)
+{
+   return alu->op == nir_op_sdot_4x8_iadd && alu->def.num_components == 1 &&
+          alu->def.bit_size == 32 && !nir_src_is_const(alu->src[0].src) &&
+          !nir_src_is_const(alu->src[1].src);
+}
+
+static bool
+bc250_collect_guard_column(nir_builder *b, nir_alu_instr *alu, void *data)
+{
+   (void)b;
+   struct bc250_guard_columns *set = data;
+   if (set->invalid || !bc250_partial_eligible(alu) || nir_def_is_unused(&alu->def)) return false;
+   nir_foreach_use(use, &alu->def) {
+      nir_instr *parent = nir_src_use_instr(use);
+      if (parent->type == nir_instr_type_alu && bc250_partial_eligible(nir_instr_as_alu(parent)) &&
+          use == &nir_instr_as_alu(parent)->src[2].src) return false;
+   }
+   if (set->count == ARRAY_SIZE(set->columns)) { set->invalid = true; return false; }
+   struct bc250_guard_column *column = &set->columns[set->count++];
+   nir_alu_instr *current = alu;
+   while (column->length < ARRAY_SIZE(column->chain) && bc250_partial_eligible(current) &&
+          current->instr.block == alu->instr.block) {
+      if (current->src[0].src.ssa->bit_size != 32 || current->src[1].src.ssa->bit_size != 32) {
+         set->invalid = true; return false;
+      }
+      column->chain[column->length++] = current;
+      nir_def *previous = current->src[2].src.ssa;
+      if (previous->num_components != 1 || current->src[2].swizzle[0] ||
+          nir_def_instr(previous)->type != nir_instr_type_alu) break;
+      unsigned uses = 0; nir_foreach_use_including_if(use, previous) uses++;
+      if (uses != 1) break;
+      current = nir_instr_as_alu(nir_def_instr(previous));
+   }
+   nir_def *base = column->chain[column->length-1]->src[2].src.ssa;
+   if (nir_def_instr(base)->type == nir_instr_type_alu && bc250_partial_eligible(nir_instr_as_alu(nir_def_instr(base))))
+      set->invalid = true;
+   return false;
+}
+
+static bool
+bc250_fsr4_dynamic_columns(nir_shader *nir, unsigned profile)
+{
+   struct bc250_fsr4_counts counts = {0};
+   nir_shader_alu_pass(nir, bc250_fsr4_count, nir_metadata_all, &counts);
+   if (!((counts.dots == 832 || counts.dots == 1600 || counts.dots == 960) &&
+         counts.constant_dots == counts.dots)) return false;
+   nir_foreach_function_impl(impl, nir) nir_metadata_require(impl, nir_metadata_dominance);
+   bool streamed = false;
+   unsigned streamed_dots = 0;
+   if (profile & 8) streamed = bc250_stream_primary(nir);
+   if (streamed) streamed_dots = 576;
+   unsigned point_dots = 0;
+   if (profile & 16) streamed |= bc250_stream_pointwise(nir, 4, &point_dots);
+   streamed_dots += point_dots;
+   unsigned pairs = 0, covered = streamed_dots;
+   while (pairs < 1024 && bc250_pair_dynamic_columns_once_baseline(nir, &covered)) pairs++;
+   if (pairs || streamed) nir_foreach_function_impl(impl, nir) nir_progress(true, impl, nir_metadata_control_flow);
+   return pairs != 0 || streamed;
+}
+
+static unsigned
+bc250_fsr4_profile(const void *bytes, size_t size)
+{
+   if (!bytes || debug_get_bool_option("BC250_FSR4_DISABLE", false)) return 0;
+   static const struct { size_t size; uint64_t hash; unsigned flags; } profiles[] = {
+      {108840, 0xbdf488022b494154ull, 17}, /* 963f411bf3adf4a6 */
+      {109048, 0x310d9fe8c354dd9aull, 27}, /* 9061c22140f39b6a */
+      {132572, 0xafdf6b944d44dc62ull, 129}, /* ddd1c7018bd1708f */
+      {190016, 0xdeda2a65a51ac02dull, 27}, /* 2897aa8c309540b9 */
+      {190032, 0x23cd67eeb5459571ull, 27}, /* aa4e6f6474b130b3 */
+      {497620, 0x74cc2fb944b19d7aull, 129}, /* 204cd1c7f7565b7b */
+      {79128, 0x0492522c120d937eull, 65539}, /* e288a0e9629bdace */
+      {79128, 0x5256ae5a5322b87dull, 131075}, /* 28d8a63cb6d53b09 */
+      {84476, 0xfbae1282dc350da1ull, 262147}, /* 3af1171a14f73767 */
+      {189952, 0xd870e225d3f3a750ull, 27}, /* 07cf611d7042a76e */
+      {61308, 0x8debe292dfad97f5ull, 1025}, /* f768eb37222b4fbd */
+      {109064, 0xf89485f5751695fbull, 25}, /* 76367260ae8284e1 */
+      {125784, 0x60169c44f557ae55ull, 1}, /* 88fc1786caa6ae3c */
+   };
+   bool candidate = false;
+   for (unsigned i = 0; i < ARRAY_SIZE(profiles); i++) candidate |= profiles[i].size == size;
+   if (!candidate) return 0;
+   uint64_t hash = 14695981039346656037ull;
+   for (size_t i = 0; i < size; i++) hash = (hash ^ ((const uint8_t *)bytes)[i]) * 1099511628211ull;
+   for (unsigned i = 0; i < ARRAY_SIZE(profiles); i++)
+      if (profiles[i].size == size && profiles[i].hash == hash) return profiles[i].flags;
+   return 0;
+}
+
+static bool
+bc250_coop_index_at_z0(nir_scalar value, uint32_t *result, unsigned depth)
+{
+   if (depth > 64 || value.def->bit_size != 32) return false;
+   value = nir_scalar_chase_movs(value);
+   if (nir_scalar_is_const(value)) { *result = nir_scalar_as_uint(value); return true; }
+   nir_instr *instr = nir_def_instr(value.def);
+   if (instr->type == nir_instr_type_intrinsic) {
+      if (nir_instr_as_intrinsic(instr)->intrinsic != nir_intrinsic_load_workgroup_id || value.comp != 2) return false;
+      *result = 0; return true;
+   }
+   if (!nir_scalar_is_alu(value)) return false;
+   nir_op op = nir_scalar_alu_op(value);
+   if (op != nir_op_iadd && op != nir_op_imul && op != nir_op_ishl &&
+       op != nir_op_ushr && op != nir_op_ior && op != nir_op_iand) return false;
+   uint32_t a, b;
+   if (!bc250_coop_index_at_z0(nir_scalar_chase_alu_src(value, 0), &a, depth+1) ||
+       !bc250_coop_index_at_z0(nir_scalar_chase_alu_src(value, 1), &b, depth+1)) return false;
+   switch (op) {
+   case nir_op_iadd: *result = a+b; break;
+   case nir_op_imul: *result = a*b; break;
+   case nir_op_ishl: *result = a << (b&31); break;
+   case nir_op_ushr: *result = a >> (b&31); break;
+   case nir_op_ior: *result = a|b; break;
+   case nir_op_iand: *result = a&b; break;
+   default: UNREACHABLE("checked operation");
+   }
+   return true;
+}
+
+static bool
+bc250_coop_pure_source(nir_src *src, void *data)
+{
+   struct bc250_coop_remat nested = *(struct bc250_coop_remat *)data;
+   nested.depth++;
+   return bc250_coop_pure(src->ssa, &nested);
+}
+
+static bool
+bc250_coop_pure(nir_def *def, struct bc250_coop_remat *s)
+{
+   if (s->depth > 64) return false;
+   nir_instr *instr = nir_def_instr(def);
+   if (instr->block != s->body) return nir_block_dominates(instr->block, s->before);
+   switch (instr->type) {
+   case nir_instr_type_load_const:
+   case nir_instr_type_alu:
+   case nir_instr_type_deref:
+      break;
+   case nir_instr_type_intrinsic: {
+      nir_intrinsic_instr *intrin = nir_instr_as_intrinsic(instr);
+      if (intrin->intrinsic == nir_intrinsic_load_deref) {
+         nir_deref_instr *deref = nir_src_as_deref(intrin->src[0]);
+         if (!nir_deref_mode_is(deref, nir_var_mem_push_const)) return false;
+      } else if (intrin->intrinsic != nir_intrinsic_vulkan_resource_index &&
+                 intrin->intrinsic != nir_intrinsic_load_vulkan_descriptor) return false;
+      break;
+   }
+   default: return false;
+   }
+   return nir_foreach_src(instr, bc250_coop_pure_source, s);
+}
+
+static bool
+bc250_coop_remat_source(nir_src *src, void *data)
+{
+   bc250_coop_rematerialize(src->ssa, data);
+   return true;
+}
+
+static nir_def *
+bc250_coop_rematerialize(nir_def *def, struct bc250_coop_remat *s)
+{
+   nir_instr *instr = nir_def_instr(def);
+   if (instr->block != s->body) return def;
+   struct hash_entry *entry = _mesa_hash_table_search(s->map, def);
+   if (entry) return entry->data;
+   nir_foreach_src(instr, bc250_coop_remat_source, s);
+   nir_instr *copy = nir_instr_clone_deep(s->b->shader, instr, s->map);
+   nir_builder_instr_insert(s->b, copy);
+   return nir_instr_def(copy);
+}
+
+static bool
+bc250_cooperative_guard(nir_shader *nir, unsigned profile)
+{
+   if (!(profile & 128)) return false;
+   const bool physical32 = false;
+   /* RADV has selected and lowered the subgroup size before this pass.
+    * Require both the API and physical size here; other sizes retain the
+    * untouched original shader, with no injected subgroup-size intrinsic. */
+   if (physical32) {
+      /* These internal votes and mbcnt use the selected physical wave.
+       * The original reviewed shaders have no wide subgroup operations. */
+      if (nir->info.min_subgroup_size != 32 || nir->info.max_subgroup_size != 32 ||
+          nir->info.uses_wide_subgroup_intrinsics) return false;
+   } else if (nir->info.api_subgroup_size != 64 || nir->info.min_subgroup_size != 64 ||
+              nir->info.max_subgroup_size != 64) return false;
+   unsigned physical_wave = physical32 ? 32 : 64;
+   if (nir->info.workgroup_size[0] != 64 || nir->info.workgroup_size[1] != 1 || nir->info.workgroup_size[2] != 1) return false;
+   struct bc250_fsr4_counts counts = {0};
+   nir_shader_alu_pass(nir, bc250_fsr4_count, nir_metadata_all, &counts);
+   if (counts.constant_dots || (counts.dots != 512 && counts.dots != 2048)) return false;
+   unsigned words = counts.dots, columns = words == 512 ? 32 : 64, length = words == 512 ? 16 : 32;
+   unsigned start_word = words == 512 ? 0x2180/4 : 0x6000/4;
+   const uint32_t *expected = words == 512 ? bc250_coop_weights_ddd1 : bc250_coop_weights_204c;
+   struct bc250_guard_columns *set = calloc(1, sizeof(*set)); if (!set) return false;
+   nir_shader_alu_pass(nir, bc250_collect_guard_column, nir_metadata_all, set);
+   if (set->invalid || set->count != columns) { free(set); return false; }
+   nir_block *body = set->columns[0].chain[0]->instr.block;
+   if (body->cf_node.parent->type != nir_cf_node_if) { free(set); return false; }
+   nir_if *outer = nir_cf_node_as_if(body->cf_node.parent);
+   if (!exec_list_is_singular(&outer->then_list) || !exec_list_is_singular(&outer->else_list) ||
+       nir_if_first_then_block(outer) != body ||
+       !exec_list_is_empty(&nir_if_first_else_block(outer)->instr_list)) {
+      free(set); return false;
+   }
+   nir_function_impl *impl = nir_cf_node_get_function(&outer->cf_node);
+   nir_block *before = nir_cf_node_as_block(nir_cf_node_prev(&outer->cf_node));
+   /* vote_all covers the table only when all physical lanes participate.
+    * Require the first top-level branch, reached without prior divergence. */
+   if (outer->cf_node.parent->type != nir_cf_node_function || before != nir_start_block(impl) ||
+       nir->info.workgroup_size_variable) { free(set); return false; }
+   nir_metadata_require(impl, nir_metadata_dominance);
+   bool legal = true;
+   nir_def *weight_loads[2048] = {0};
+   nir_deref_instr *root = NULL;
+   enum gl_access_qualifier access = 0;
+   for (unsigned c = 0; c < columns && legal; c++) {
+      struct bc250_guard_column *column = &set->columns[c];
+      if (column->length != length) { legal = false; break; }
+      for (unsigned k = 0; k < length && legal; k++) {
+         nir_alu_instr *dot = column->chain[k];
+         nir_def *rhs = dot->src[1].src.ssa;
+         if (dot->instr.block != body || dot->src[1].swizzle[0] || rhs->num_components != 1 || rhs->bit_size != 32 ||
+             nir_def_instr(rhs)->type != nir_instr_type_intrinsic) { legal = false; break; }
+         nir_intrinsic_instr *load = nir_instr_as_intrinsic(nir_def_instr(rhs));
+         if (load->intrinsic != nir_intrinsic_load_deref) { legal = false; break; }
+         enum gl_access_qualifier flags = nir_intrinsic_access(load);
+         if ((flags & (ACCESS_NON_WRITEABLE|ACCESS_CAN_REORDER)) != (ACCESS_NON_WRITEABLE|ACCESS_CAN_REORDER) ||
+             (flags & ACCESS_VOLATILE)) { legal = false; break; }
+         nir_deref_instr *array = nir_src_as_deref(load->src[0]);
+         if (array->deref_type != nir_deref_type_array || !nir_deref_mode_is(array, nir_var_mem_ssbo)) { legal = false; break; }
+         nir_deref_instr *parent = nir_deref_instr_parent(array);
+         if (!root) { root = parent; access = flags; }
+         uint32_t index;
+         if (root != parent || flags != access || !bc250_coop_index_at_z0(nir_get_scalar(array->arr.index.ssa, 0), &index, 0) ||
+             index < start_word || index >= start_word+words || weight_loads[index-start_word]) { legal = false; break; }
+         weight_loads[index-start_word] = rhs;
+      }
+   }
+   free(set);
+   for (unsigned w = 0; w < words; w++) legal &= weight_loads[w] != NULL;
+   /* The extracted block has no values escaping its original pixel branch. */
+   nir_foreach_instr(instr, body) {
+      if (instr->type == nir_instr_type_phi || instr->type == nir_instr_type_jump) legal = false;
+      nir_def *def = nir_instr_def(instr);
+      if (def) nir_foreach_use_including_if(use, def)
+         if (nir_src_is_if(use) || nir_src_use_instr(use)->block != body) legal = false;
+   }
+   struct bc250_coop_remat remat = {.body=body, .before=before};
+   if (!legal || !root || !bc250_coop_pure(&root->def, &remat)) return false;
+
+   /* All preconditions have been checked; mutations begin here. */
+   unsigned old_bytes = nir->constant_data_size, base = ALIGN_POT(old_bytes, 16);
+   nir->constant_data_size = base + 4*words;
+   nir->constant_data = rerzalloc_size(nir, nir->constant_data, old_bytes, nir->constant_data_size);
+   memcpy((char *)nir->constant_data+base, expected, 4*words);
+   nir_builder b = nir_builder_at(nir_before_cf_node(&outer->cf_node));
+   nir_def *active = outer->condition.ssa;
+   nir_def *eligible = nir_iand(&b, nir_vote_any(&b, 1, active),
+       nir_ieq_imm(&b, nir_channel(&b, nir_load_workgroup_id(&b), 2), 0));
+   nir_if *checking = nir_push_if(&b, eligible);
+   remat.b = &b; remat.map = _mesa_pointer_hash_table_create(NULL);
+   nir_deref_instr *guard_root = nir_instr_as_deref(nir_def_instr(bc250_coop_rematerialize(&root->def, &remat)));
+   _mesa_hash_table_destroy(remat.map, NULL);
+   nir_def *lane = physical32 ? nir_mbcnt_amd(&b, nir_imm_int(&b, -1), nir_imm_int(&b, 0)) :
+                               nir_load_subgroup_invocation(&b);
+   nir_def *different = NULL;
+   for (unsigned round = 0; round < words/(4*physical_wave); round++) {
+      nir_def *relative_word = nir_iadd_imm(&b, nir_ishl_imm(&b, lane, 2), round*4*physical_wave);
+      nir_def *proposed = nir_load_constant(&b, 4, 32, nir_ishl_imm(&b, relative_word, 2),
+                                            .base=base, .range=4*words, .align_mul=16, .align_offset=0);
+      for (unsigned j = 0; j < 4; j++) {
+         nir_deref_instr *ptr = nir_build_deref_array(&b, guard_root, nir_iadd_imm(&b, relative_word, start_word+j));
+         nir_def *actual = nir_load_deref_with_access(&b, ptr, access);
+         nir_def *diff = nir_ixor(&b, actual, nir_channel(&b, proposed, j));
+         different = different ? nir_ior(&b, different, diff) : diff;
+      }
+   }
+   nir_def *all_equal = nir_vote_all(&b, 1, nir_ieq_imm(&b, different, 0));
+   nir_push_else(&b, checking);
+   nir_def *unavailable = nir_imm_false(&b);
+   nir_pop_if(&b, checking);
+   nir_def *verified = nir_if_phi(&b, all_equal, unavailable);
+
+   /* Clone the entire original block; values from before the outer if
+    * dominate both alternatives. Original memory and floating ops stay intact. */
+   nir_cf_list original, clone;
+   b = nir_builder_at(nir_before_block(body));
+   b.cursor = nir_cf_extract(&original, nir_before_block(body), nir_after_block(body));
+   nir_if *choice = nir_push_if(&b, verified);
+   struct hash_table *map = _mesa_pointer_hash_table_create(NULL);
+   nir_cf_list_clone(&clone, &original, &nir_cursor_current_block(b.cursor)->cf_node, map);
+   nir_cf_reinsert(&clone, b.cursor);
+   b.cursor = nir_after_cf_list(&choice->then_list);
+   nir_push_else(&b, choice);
+   nir_cf_reinsert(&original, b.cursor);
+   b.cursor = nir_after_cf_list(&choice->else_list);
+   nir_pop_if(&b, choice);
+   for (unsigned w = 0; w < words; w++) {
+      struct hash_entry *entry = _mesa_hash_table_search(map, weight_loads[w]);
+      assert(entry);
+      nir_def *copy = entry->data;
+      nir_builder at = nir_builder_at(nir_before_instr(nir_def_instr(copy)));
+      nir_def_replace(copy, nir_imm_int(&at, expected[w]));
+   }
+   _mesa_hash_table_destroy(map, NULL);
+   nir_progress(true, impl, nir_metadata_none);
+   nir_opt_dce(nir);
+   nir_validate_shader(nir, "after bc250 cooperative guard and constant clone");
+
+   unsigned streamed = 0;
+   unsigned pairs = 0, covered = 0;
+   while (true) {
+      nir_progress(true, impl, nir_metadata_control_flow);
+      nir_metadata_require(impl, nir_metadata_dominance | nir_metadata_instr_index);
+      if (!bc250_pair_dynamic_columns_once_baseline(nir, &covered)) break;
+      pairs++;
+   }
+   nir_progress(true, impl, nir_metadata_control_flow);
+   bc250_fsr4_grouped_dot(nir, true);
+   enum bc250_fsr4_dot_mode fixed = BC250_FSR4_FIXED;
+   nir_shader_alu_pass(nir, bc250_fsr4_dot, nir_metadata_control_flow, &fixed);
+   nir_opt_dce(nir);
+   struct bc250_fsr4_counts remaining = {0};
+   nir_shader_alu_pass(nir, bc250_fsr4_count, nir_metadata_all, &remaining);
+   assert(remaining.dots == words && remaining.constant_dots == 0);
+   assert(streamed + covered == words);
+   nir_validate_shader(nir, "after bc250 cooperative constant reduction lowering");
+   
+   return true;
+}
+
+static bool
+bc250_loop_inside(nir_cf_node *node, nir_if *outer)
+{
+   for (; node; node = node->parent)
+      if (node == &outer->cf_node) return true;
+   return false;
+}
+
+static bool
+bc250_loop_pure_source(nir_src *src, void *data)
+{
+   struct bc250_loop_remat nested = *(struct bc250_loop_remat *)data;
+   nested.depth++;
+   return bc250_loop_pure(src->ssa, &nested);
+}
+
+static bool
+bc250_loop_pure(nir_def *def, struct bc250_loop_remat *s)
+{
+   if (s->depth > 64) return false;
+   if (_mesa_set_search(s->available, def)) return true;
+   nir_instr *instr = nir_def_instr(def);
+   switch (instr->type) {
+   case nir_instr_type_load_const:
+   case nir_instr_type_alu:
+   case nir_instr_type_deref:
+      break;
+   case nir_instr_type_intrinsic: {
+      nir_intrinsic_instr *i = nir_instr_as_intrinsic(instr);
+      if (i->intrinsic == nir_intrinsic_load_deref) {
+         if (!nir_deref_mode_is(nir_src_as_deref(i->src[0]), nir_var_mem_push_const)) return false;
+      } else if (i->intrinsic != nir_intrinsic_vulkan_resource_index &&
+                 i->intrinsic != nir_intrinsic_load_vulkan_descriptor) return false;
+      break;
+   }
+   default: return false;
+   }
+   return nir_foreach_src(instr, bc250_loop_pure_source, s);
+}
+
+static bool
+bc250_loop_remat_source(nir_src *src, void *data)
+{
+   bc250_loop_rematerialize(src->ssa, data);
+   return true;
+}
+
+static nir_def *
+bc250_loop_rematerialize(nir_def *def, struct bc250_loop_remat *s)
+{
+   if (_mesa_set_search(s->available, def)) return def;
+   struct hash_entry *entry = _mesa_hash_table_search(s->map, def);
+   if (entry) return entry->data;
+   nir_instr *instr = nir_def_instr(def);
+   nir_foreach_src(instr, bc250_loop_remat_source, s);
+   nir_instr *copy = nir_instr_clone_deep(s->b->shader, instr, s->map);
+   nir_builder_instr_insert(s->b, copy);
+   return nir_instr_def(copy);
+}
+
+static bool
+bc250_loop_root(nir_deref_instr *root)
+{
+   if (!root || root->deref_type != nir_deref_type_struct || root->strct.index != 0 ||
+       !glsl_type_is_array(root->type) || glsl_get_array_element(root->type) != glsl_uint_type()) return false;
+   nir_deref_instr *cast = nir_deref_instr_parent(root);
+   if (!cast || cast->deref_type != nir_deref_type_cast ||
+       !nir_deref_mode_is(cast, nir_var_mem_ssbo) ||
+       glsl_get_struct_field_offset(cast->type, 0) != 0) return false;
+   nir_instr *instr = nir_def_instr(cast->parent.ssa);
+   if (instr->type != nir_instr_type_intrinsic) return false;
+   nir_intrinsic_instr *desc = nir_instr_as_intrinsic(instr);
+   if (desc->intrinsic != nir_intrinsic_load_vulkan_descriptor ||
+       nir_intrinsic_desc_type(desc) != nir_descriptor_type_storage_buffer) return false;
+   instr = nir_def_instr(desc->src[0].ssa);
+   if (instr->type != nir_instr_type_intrinsic) return false;
+   nir_intrinsic_instr *resource = nir_instr_as_intrinsic(instr);
+   if (resource->intrinsic != nir_intrinsic_vulkan_resource_index ||
+       nir_intrinsic_desc_set(resource) != 2 || nir_intrinsic_binding(resource) != 0 ||
+       nir_intrinsic_desc_type(resource) != nir_descriptor_type_storage_buffer) return false;
+   nir_scalar index = nir_scalar_chase_movs(nir_get_scalar(resource->src[0].ssa, 0));
+   if (!nir_scalar_is_alu(index) || nir_scalar_alu_op(index) != nir_op_iadd) return false;
+   nir_scalar a = nir_scalar_chase_movs(nir_scalar_chase_alu_src(index, 0));
+   nir_scalar b = nir_scalar_chase_movs(nir_scalar_chase_alu_src(index, 1));
+   if (nir_scalar_is_const(a)) { nir_scalar tmp=a; a=b; b=tmp; }
+   if (!nir_scalar_is_const(b) || nir_scalar_as_uint(b) != 18 || a.comp ||
+       a.def->num_components != 1 || a.def->bit_size != 32) return false;
+   instr = nir_def_instr(a.def);
+   if (instr->type != nir_instr_type_intrinsic) return false;
+   nir_intrinsic_instr *push = nir_instr_as_intrinsic(instr);
+   if (push->intrinsic != nir_intrinsic_load_deref) return false;
+   nir_deref_instr *field = nir_src_as_deref(push->src[0]);
+   if (field->deref_type != nir_deref_type_struct || field->strct.index != 2 ||
+       field->type != glsl_uint_type() || !nir_deref_mode_is(field, nir_var_mem_push_const)) return false;
+   nir_deref_instr *var = nir_deref_instr_parent(field);
+   return var && var->deref_type == nir_deref_type_var && glsl_get_struct_field_offset(var->type, 2) == 12;
+}
+
+static bool
+bc250_loop_cooperative_clone(nir_shader *nir, unsigned profile)
+{
+   if (!(profile & 1024)) return false;
+   if (nir->info.stage != MESA_SHADER_COMPUTE || nir->info.api_subgroup_size != 64 ||
+       nir->info.min_subgroup_size != 64 || nir->info.max_subgroup_size != 64 ||
+       nir->info.uses_wide_subgroup_intrinsics || nir->info.workgroup_size_variable ||
+       nir->info.workgroup_size[0] != 64 || nir->info.workgroup_size[1] != 1 || nir->info.workgroup_size[2] != 1) return false;
+   struct bc250_fsr4_counts counts = {0};
+   nir_shader_alu_pass(nir, bc250_fsr4_count, nir_metadata_all, &counts);
+   if (counts.dots != 272 || counts.constant_dots) return false;
+   nir_function_impl *impl = nir_shader_get_entrypoint(nir);
+   nir_block *before = nir_start_block(impl);
+   nir_cf_node *next = nir_cf_node_next(&before->cf_node);
+   if (!next || next->type != nir_cf_node_if) return false;
+   nir_if *outer = nir_cf_node_as_if(next);
+   if (outer->cf_node.parent->type != nir_cf_node_function ||
+       !exec_list_is_singular(&outer->else_list) ||
+       !exec_list_is_empty(&nir_if_first_else_block(outer)->instr_list)) return false;
+   for (nir_cf_node *tail = nir_cf_node_next(next); tail; tail = nir_cf_node_next(tail))
+      if (tail->type != nir_cf_node_block || !exec_list_is_empty(&nir_cf_node_as_block(tail)->instr_list)) return false;
+
+   struct bc250_loop_remat remat = {.available=_mesa_pointer_set_create(NULL)};
+   nir_def *entry_defs[128];
+   unsigned entry_count=0;
+   /* Cache before mutation: CF insertion invalidates dominance metadata. */
+   nir_foreach_instr(instr, before) {
+      nir_def *def = nir_instr_def(instr);
+      if (def) {
+         if (entry_count == ARRAY_SIZE(entry_defs)) { _mesa_set_destroy(remat.available,NULL); return false; }
+         entry_defs[entry_count++]=def;
+         _mesa_set_add(remat.available, def);
+      }
+   }
+   nir_def *loads[272];
+   unsigned found = 0;
+   bool legal = true;
+   nir_deref_instr *root = NULL;
+   enum gl_access_qualifier access = 0;
+   nir_foreach_block(block, impl) {
+      if (!bc250_loop_inside(&block->cf_node, outer)) continue;
+      nir_foreach_instr(instr, block) {
+         nir_def *def = nir_instr_def(instr);
+         if (def) nir_foreach_use_including_if(use, def) {
+            nir_cf_node *consumer = nir_src_is_if(use) ? &nir_src_use_if(use)->cf_node : &nir_src_use_instr(use)->block->cf_node;
+            if (!bc250_loop_inside(consumer, outer)) legal = false;
+         }
+         if (instr->type != nir_instr_type_alu || nir_instr_as_alu(instr)->op != nir_op_sdot_4x8_iadd) continue;
+         nir_alu_instr *dot = nir_instr_as_alu(instr);
+         nir_def *rhs = dot->src[1].src.ssa;
+         if (found == ARRAY_SIZE(loads) || dot->src[1].swizzle[0] || rhs->num_components != 1 ||
+             rhs->bit_size != 32 || nir_def_instr(rhs)->type != nir_instr_type_intrinsic) { legal=false; continue; }
+         nir_intrinsic_instr *load = nir_instr_as_intrinsic(nir_def_instr(rhs));
+         if (load->intrinsic != nir_intrinsic_load_deref) { legal=false; continue; }
+         enum gl_access_qualifier flags = nir_intrinsic_access(load);
+         nir_deref_instr *array = nir_src_as_deref(load->src[0]);
+         if ((flags & (ACCESS_NON_WRITEABLE|ACCESS_CAN_REORDER)) != (ACCESS_NON_WRITEABLE|ACCESS_CAN_REORDER) ||
+             (flags & ACCESS_VOLATILE) || array->deref_type != nir_deref_type_array ||
+             array->type != glsl_uint_type() || !nir_deref_mode_is(array, nir_var_mem_ssbo)) { legal=false; continue; }
+         nir_deref_instr *parent = nir_deref_instr_parent(array);
+         if (!root) { root=parent; access=flags; }
+         if (flags != access || !bc250_loop_root(parent) || !bc250_loop_pure(&parent->def, &remat)) legal=false;
+         for (unsigned i=0; i<found; i++) if (loads[i] == rhs) legal=false;
+         loads[found++] = rhs;
+      }
+   }
+   if (!legal || found != 272 || !root) {
+      
+      _mesa_set_destroy(remat.available,NULL); return false;
+   }
+   nir_validate_shader(nir, "before bc250 nested-loop clone");
+   const unsigned words=2240, start_word=113920/4;
+   unsigned old_bytes=nir->constant_data_size, base=ALIGN_POT(old_bytes,16);
+   nir->constant_data_size=base+4*words;
+   nir->constant_data=rerzalloc_size(nir,nir->constant_data,old_bytes,nir->constant_data_size);
+   memcpy((char *)nir->constant_data+base,bc250_loop_expected,4*words);
+   nir_builder b=nir_builder_at(nir_before_cf_node(&outer->cf_node));
+   nir_def *eligible=nir_iand(&b,nir_vote_any(&b,1,outer->condition.ssa),
+      nir_ieq_imm(&b,nir_channel(&b,nir_load_workgroup_id(&b),2),0));
+   nir_if *checking=nir_push_if(&b,eligible);
+   remat.b=&b; remat.map=_mesa_pointer_hash_table_create(NULL);
+   nir_deref_instr *guard_root=nir_instr_as_deref(nir_def_instr(bc250_loop_rematerialize(&root->def,&remat)));
+   _mesa_hash_table_destroy(remat.map,NULL);
+   nir_def *lane=nir_load_subgroup_invocation(&b), *different=nir_imm_int(&b,0);
+   for (unsigned round=0; round<8; round++) {
+      nir_def *relative=nir_iadd_imm(&b,nir_ishl_imm(&b,lane,2),round*256);
+      nir_def *proposed=nir_load_constant(&b,4,32,nir_ishl_imm(&b,relative,2),.base=base,.range=4*words,.align_mul=16,.align_offset=0);
+      for (unsigned j=0;j<4;j++) {
+         nir_deref_instr *ptr=nir_build_deref_array(&b,guard_root,nir_iadd_imm(&b,relative,start_word+j));
+         different=nir_ior(&b,different,nir_ixor(&b,nir_load_deref_with_access(&b,ptr,access),nir_channel(&b,proposed,j)));
+      }
+   }
+   for (unsigned round=0;round<3;round++) {
+      nir_def *relative=nir_iadd_imm(&b,lane,2048+round*64);
+      nir_def *proposed=nir_load_constant(&b,1,32,nir_ishl_imm(&b,relative,2),.base=base,.range=4*words,.align_mul=4,.align_offset=0);
+      nir_deref_instr *ptr=nir_build_deref_array(&b,guard_root,nir_iadd_imm(&b,relative,start_word));
+      different=nir_ior(&b,different,nir_ixor(&b,nir_load_deref_with_access(&b,ptr,access),proposed));
+   }
+   nir_def *all_equal=nir_vote_all(&b,1,nir_ieq_imm(&b,different,0));
+   nir_push_else(&b,checking);
+   nir_def *unavailable=nir_imm_false(&b);
+   nir_pop_if(&b,checking);
+   nir_def *verified=nir_if_phi(&b,all_equal,unavailable);
+
+   nir_cf_list original,clone;
+   b=nir_builder_at(nir_before_cf_list(&outer->then_list));
+   b.cursor=nir_cf_extract(&original,nir_before_cf_list(&outer->then_list),nir_after_cf_list(&outer->then_list));
+   nir_if *choice=nir_push_if(&b,verified);
+   struct hash_table *map=_mesa_pointer_hash_table_create(NULL);
+   unsigned z_substitutions=0;
+   for (unsigned e=0; e<entry_count; e++) {
+      nir_def *def=entry_defs[e];
+      nir_instr *instr=nir_def_instr(def);
+      nir_def *replace=NULL;
+      if (instr->type == nir_instr_type_intrinsic && nir_instr_as_intrinsic(instr)->intrinsic == nir_intrinsic_load_workgroup_id)
+         replace=nir_vec3(&b,nir_channel(&b,def,0),nir_channel(&b,def,1),nir_imm_int(&b,0));
+      else if (def->num_components == 1 && instr->type != nir_instr_type_load_const) {
+         uint32_t result;
+         if (bc250_coop_index_at_z0(nir_get_scalar(def,0),&result,0)) replace=nir_imm_int(&b,result);
+      }
+      if (replace) { _mesa_hash_table_insert(map,def,replace); z_substitutions++; }
+   }
+   _mesa_set_destroy(remat.available,NULL);
+   nir_cf_list_clone(&clone,&original,&nir_cursor_current_block(b.cursor)->cf_node,map);
+   nir_cf_reinsert(&clone,b.cursor);
+   b.cursor=nir_after_cf_list(&choice->then_list);
+   nir_push_else(&b,choice);
+   nir_cf_reinsert(&original,b.cursor);
+   b.cursor=nir_after_cf_list(&choice->else_list);
+   nir_pop_if(&b,choice);
+   for (unsigned i=0;i<found;i++) {
+      struct hash_entry *entry=_mesa_hash_table_search(map,loads[i]);
+      assert(entry);
+      nir_def *copy=entry->data;
+      nir_intrinsic_instr *load=nir_instr_as_intrinsic(nir_def_instr(copy));
+      nir_deref_instr *array=nir_src_as_deref(load->src[0]);
+      nir_builder at=nir_builder_at(nir_before_instr(&load->instr));
+      nir_def *offset=nir_ishl_imm(&at,nir_iadd_imm(&at,array->arr.index.ssa,-(int)start_word),2);
+      nir_def_replace(copy,nir_load_constant(&at,1,32,offset,.base=base,.range=4*words,.align_mul=4,.align_offset=0));
+   }
+   _mesa_hash_table_destroy(map,NULL);
+   nir_progress(true,impl,nir_metadata_none);
+   nir_opt_dce(nir);
+   nir_validate_shader(nir,"after bc250 nested-loop guard clone");
+   
+   return true;
+}
+
+static bool
+bc250_loop_cooperative_reduce(nir_shader *nir)
+{
+   struct bc250_fsr4_counts counts={0};
+   nir_shader_alu_pass(nir,bc250_fsr4_count,nir_metadata_all,&counts);
+   /* Coverage is a hard CPU qualification gate even in release builds. */
+   if (counts.dots != 2112+272 || counts.constant_dots != 2112) {
+      fprintf(stderr,"BC250_FSR4_LOOPCOOP invalid coverage dots=%u constants=%u\n",counts.dots,counts.constant_dots);
+      abort();
+   }
+   nir_function_impl *impl=nir_shader_get_entrypoint(nir);
+   unsigned pairs=0,covered=0;
+   while (true) {
+      nir_progress(true,impl,nir_metadata_control_flow);
+      nir_metadata_require(impl,nir_metadata_dominance|nir_metadata_instr_index);
+      if (!bc250_pair_dynamic_columns_once_baseline(nir,&covered)) break;
+      pairs++;
+   }
+   nir_progress(true,impl,nir_metadata_control_flow);
+   bc250_fsr4_grouped_dot(nir,true);
+   enum bc250_fsr4_dot_mode fixed=BC250_FSR4_FIXED;
+   nir_shader_alu_pass(nir,bc250_fsr4_dot,nir_metadata_control_flow,&fixed);
+   nir_opt_dce(nir);
+   struct bc250_fsr4_counts remaining={0};
+   nir_shader_alu_pass(nir,bc250_fsr4_count,nir_metadata_all,&remaining);
+   if (remaining.dots != 272 || remaining.constant_dots) abort();
+   nir_validate_shader(nir,"after bc250 nested-loop constant reduction");
+   
+   return true;
+}
+
+static bool
+bc250_e288_root(nir_deref_instr *root)
+{
+   if (!root || root->deref_type != nir_deref_type_struct || root->strct.index != 0 ||
+       !glsl_type_is_array(root->type) || glsl_get_array_element(root->type) != glsl_uint_type()) return false;
+   nir_deref_instr *cast = nir_deref_instr_parent(root);
+   if (!cast || cast->deref_type != nir_deref_type_cast ||
+       !nir_deref_mode_is(cast, nir_var_mem_ssbo) ||
+       glsl_get_struct_field_offset(cast->type, 0) != 0) return false;
+   nir_instr *instr = nir_def_instr(cast->parent.ssa);
+   if (instr->type != nir_instr_type_intrinsic) return false;
+   nir_intrinsic_instr *desc = nir_instr_as_intrinsic(instr);
+   if (desc->intrinsic != nir_intrinsic_load_vulkan_descriptor ||
+       nir_intrinsic_desc_type(desc) != nir_descriptor_type_storage_buffer) return false;
+   instr = nir_def_instr(desc->src[0].ssa);
+   if (instr->type != nir_instr_type_intrinsic) return false;
+   nir_intrinsic_instr *resource = nir_instr_as_intrinsic(instr);
+   if (resource->intrinsic != nir_intrinsic_vulkan_resource_index ||
+       nir_intrinsic_desc_set(resource) != 2 || nir_intrinsic_binding(resource) != 0 ||
+       nir_intrinsic_desc_type(resource) != nir_descriptor_type_storage_buffer) return false;
+   nir_scalar index = nir_scalar_chase_movs(nir_get_scalar(resource->src[0].ssa, 0));
+   if (!nir_scalar_is_alu(index) || nir_scalar_alu_op(index) != nir_op_iadd) return false;
+   nir_scalar a = nir_scalar_chase_movs(nir_scalar_chase_alu_src(index, 0));
+   nir_scalar b = nir_scalar_chase_movs(nir_scalar_chase_alu_src(index, 1));
+   if (nir_scalar_is_const(a)) { nir_scalar tmp=a; a=b; b=tmp; }
+   if (!nir_scalar_is_const(b) || nir_scalar_as_uint(b) != 18 || a.comp ||
+       a.def->num_components != 1 || a.def->bit_size != 32) return false;
+   instr = nir_def_instr(a.def);
+   if (instr->type != nir_instr_type_intrinsic) return false;
+   nir_intrinsic_instr *push = nir_instr_as_intrinsic(instr);
+   if (push->intrinsic != nir_intrinsic_load_deref) return false;
+   nir_deref_instr *field = nir_src_as_deref(push->src[0]);
+   if (field->deref_type != nir_deref_type_struct || field->strct.index != 1 ||
+       field->type != glsl_uint_type() || !nir_deref_mode_is(field, nir_var_mem_push_const)) return false;
+   nir_deref_instr *var = nir_deref_instr_parent(field);
+   return var && var->deref_type == nir_deref_type_var && glsl_get_struct_field_offset(var->type, 1) == 4;
+}
+
+static bool
+bc250_e288_group_eval(nir_scalar s, nir_def *phi, uint32_t iteration,
+                      uint32_t *result, unsigned depth)
+{
+   if (depth > 64 || (s.def->bit_size != 32 && s.def->bit_size != 1)) return false;
+   s = nir_scalar_chase_movs(s);
+   if (s.def == phi && s.comp == 0) { *result=iteration; return true; }
+   if (nir_scalar_is_const(s)) { *result=nir_scalar_as_uint(s); return true; }
+   nir_instr *instr=nir_def_instr(s.def);
+   if (instr->type == nir_instr_type_intrinsic) {
+      if (nir_instr_as_intrinsic(instr)->intrinsic != nir_intrinsic_load_workgroup_id || s.comp != 2) return false;
+      *result=0; return true;
+   }
+   if (!nir_scalar_is_alu(s)) return false;
+   nir_op op=nir_scalar_alu_op(s);
+   if (op != nir_op_iadd && op != nir_op_imul && op != nir_op_iand && op != nir_op_ior &&
+       op != nir_op_ishl && op != nir_op_ushr && op != nir_op_ubfe && op != nir_op_ieq) return false;
+   uint32_t a,b,c;
+   if (!bc250_e288_group_eval(nir_scalar_chase_alu_src(s,0),phi,iteration,&a,depth+1) ||
+       !bc250_e288_group_eval(nir_scalar_chase_alu_src(s,1),phi,iteration,&b,depth+1)) return false;
+   switch (op) {
+   case nir_op_iadd: *result=a+b; break;
+   case nir_op_imul: *result=a*b; break;
+   case nir_op_iand: *result=a&b; break;
+   case nir_op_ior: *result=a|b; break;
+   case nir_op_ishl: *result=a<<(b&31); break;
+   case nir_op_ushr: *result=a>>(b&31); break;
+   case nir_op_ieq: *result=a==b ? UINT32_MAX : 0; break;
+   case nir_op_ubfe:
+      if (!bc250_e288_group_eval(nir_scalar_chase_alu_src(s,2),phi,iteration,&c,depth+1) ||
+          b>31 || c>32 || b+c>32) return false;
+      *result=(a>>b)&(c==32 ? UINT32_MAX : (1u<<c)-1u); break;
+   default: UNREACHABLE("validated e288 index operation");
+   }
+   return true;
+}
+
+static bool
+bc250_e288_group_phi(nir_scalar s, nir_def **phi, unsigned depth)
+{
+   if (depth>64 || s.def->bit_size!=32) return false;
+   s=nir_scalar_chase_movs(s);
+   if (nir_scalar_is_const(s)) return true;
+   nir_instr *instr=nir_def_instr(s.def);
+   if (instr->type==nir_instr_type_phi) {
+      if (s.comp || (*phi && *phi!=s.def)) return false;
+      *phi=s.def;return true;
+   }
+   if (instr->type==nir_instr_type_intrinsic)
+      return nir_instr_as_intrinsic(instr)->intrinsic==nir_intrinsic_load_workgroup_id && s.comp==2;
+   if (!nir_scalar_is_alu(s)) return false;
+   nir_op op=nir_scalar_alu_op(s);
+   if (op!=nir_op_iadd && op!=nir_op_imul && op!=nir_op_iand && op!=nir_op_ior &&
+       op!=nir_op_ishl && op!=nir_op_ushr && op!=nir_op_ubfe) return false;
+   for (unsigned i=0;i<nir_op_infos[op].num_inputs;i++)
+      if (!bc250_e288_group_phi(nir_scalar_chase_alu_src(s,i),phi,depth+1)) return false;
+   return true;
+}
+
+static bool
+bc250_e288_group_trip(nir_def *def, unsigned *trip)
+{
+   if (!def || nir_def_instr(def)->type!=nir_instr_type_phi || def->bit_size!=32 || def->num_components!=1) return false;
+   nir_phi_instr *phi=nir_instr_as_phi(nir_def_instr(def));
+   nir_block *first=phi->instr.block;
+   if (first->cf_node.parent->type!=nir_cf_node_loop) return false;
+   nir_loop *loop=nir_cf_node_as_loop(first->cf_node.parent);
+   if (nir_loop_first_block(loop)!=first || nir_loop_has_continue_construct(loop)) return false;
+   nir_cf_node *middle=nir_cf_node_next(&first->cf_node);
+   if (!middle || middle->type!=nir_cf_node_if) return false;
+   nir_if *exit=nir_cf_node_as_if(middle);
+   nir_cf_node *last=nir_cf_node_next(middle);
+   if (!last || last->type!=nir_cf_node_block || nir_cf_node_next(last) ||
+       !exec_list_is_empty(&nir_cf_node_as_block(last)->instr_list)) return false;
+   if (!exec_list_is_singular(&exit->then_list) || !exec_list_is_singular(&exit->else_list) ||
+       !exec_list_is_empty(&nir_if_first_else_block(exit)->instr_list)) return false;
+   nir_block *then=nir_if_first_then_block(exit);
+   if (!exec_list_is_singular(&then->instr_list)) return false;
+   nir_instr *jump=nir_block_last_instr(then);
+   if (jump->type!=nir_instr_type_jump || nir_instr_as_jump(jump)->type!=nir_jump_break) return false;
+   nir_scalar condition=nir_scalar_chase_movs(nir_get_scalar(exit->condition.ssa,0));
+   if (!nir_scalar_is_alu(condition) || nir_scalar_alu_op(condition)!=nir_op_ieq) return false;
+   unsigned initial=0,increment=0;
+   nir_foreach_phi_src(src,phi) {
+      if (src->pred==nir_cf_node_as_block(last)) {
+         nir_scalar add=nir_scalar_chase_movs(nir_get_scalar(src->src.ssa,0));
+         if (!nir_scalar_is_alu(add) || nir_scalar_alu_op(add)!=nir_op_iadd) return false;
+         nir_scalar a=nir_scalar_chase_movs(nir_scalar_chase_alu_src(add,0));
+         nir_scalar b=nir_scalar_chase_movs(nir_scalar_chase_alu_src(add,1));
+         if (nir_scalar_is_const(a)) { nir_scalar temp=a;a=b;b=temp; }
+         if (a.def!=def || a.comp || !nir_scalar_is_const(b) || nir_scalar_as_uint(b)!=1) return false;
+         increment++;
+      } else {
+         if (!nir_src_is_const(src->src) || nir_src_as_uint(src->src)!=0) return false;
+         initial++;
+      }
+   }
+   if (initial!=1 || increment!=1) return false;
+   for (unsigned i=0;i<64;i++) {
+      uint32_t stops;
+      if (!bc250_e288_group_eval(condition,def,i,&stops,0)) return false;
+      if (stops) { *trip=i+1;return *trip==8 || *trip==16 || *trip==32; }
+   }
+   return false;
+}
+
+static bool
+bc250_e288_plan_groups(nir_def *dots[336], nir_def *loads[336], unsigned maximum,
+                       struct bc250_e288_groups *plan)
+{
+   if (maximum!=4 && maximum!=16) return false;
+   memset(plan,0,sizeof(*plan));
+   int parent[336],child[336];unsigned trips[336];nir_def *phis[336];
+   int8_t (*coefficients)[32][4]=calloc(336,sizeof(*coefficients));
+   if (!coefficients) return false;
+   bool valid=false;
+   for (unsigned i=0;i<336;i++) { parent[i]=child[i]=-1;plan->previous[i]=-1;plan->first[i]=-1; }
+   for (unsigned i=0;i<336;i++) {
+      nir_alu_instr *dot=nir_instr_as_alu(nir_def_instr(dots[i]));
+      for (unsigned s=0;s<3;s++)
+         if (dot->src[s].swizzle[0] || dot->src[s].src.ssa->num_components!=1 || dot->src[s].src.ssa->bit_size!=32) goto done;
+      for (unsigned j=0;j<336;j++) if (dot->src[2].src.ssa==dots[j]) {
+         if (j>=i || child[j]!=-1 || nir_def_instr(dots[j])->block!=dot->instr.block) goto done;
+         unsigned uses=0;
+         nir_foreach_use_including_if(use,dots[j]) {
+            if (nir_src_is_if(use) || nir_src_use_instr(use)!=&dot->instr) goto done;
+            uses++;
+         }
+         if (uses!=1) goto done;
+         parent[i]=j;child[j]=i;
+      }
+      nir_intrinsic_instr *load=nir_instr_as_intrinsic(nir_def_instr(loads[i]));
+      nir_deref_instr *array=nir_src_as_deref(load->src[0]);
+      nir_scalar index=nir_get_scalar(array->arr.index.ssa,0);phis[i]=NULL;
+      if (!bc250_e288_group_phi(index,&phis[i],0) || !bc250_e288_group_trip(phis[i],&trips[i]) ||
+          nir_def_instr(phis[i])->block!=dot->instr.block) goto done;
+      for (unsigned iteration=0;iteration<trips[i];iteration++) {
+         uint32_t word;
+         if (!bc250_e288_group_eval(index,phis[i],iteration,&word,0) || word<33024/4 || word>=54656/4) goto done;
+         uint32_t packed=bc250_e288_expected[word-33024/4];
+         for (unsigned channel=0;channel<4;channel++) {
+            int value=(packed>>(8*channel))&255;
+            if (value>=128) value-=256;
+            coefficients[i][iteration][channel]=value;
+         }
+      }
+   }
+   unsigned roots=0,covered=0;
+   for (unsigned root=0;root<336;root++) if (parent[root]==-1) {
+      roots++;
+      int current=root;
+      while (current!=-1) {
+         int start=current,previous=-1;unsigned length=0;
+         int32_t bounds[32][2][2]={0};
+         while (current!=-1 && length<maximum) {
+            if (phis[current]!=phis[start] || trips[current]!=trips[start]) goto done;
+            int32_t proposed[32][2][2];memcpy(proposed,bounds,sizeof(bounds));bool fits=true;
+            for (unsigned iteration=0;iteration<trips[current];iteration++) for (unsigned pair=0;pair<2;pair++) {
+               for (unsigned channel=2*pair;channel<2*pair+2;channel++) {
+                  int32_t value=coefficients[current][iteration][channel];
+                  int32_t a=-128*value,b=127*value;
+                  proposed[iteration][pair][0]+=MIN2(a,b);proposed[iteration][pair][1]+=MAX2(a,b);
+               }
+               fits &= proposed[iteration][pair][0]>=-32768 && proposed[iteration][pair][1]<=32767;
+            }
+            if (!fits) break;
+            memcpy(bounds,proposed,sizeof(bounds));
+            plan->first[current]=start;plan->previous[current]=previous;
+            previous=current;current=child[current];length++;covered++;
+         }
+         if (!length) goto done;
+         plan->tail[previous]=true;plan->count++;
+      }
+   }
+   if (roots!=12 || covered!=336 || plan->count!=(maximum==4 ? 97u : 76u)) goto done;
+   for (unsigned i=0;i<336;i++) if (plan->first[i]<0) goto done;
+   valid=true;
+done:
+   free(coefficients);
+   
+   return valid;
+}
+
+static bool
+bc250_e288_group_clone(nir_shader *nir, unsigned profile)
+{
+   const unsigned maximum=16;
+   const bool prepacked=true;
+   if (!(profile & 65536)) return false;
+   if (nir->info.stage != MESA_SHADER_COMPUTE || nir->info.api_subgroup_size != 64 ||
+       nir->info.min_subgroup_size != 32 || nir->info.max_subgroup_size != 32 ||
+       nir->info.uses_wide_subgroup_intrinsics || nir->info.workgroup_size_variable ||
+       nir->info.workgroup_size[0] != 64 || nir->info.workgroup_size[1] != 1 || nir->info.workgroup_size[2] != 1) return false;
+   struct bc250_fsr4_counts counts = {0};
+   nir_shader_alu_pass(nir, bc250_fsr4_count, nir_metadata_all, &counts);
+   if (counts.dots != 336 || counts.constant_dots) return false;
+   nir_function_impl *impl = nir_shader_get_entrypoint(nir);
+   nir_block *before = nir_start_block(impl);
+   nir_cf_node *next = nir_cf_node_next(&before->cf_node);
+   if (!next || next->type != nir_cf_node_if) return false;
+   nir_if *outer = nir_cf_node_as_if(next);
+   if (outer->cf_node.parent->type != nir_cf_node_function ||
+       !exec_list_is_singular(&outer->else_list) ||
+       !exec_list_is_empty(&nir_if_first_else_block(outer)->instr_list)) return false;
+   for (nir_cf_node *tail = nir_cf_node_next(next); tail; tail = nir_cf_node_next(tail))
+      if (tail->type != nir_cf_node_block || !exec_list_is_empty(&nir_cf_node_as_block(tail)->instr_list)) return false;
+
+   struct bc250_loop_remat remat = {.available=_mesa_pointer_set_create(NULL)};
+   unsigned entry_count=0;
+   /* Cache before mutation: CF insertion invalidates dominance metadata. */
+   nir_foreach_instr(instr, before) {
+      nir_def *def = nir_instr_def(instr);
+      if (def) {
+         if (entry_count == 128) { _mesa_set_destroy(remat.available,NULL); return false; }
+         entry_count++;
+         _mesa_set_add(remat.available, def);
+      }
+   }
+   nir_def *loads[336], *dots[336];
+   unsigned found = 0;
+   bool legal = true;
+   nir_deref_instr *root = NULL;
+   enum gl_access_qualifier access = 0;
+   nir_foreach_block(block, impl) {
+      if (!bc250_loop_inside(&block->cf_node, outer)) continue;
+      nir_foreach_instr(instr, block) {
+         nir_def *def = nir_instr_def(instr);
+         if (def) nir_foreach_use_including_if(use, def) {
+            nir_cf_node *consumer = nir_src_is_if(use) ? &nir_src_use_if(use)->cf_node : &nir_src_use_instr(use)->block->cf_node;
+            if (!bc250_loop_inside(consumer, outer)) legal = false;
+         }
+         if (instr->type != nir_instr_type_alu || nir_instr_as_alu(instr)->op != nir_op_sdot_4x8_iadd) continue;
+         nir_alu_instr *dot = nir_instr_as_alu(instr);
+         nir_def *rhs = dot->src[1].src.ssa;
+         if (found == ARRAY_SIZE(loads) || dot->src[1].swizzle[0] || rhs->num_components != 1 ||
+             rhs->bit_size != 32 || nir_def_instr(rhs)->type != nir_instr_type_intrinsic) { legal=false; continue; }
+         nir_intrinsic_instr *load = nir_instr_as_intrinsic(nir_def_instr(rhs));
+         if (load->intrinsic != nir_intrinsic_load_deref) { legal=false; continue; }
+         enum gl_access_qualifier flags = nir_intrinsic_access(load);
+         nir_deref_instr *array = nir_src_as_deref(load->src[0]);
+         if ((flags & (ACCESS_NON_WRITEABLE|ACCESS_CAN_REORDER)) != (ACCESS_NON_WRITEABLE|ACCESS_CAN_REORDER) ||
+             (flags & ACCESS_VOLATILE) || array->deref_type != nir_deref_type_array ||
+             array->type != glsl_uint_type() || !nir_deref_mode_is(array, nir_var_mem_ssbo)) { legal=false; continue; }
+         nir_deref_instr *parent = nir_deref_instr_parent(array);
+         if (!root) { root=parent; access=flags; }
+         if (flags != access || !bc250_e288_root(parent) || !bc250_loop_pure(&parent->def, &remat)) legal=false;
+         for (unsigned i=0; i<found; i++) if (loads[i] == rhs) legal=false;
+         dots[found] = &dot->def;
+         loads[found++] = rhs;
+      }
+   }
+   if (!legal || found != 336 || !root) {
+      
+      _mesa_set_destroy(remat.available,NULL); return false;
+   }
+   struct bc250_e288_groups groups;
+   if (!bc250_e288_plan_groups(dots,loads,maximum,&groups)) {
+      _mesa_set_destroy(remat.available,NULL); return false;
+   }
+   nir_validate_shader(nir, "before bc250 grouped compact loop clone");
+   const unsigned words=5408, start_word=33024/4;
+   unsigned old_bytes=nir->constant_data_size, base=ALIGN_POT(old_bytes,16);
+   unsigned packed_base=ALIGN_POT(base+4*words,16);
+   nir->constant_data_size=prepacked ? packed_base+8*words : base+4*words;
+   nir->constant_data=rerzalloc_size(nir,nir->constant_data,old_bytes,nir->constant_data_size);
+   memcpy((char *)nir->constant_data+base,bc250_e288_expected,4*words);
+   if (prepacked)
+      memcpy((char *)nir->constant_data+packed_base,bc250_e288_prepacked,8*words);
+   nir_builder b=nir_builder_at(nir_before_cf_node(&outer->cf_node));
+   nir_def *eligible=nir_iand(&b,nir_vote_any(&b,1,outer->condition.ssa),
+      nir_ieq_imm(&b,nir_channel(&b,nir_load_workgroup_id(&b),2),0));
+   nir_if *checking=nir_push_if(&b,eligible);
+   remat.b=&b; remat.map=_mesa_pointer_hash_table_create(NULL);
+   nir_deref_instr *guard_root=nir_instr_as_deref(nir_def_instr(bc250_loop_rematerialize(&root->def,&remat)));
+   _mesa_hash_table_destroy(remat.map,NULL);
+   /* The selected physical size is 32; do not load the API subgroup lane. */
+   nir_def *lane=nir_mbcnt_amd(&b,nir_imm_int(&b,-1),nir_imm_int(&b,0));
+   nir_def *different=nir_imm_int(&b,0);
+   for (unsigned round=0; round<42; round++) {
+      nir_def *relative=nir_iadd_imm(&b,nir_ishl_imm(&b,lane,2),round*128);
+      nir_def *proposed=nir_load_constant(&b,4,32,nir_ishl_imm(&b,relative,2),.base=base,.range=4*words,.align_mul=16,.align_offset=0);
+      for (unsigned j=0;j<4;j++) {
+         nir_deref_instr *ptr=nir_build_deref_array(&b,guard_root,nir_iadd_imm(&b,relative,start_word+j));
+         different=nir_ior(&b,different,nir_ixor(&b,nir_load_deref_with_access(&b,ptr,access),nir_channel(&b,proposed,j)));
+      }
+   }
+   for (unsigned round=0;round<1;round++) {
+      nir_def *relative=nir_iadd_imm(&b,lane,5376+round*32);
+      nir_def *proposed=nir_load_constant(&b,1,32,nir_ishl_imm(&b,relative,2),.base=base,.range=4*words,.align_mul=4,.align_offset=0);
+      nir_deref_instr *ptr=nir_build_deref_array(&b,guard_root,nir_iadd_imm(&b,relative,start_word));
+      different=nir_ior(&b,different,nir_ixor(&b,nir_load_deref_with_access(&b,ptr,access),proposed));
+   }
+   nir_def *all_equal=nir_vote_all(&b,1,nir_ieq_imm(&b,different,0));
+   nir_push_else(&b,checking);
+   nir_def *unavailable=nir_imm_false(&b);
+   nir_pop_if(&b,checking);
+   nir_def *verified=nir_if_phi(&b,all_equal,unavailable);
+
+   nir_cf_list original,clone;
+   b=nir_builder_at(nir_before_cf_list(&outer->then_list));
+   b.cursor=nir_cf_extract(&original,nir_before_cf_list(&outer->then_list),nir_after_cf_list(&outer->then_list));
+   nir_if *choice=nir_push_if(&b,verified);
+   struct hash_table *map=_mesa_pointer_hash_table_create(NULL);
+   /* Keep all loop limits and workgroup expressions dynamic. Only cloned
+    * dot coefficients use the pre-expanded table; the complete value guard
+    * and Z=0 gate establish the original address union and exact values. */
+   _mesa_set_destroy(remat.available,NULL);
+   nir_cf_list_clone(&clone,&original,&nir_cursor_current_block(b.cursor)->cf_node,map);
+   nir_cf_reinsert(&clone,b.cursor);
+   b.cursor=nir_after_cf_list(&choice->then_list);
+   nir_push_else(&b,choice);
+   nir_cf_reinsert(&original,b.cursor);
+   b.cursor=nir_after_cf_list(&choice->else_list);
+   nir_pop_if(&b,choice);
+   unsigned replaced=0,flushed=0;
+   nir_def *partials[336]={0}, *bases[336]={0};
+   for (unsigned i=0;i<found;i++) {
+      struct hash_entry *entry=_mesa_hash_table_search(map,dots[i]);
+      if (!entry) abort();
+      nir_def *copy=entry->data;
+      nir_alu_instr *dot=nir_instr_as_alu(nir_def_instr(copy));
+      if (dot->op != nir_op_sdot_4x8_iadd || dot->def.num_components != 1 || dot->def.bit_size != 32) abort();
+      nir_builder at=nir_builder_at(nir_before_instr(&dot->instr));
+      nir_def *a=nir_ssa_for_alu_src(&at,dot,0);
+      nir_def *c=nir_ssa_for_alu_src(&at,dot,2);
+      if (groups.first[i]==(int)i) bases[i]=c;
+      nir_def *ae,*ao,*we,*wo;
+      bc250_fsr4_unpack_pairs(&at,a,&ae,&ao);
+      if (prepacked) {
+         struct hash_entry *weight_entry=_mesa_hash_table_search(map,loads[i]);
+         if (!weight_entry) abort();
+         nir_def *weight_copy=weight_entry->data;
+         nir_intrinsic_instr *weight=nir_instr_as_intrinsic(nir_def_instr(weight_copy));
+         if (weight->intrinsic != nir_intrinsic_load_deref) abort();
+         nir_deref_instr *array=nir_src_as_deref(weight->src[0]);
+         if (array->deref_type != nir_deref_type_array) abort();
+         /* Use the cloned index; never keep an old branch's SSA definition. */
+         nir_def *offset=nir_ishl_imm(&at,nir_iadd_imm(&at,array->arr.index.ssa,-(int)start_word),3);
+         nir_def *packed=nir_load_constant(&at,2,32,offset,
+            .base=packed_base,.range=8*words,.align_mul=8,.align_offset=0);
+         we=nir_unpack_32_2x16(&at,nir_channel(&at,packed,0));
+         wo=nir_unpack_32_2x16(&at,nir_channel(&at,packed,1));
+      } else {
+         nir_def *w=nir_ssa_for_alu_src(&at,dot,1);
+         bc250_fsr4_unpack_pairs(&at,w,&we,&wo);
+      }
+      /* Each prefix was bounded for every actual loop coefficient assignment.
+       * Keep intermediate dot nodes until their sole tail consumer is replaced;
+       * DCE then removes them without ever changing a 32-bit use to a 16-bit type. */
+      nir_def *pair=nir_iadd(&at,nir_imul(&at,ae,we),nir_imul(&at,ao,wo));
+      if (groups.previous[i]>=0) {
+         nir_def *previous=partials[groups.previous[i]];
+         if (!previous) abort();
+         pair=nir_iadd(&at,previous,pair);
+      }
+      partials[i]=pair;
+      if (groups.tail[i]) {
+         nir_def *base_value=bases[groups.first[i]];
+         if (!base_value) abort();
+         nir_def *wide=nir_i2i32(&at,pair);
+         nir_def_replace(copy,nir_iadd(&at,base_value,nir_iadd(&at,nir_channel(&at,wide,0),nir_channel(&at,wide,1))));
+         flushed++;
+      }
+      replaced++;
+   }
+   _mesa_hash_table_destroy(map,NULL);
+   nir_progress(true,impl,nir_metadata_none);
+   nir_opt_dce(nir);
+   struct bc250_fsr4_counts remaining={0};
+   nir_shader_alu_pass(nir,bc250_fsr4_count,nir_metadata_all,&remaining);
+   if (replaced != 336 || flushed != groups.count || remaining.dots != 336 || remaining.constant_dots) abort();
+   nir_validate_shader(nir,"after bc250 e288 grouped compact loop clone");
+   
+   return true;
+}
+
+static bool
+bc250_neighbor_root(nir_deref_instr *root)
+{
+   if (!root || root->deref_type != nir_deref_type_struct || root->strct.index != 0 ||
+       !glsl_type_is_array(root->type) || glsl_get_array_element(root->type) != glsl_uint_type()) return false;
+   nir_deref_instr *cast = nir_deref_instr_parent(root);
+   if (!cast || cast->deref_type != nir_deref_type_cast ||
+       !nir_deref_mode_is(cast, nir_var_mem_ssbo) ||
+       glsl_get_struct_field_offset(cast->type, 0) != 0) return false;
+   nir_instr *instr = nir_def_instr(cast->parent.ssa);
+   if (instr->type != nir_instr_type_intrinsic) return false;
+   nir_intrinsic_instr *desc = nir_instr_as_intrinsic(instr);
+   if (desc->intrinsic != nir_intrinsic_load_vulkan_descriptor ||
+       nir_intrinsic_desc_type(desc) != nir_descriptor_type_storage_buffer) return false;
+   instr = nir_def_instr(desc->src[0].ssa);
+   if (instr->type != nir_instr_type_intrinsic) return false;
+   nir_intrinsic_instr *resource = nir_instr_as_intrinsic(instr);
+   if (resource->intrinsic != nir_intrinsic_vulkan_resource_index ||
+       nir_intrinsic_desc_set(resource) != 2 || nir_intrinsic_binding(resource) != 0 ||
+       nir_intrinsic_desc_type(resource) != nir_descriptor_type_storage_buffer) return false;
+   nir_scalar index = nir_scalar_chase_movs(nir_get_scalar(resource->src[0].ssa, 0));
+   if (!nir_scalar_is_alu(index) || nir_scalar_alu_op(index) != nir_op_iadd) return false;
+   nir_scalar a = nir_scalar_chase_movs(nir_scalar_chase_alu_src(index, 0));
+   nir_scalar b = nir_scalar_chase_movs(nir_scalar_chase_alu_src(index, 1));
+   if (nir_scalar_is_const(a)) { nir_scalar tmp=a; a=b; b=tmp; }
+   if (!nir_scalar_is_const(b) || nir_scalar_as_uint(b) != 18 || a.comp ||
+       a.def->num_components != 1 || a.def->bit_size != 32) return false;
+   instr = nir_def_instr(a.def);
+   if (instr->type != nir_instr_type_intrinsic) return false;
+   nir_intrinsic_instr *push = nir_instr_as_intrinsic(instr);
+   if (push->intrinsic != nir_intrinsic_load_deref) return false;
+   nir_deref_instr *field = nir_src_as_deref(push->src[0]);
+   if (field->deref_type != nir_deref_type_struct || field->strct.index != 1 ||
+       field->type != glsl_uint_type() || !nir_deref_mode_is(field, nir_var_mem_push_const)) return false;
+   nir_deref_instr *var = nir_deref_instr_parent(field);
+   return var && var->deref_type == nir_deref_type_var && glsl_get_struct_field_offset(var->type, 1) == 4;
+}
+
+static bool
+bc250_neighbor_group_eval(nir_scalar s, nir_def *phi, uint32_t iteration,
+                      uint32_t *result, unsigned depth)
+{
+   if (depth > 64 || (s.def->bit_size != 32 && s.def->bit_size != 1)) return false;
+   s = nir_scalar_chase_movs(s);
+   if (s.def == phi && s.comp == 0) { *result=iteration; return true; }
+   if (nir_scalar_is_const(s)) { *result=nir_scalar_as_uint(s); return true; }
+   nir_instr *instr=nir_def_instr(s.def);
+   if (instr->type == nir_instr_type_intrinsic) {
+      if (nir_instr_as_intrinsic(instr)->intrinsic != nir_intrinsic_load_workgroup_id || s.comp != 2) return false;
+      *result=0; return true;
+   }
+   if (!nir_scalar_is_alu(s)) return false;
+   nir_op op=nir_scalar_alu_op(s);
+   if (op != nir_op_iadd && op != nir_op_imul && op != nir_op_iand && op != nir_op_ior &&
+       op != nir_op_ishl && op != nir_op_ushr && op != nir_op_ubfe && op != nir_op_ieq) return false;
+   uint32_t a,b,c;
+   if (!bc250_neighbor_group_eval(nir_scalar_chase_alu_src(s,0),phi,iteration,&a,depth+1) ||
+       !bc250_neighbor_group_eval(nir_scalar_chase_alu_src(s,1),phi,iteration,&b,depth+1)) return false;
+   switch (op) {
+   case nir_op_iadd: *result=a+b; break;
+   case nir_op_imul: *result=a*b; break;
+   case nir_op_iand: *result=a&b; break;
+   case nir_op_ior: *result=a|b; break;
+   case nir_op_ishl: *result=a<<(b&31); break;
+   case nir_op_ushr: *result=a>>(b&31); break;
+   case nir_op_ieq: *result=a==b ? UINT32_MAX : 0; break;
+   case nir_op_ubfe:
+      if (!bc250_neighbor_group_eval(nir_scalar_chase_alu_src(s,2),phi,iteration,&c,depth+1) ||
+          b>31 || c>32 || b+c>32) return false;
+      *result=(a>>b)&(c==32 ? UINT32_MAX : (1u<<c)-1u); break;
+   default: UNREACHABLE("validated 28d8 index operation");
+   }
+   return true;
+}
+
+static bool
+bc250_neighbor_group_phi(nir_scalar s, nir_def **phi, unsigned depth)
+{
+   if (depth>64 || s.def->bit_size!=32) return false;
+   s=nir_scalar_chase_movs(s);
+   if (nir_scalar_is_const(s)) return true;
+   nir_instr *instr=nir_def_instr(s.def);
+   if (instr->type==nir_instr_type_phi) {
+      if (s.comp || (*phi && *phi!=s.def)) return false;
+      *phi=s.def;return true;
+   }
+   if (instr->type==nir_instr_type_intrinsic)
+      return nir_instr_as_intrinsic(instr)->intrinsic==nir_intrinsic_load_workgroup_id && s.comp==2;
+   if (!nir_scalar_is_alu(s)) return false;
+   nir_op op=nir_scalar_alu_op(s);
+   if (op!=nir_op_iadd && op!=nir_op_imul && op!=nir_op_iand && op!=nir_op_ior &&
+       op!=nir_op_ishl && op!=nir_op_ushr && op!=nir_op_ubfe) return false;
+   for (unsigned i=0;i<nir_op_infos[op].num_inputs;i++)
+      if (!bc250_neighbor_group_phi(nir_scalar_chase_alu_src(s,i),phi,depth+1)) return false;
+   return true;
+}
+
+static bool
+bc250_neighbor_group_trip(nir_def *def, unsigned *trip)
+{
+   if (!def || nir_def_instr(def)->type!=nir_instr_type_phi || def->bit_size!=32 || def->num_components!=1) return false;
+   nir_phi_instr *phi=nir_instr_as_phi(nir_def_instr(def));
+   nir_block *first=phi->instr.block;
+   if (first->cf_node.parent->type!=nir_cf_node_loop) return false;
+   nir_loop *loop=nir_cf_node_as_loop(first->cf_node.parent);
+   if (nir_loop_first_block(loop)!=first || nir_loop_has_continue_construct(loop)) return false;
+   nir_cf_node *middle=nir_cf_node_next(&first->cf_node);
+   if (!middle || middle->type!=nir_cf_node_if) return false;
+   nir_if *exit=nir_cf_node_as_if(middle);
+   nir_cf_node *last=nir_cf_node_next(middle);
+   if (!last || last->type!=nir_cf_node_block || nir_cf_node_next(last) ||
+       !exec_list_is_empty(&nir_cf_node_as_block(last)->instr_list)) return false;
+   if (!exec_list_is_singular(&exit->then_list) || !exec_list_is_singular(&exit->else_list) ||
+       !exec_list_is_empty(&nir_if_first_else_block(exit)->instr_list)) return false;
+   nir_block *then=nir_if_first_then_block(exit);
+   if (!exec_list_is_singular(&then->instr_list)) return false;
+   nir_instr *jump=nir_block_last_instr(then);
+   if (jump->type!=nir_instr_type_jump || nir_instr_as_jump(jump)->type!=nir_jump_break) return false;
+   nir_scalar condition=nir_scalar_chase_movs(nir_get_scalar(exit->condition.ssa,0));
+   if (!nir_scalar_is_alu(condition) || nir_scalar_alu_op(condition)!=nir_op_ieq) return false;
+   unsigned initial=0,increment=0;
+   nir_foreach_phi_src(src,phi) {
+      if (src->pred==nir_cf_node_as_block(last)) {
+         nir_scalar add=nir_scalar_chase_movs(nir_get_scalar(src->src.ssa,0));
+         if (!nir_scalar_is_alu(add) || nir_scalar_alu_op(add)!=nir_op_iadd) return false;
+         nir_scalar a=nir_scalar_chase_movs(nir_scalar_chase_alu_src(add,0));
+         nir_scalar b=nir_scalar_chase_movs(nir_scalar_chase_alu_src(add,1));
+         if (nir_scalar_is_const(a)) { nir_scalar temp=a;a=b;b=temp; }
+         if (a.def!=def || a.comp || !nir_scalar_is_const(b) || nir_scalar_as_uint(b)!=1) return false;
+         increment++;
+      } else {
+         if (!nir_src_is_const(src->src) || nir_src_as_uint(src->src)!=0) return false;
+         initial++;
+      }
+   }
+   if (initial!=1 || increment!=1) return false;
+   for (unsigned i=0;i<64;i++) {
+      uint32_t stops;
+      if (!bc250_neighbor_group_eval(condition,def,i,&stops,0)) return false;
+      if (stops) { *trip=i+1;return *trip==8 || *trip==16 || *trip==32; }
+   }
+   return false;
+}
+
+static bool
+bc250_neighbor_plan_groups(nir_def *dots[336], nir_def *loads[336], unsigned maximum,
+                       struct bc250_neighbor_groups *plan)
+{
+   if (maximum!=4 && maximum!=16) return false;
+   memset(plan,0,sizeof(*plan));
+   int parent[336],child[336];unsigned trips[336];nir_def *phis[336];
+   int8_t (*coefficients)[32][4]=calloc(336,sizeof(*coefficients));
+   if (!coefficients) return false;
+   bool valid=false;
+   for (unsigned i=0;i<336;i++) { parent[i]=child[i]=-1;plan->previous[i]=-1;plan->first[i]=-1; }
+   for (unsigned i=0;i<336;i++) {
+      nir_alu_instr *dot=nir_instr_as_alu(nir_def_instr(dots[i]));
+      for (unsigned s=0;s<3;s++)
+         if (dot->src[s].swizzle[0] || dot->src[s].src.ssa->num_components!=1 || dot->src[s].src.ssa->bit_size!=32) goto done;
+      for (unsigned j=0;j<336;j++) if (dot->src[2].src.ssa==dots[j]) {
+         if (j>=i || child[j]!=-1 || nir_def_instr(dots[j])->block!=dot->instr.block) goto done;
+         unsigned uses=0;
+         nir_foreach_use_including_if(use,dots[j]) {
+            if (nir_src_is_if(use) || nir_src_use_instr(use)!=&dot->instr) goto done;
+            uses++;
+         }
+         if (uses!=1) goto done;
+         parent[i]=j;child[j]=i;
+      }
+      nir_intrinsic_instr *load=nir_instr_as_intrinsic(nir_def_instr(loads[i]));
+      nir_deref_instr *array=nir_src_as_deref(load->src[0]);
+      nir_scalar index=nir_get_scalar(array->arr.index.ssa,0);phis[i]=NULL;
+      if (!bc250_neighbor_group_phi(index,&phis[i],0) || !bc250_neighbor_group_trip(phis[i],&trips[i]) ||
+          nir_def_instr(phis[i])->block!=dot->instr.block) goto done;
+      for (unsigned iteration=0;iteration<trips[i];iteration++) {
+         uint32_t word;
+         if (!bc250_neighbor_group_eval(index,phis[i],iteration,&word,0) || word<54912/4 || word>=76544/4) goto done;
+         uint32_t packed=bc250_neighbor_expected[word-54912/4];
+         for (unsigned channel=0;channel<4;channel++) {
+            int value=(packed>>(8*channel))&255;
+            if (value>=128) value-=256;
+            coefficients[i][iteration][channel]=value;
+         }
+      }
+   }
+   unsigned roots=0,covered=0;
+   for (unsigned root=0;root<336;root++) if (parent[root]==-1) {
+      roots++;
+      int current=root;
+      while (current!=-1) {
+         int start=current,previous=-1;unsigned length=0;
+         int32_t bounds[32][2][2]={0};
+         while (current!=-1 && length<maximum) {
+            if (phis[current]!=phis[start] || trips[current]!=trips[start]) goto done;
+            int32_t proposed[32][2][2];memcpy(proposed,bounds,sizeof(bounds));bool fits=true;
+            for (unsigned iteration=0;iteration<trips[current];iteration++) for (unsigned pair=0;pair<2;pair++) {
+               for (unsigned channel=2*pair;channel<2*pair+2;channel++) {
+                  int32_t value=coefficients[current][iteration][channel];
+                  int32_t a=-128*value,b=127*value;
+                  proposed[iteration][pair][0]+=MIN2(a,b);proposed[iteration][pair][1]+=MAX2(a,b);
+               }
+               fits &= proposed[iteration][pair][0]>=-32768 && proposed[iteration][pair][1]<=32767;
+            }
+            if (!fits) break;
+            memcpy(bounds,proposed,sizeof(bounds));
+            plan->first[current]=start;plan->previous[current]=previous;
+            previous=current;current=child[current];length++;covered++;
+         }
+         if (!length) goto done;
+         plan->tail[previous]=true;plan->count++;
+      }
+   }
+   if (roots!=12 || covered!=336 || plan->count!=(maximum==4 ? 101u : 92u)) goto done;
+   for (unsigned i=0;i<336;i++) if (plan->first[i]<0) goto done;
+   valid=true;
+done:
+   free(coefficients);
+   
+   return valid;
+}
+
+static bool
+bc250_neighbor_group_clone(nir_shader *nir, unsigned profile)
+{
+   const unsigned maximum=16;
+   const bool prepacked=true;
+   if (!(profile & 131072)) return false;
+   if (nir->info.stage != MESA_SHADER_COMPUTE || nir->info.api_subgroup_size != 64 ||
+       nir->info.min_subgroup_size != 32 || nir->info.max_subgroup_size != 32 ||
+       nir->info.uses_wide_subgroup_intrinsics || nir->info.workgroup_size_variable ||
+       nir->info.workgroup_size[0] != 64 || nir->info.workgroup_size[1] != 1 || nir->info.workgroup_size[2] != 1) return false;
+   struct bc250_fsr4_counts counts = {0};
+   nir_shader_alu_pass(nir, bc250_fsr4_count, nir_metadata_all, &counts);
+   if (counts.dots != 336 || counts.constant_dots) return false;
+   nir_function_impl *impl = nir_shader_get_entrypoint(nir);
+   nir_block *before = nir_start_block(impl);
+   nir_cf_node *next = nir_cf_node_next(&before->cf_node);
+   if (!next || next->type != nir_cf_node_if) return false;
+   nir_if *outer = nir_cf_node_as_if(next);
+   if (outer->cf_node.parent->type != nir_cf_node_function ||
+       !exec_list_is_singular(&outer->else_list) ||
+       !exec_list_is_empty(&nir_if_first_else_block(outer)->instr_list)) return false;
+   for (nir_cf_node *tail = nir_cf_node_next(next); tail; tail = nir_cf_node_next(tail))
+      if (tail->type != nir_cf_node_block || !exec_list_is_empty(&nir_cf_node_as_block(tail)->instr_list)) return false;
+
+   struct bc250_loop_remat remat = {.available=_mesa_pointer_set_create(NULL)};
+   unsigned entry_count=0;
+   /* Cache before mutation: CF insertion invalidates dominance metadata. */
+   nir_foreach_instr(instr, before) {
+      nir_def *def = nir_instr_def(instr);
+      if (def) {
+         if (entry_count == 128) { _mesa_set_destroy(remat.available,NULL); return false; }
+         entry_count++;
+         _mesa_set_add(remat.available, def);
+      }
+   }
+   nir_def *loads[336], *dots[336];
+   unsigned found = 0;
+   bool legal = true;
+   nir_deref_instr *root = NULL;
+   enum gl_access_qualifier access = 0;
+   nir_foreach_block(block, impl) {
+      if (!bc250_loop_inside(&block->cf_node, outer)) continue;
+      nir_foreach_instr(instr, block) {
+         nir_def *def = nir_instr_def(instr);
+         if (def) nir_foreach_use_including_if(use, def) {
+            nir_cf_node *consumer = nir_src_is_if(use) ? &nir_src_use_if(use)->cf_node : &nir_src_use_instr(use)->block->cf_node;
+            if (!bc250_loop_inside(consumer, outer)) legal = false;
+         }
+         if (instr->type != nir_instr_type_alu || nir_instr_as_alu(instr)->op != nir_op_sdot_4x8_iadd) continue;
+         nir_alu_instr *dot = nir_instr_as_alu(instr);
+         nir_def *rhs = dot->src[1].src.ssa;
+         if (found == ARRAY_SIZE(loads) || dot->src[1].swizzle[0] || rhs->num_components != 1 ||
+             rhs->bit_size != 32 || nir_def_instr(rhs)->type != nir_instr_type_intrinsic) { legal=false; continue; }
+         nir_intrinsic_instr *load = nir_instr_as_intrinsic(nir_def_instr(rhs));
+         if (load->intrinsic != nir_intrinsic_load_deref) { legal=false; continue; }
+         enum gl_access_qualifier flags = nir_intrinsic_access(load);
+         nir_deref_instr *array = nir_src_as_deref(load->src[0]);
+         if ((flags & (ACCESS_NON_WRITEABLE|ACCESS_CAN_REORDER)) != (ACCESS_NON_WRITEABLE|ACCESS_CAN_REORDER) ||
+             (flags & ACCESS_VOLATILE) || array->deref_type != nir_deref_type_array ||
+             array->type != glsl_uint_type() || !nir_deref_mode_is(array, nir_var_mem_ssbo)) { legal=false; continue; }
+         nir_deref_instr *parent = nir_deref_instr_parent(array);
+         if (!root) { root=parent; access=flags; }
+         if (flags != access || !bc250_neighbor_root(parent) || !bc250_loop_pure(&parent->def, &remat)) legal=false;
+         for (unsigned i=0; i<found; i++) if (loads[i] == rhs) legal=false;
+         dots[found] = &dot->def;
+         loads[found++] = rhs;
+      }
+   }
+   if (!legal || found != 336 || !root) {
+      
+      _mesa_set_destroy(remat.available,NULL); return false;
+   }
+   struct bc250_neighbor_groups groups;
+   if (!bc250_neighbor_plan_groups(dots,loads,maximum,&groups)) {
+      _mesa_set_destroy(remat.available,NULL); return false;
+   }
+   nir_validate_shader(nir, "before bc250 grouped compact loop clone");
+   const unsigned words=5408, start_word=54912/4;
+   unsigned old_bytes=nir->constant_data_size, base=ALIGN_POT(old_bytes,16);
+   unsigned packed_base=ALIGN_POT(base+4*words,16);
+   nir->constant_data_size=prepacked ? packed_base+8*words : base+4*words;
+   nir->constant_data=rerzalloc_size(nir,nir->constant_data,old_bytes,nir->constant_data_size);
+   memcpy((char *)nir->constant_data+base,bc250_neighbor_expected,4*words);
+   if (prepacked)
+      memcpy((char *)nir->constant_data+packed_base,bc250_neighbor_prepacked,8*words);
+   nir_builder b=nir_builder_at(nir_before_cf_node(&outer->cf_node));
+   nir_def *eligible=nir_iand(&b,nir_vote_any(&b,1,outer->condition.ssa),
+      nir_ieq_imm(&b,nir_channel(&b,nir_load_workgroup_id(&b),2),0));
+   nir_if *checking=nir_push_if(&b,eligible);
+   remat.b=&b; remat.map=_mesa_pointer_hash_table_create(NULL);
+   nir_deref_instr *guard_root=nir_instr_as_deref(nir_def_instr(bc250_loop_rematerialize(&root->def,&remat)));
+   _mesa_hash_table_destroy(remat.map,NULL);
+   /* The selected physical size is 32; do not load the API subgroup lane. */
+   nir_def *lane=nir_mbcnt_amd(&b,nir_imm_int(&b,-1),nir_imm_int(&b,0));
+   nir_def *different=nir_imm_int(&b,0);
+   for (unsigned round=0; round<42; round++) {
+      nir_def *relative=nir_iadd_imm(&b,nir_ishl_imm(&b,lane,2),round*128);
+      nir_def *proposed=nir_load_constant(&b,4,32,nir_ishl_imm(&b,relative,2),.base=base,.range=4*words,.align_mul=16,.align_offset=0);
+      for (unsigned j=0;j<4;j++) {
+         nir_deref_instr *ptr=nir_build_deref_array(&b,guard_root,nir_iadd_imm(&b,relative,start_word+j));
+         different=nir_ior(&b,different,nir_ixor(&b,nir_load_deref_with_access(&b,ptr,access),nir_channel(&b,proposed,j)));
+      }
+   }
+   for (unsigned round=0;round<1;round++) {
+      nir_def *relative=nir_iadd_imm(&b,lane,5376+round*32);
+      nir_def *proposed=nir_load_constant(&b,1,32,nir_ishl_imm(&b,relative,2),.base=base,.range=4*words,.align_mul=4,.align_offset=0);
+      nir_deref_instr *ptr=nir_build_deref_array(&b,guard_root,nir_iadd_imm(&b,relative,start_word));
+      different=nir_ior(&b,different,nir_ixor(&b,nir_load_deref_with_access(&b,ptr,access),proposed));
+   }
+   nir_def *all_equal=nir_vote_all(&b,1,nir_ieq_imm(&b,different,0));
+   nir_push_else(&b,checking);
+   nir_def *unavailable=nir_imm_false(&b);
+   nir_pop_if(&b,checking);
+   nir_def *verified=nir_if_phi(&b,all_equal,unavailable);
+
+   nir_cf_list original,clone;
+   b=nir_builder_at(nir_before_cf_list(&outer->then_list));
+   b.cursor=nir_cf_extract(&original,nir_before_cf_list(&outer->then_list),nir_after_cf_list(&outer->then_list));
+   nir_if *choice=nir_push_if(&b,verified);
+   struct hash_table *map=_mesa_pointer_hash_table_create(NULL);
+   /* Keep all loop limits and workgroup expressions dynamic. Only cloned
+    * dot coefficients use the pre-expanded table; the complete value guard
+    * and Z=0 gate establish the original address union and exact values. */
+   _mesa_set_destroy(remat.available,NULL);
+   nir_cf_list_clone(&clone,&original,&nir_cursor_current_block(b.cursor)->cf_node,map);
+   nir_cf_reinsert(&clone,b.cursor);
+   b.cursor=nir_after_cf_list(&choice->then_list);
+   nir_push_else(&b,choice);
+   nir_cf_reinsert(&original,b.cursor);
+   b.cursor=nir_after_cf_list(&choice->else_list);
+   nir_pop_if(&b,choice);
+   unsigned replaced=0,flushed=0;
+   nir_def *partials[336]={0}, *bases[336]={0};
+   for (unsigned i=0;i<found;i++) {
+      struct hash_entry *entry=_mesa_hash_table_search(map,dots[i]);
+      if (!entry) abort();
+      nir_def *copy=entry->data;
+      nir_alu_instr *dot=nir_instr_as_alu(nir_def_instr(copy));
+      if (dot->op != nir_op_sdot_4x8_iadd || dot->def.num_components != 1 || dot->def.bit_size != 32) abort();
+      nir_builder at=nir_builder_at(nir_before_instr(&dot->instr));
+      nir_def *a=nir_ssa_for_alu_src(&at,dot,0);
+      nir_def *c=nir_ssa_for_alu_src(&at,dot,2);
+      if (groups.first[i]==(int)i) bases[i]=c;
+      nir_def *ae,*ao,*we,*wo;
+      bc250_fsr4_unpack_pairs(&at,a,&ae,&ao);
+      if (prepacked) {
+         struct hash_entry *weight_entry=_mesa_hash_table_search(map,loads[i]);
+         if (!weight_entry) abort();
+         nir_def *weight_copy=weight_entry->data;
+         nir_intrinsic_instr *weight=nir_instr_as_intrinsic(nir_def_instr(weight_copy));
+         if (weight->intrinsic != nir_intrinsic_load_deref) abort();
+         nir_deref_instr *array=nir_src_as_deref(weight->src[0]);
+         if (array->deref_type != nir_deref_type_array) abort();
+         /* Use the cloned index; never keep an old branch's SSA definition. */
+         nir_def *offset=nir_ishl_imm(&at,nir_iadd_imm(&at,array->arr.index.ssa,-(int)start_word),3);
+         nir_def *packed=nir_load_constant(&at,2,32,offset,
+            .base=packed_base,.range=8*words,.align_mul=8,.align_offset=0);
+         we=nir_unpack_32_2x16(&at,nir_channel(&at,packed,0));
+         wo=nir_unpack_32_2x16(&at,nir_channel(&at,packed,1));
+      } else {
+         nir_def *w=nir_ssa_for_alu_src(&at,dot,1);
+         bc250_fsr4_unpack_pairs(&at,w,&we,&wo);
+      }
+      /* Each prefix was bounded for every actual loop coefficient assignment.
+       * Keep intermediate dot nodes until their sole tail consumer is replaced;
+       * DCE then removes them without ever changing a 32-bit use to a 16-bit type. */
+      nir_def *pair=nir_iadd(&at,nir_imul(&at,ae,we),nir_imul(&at,ao,wo));
+      if (groups.previous[i]>=0) {
+         nir_def *previous=partials[groups.previous[i]];
+         if (!previous) abort();
+         pair=nir_iadd(&at,previous,pair);
+      }
+      partials[i]=pair;
+      if (groups.tail[i]) {
+         nir_def *base_value=bases[groups.first[i]];
+         if (!base_value) abort();
+         nir_def *wide=nir_i2i32(&at,pair);
+         nir_def_replace(copy,nir_iadd(&at,base_value,nir_iadd(&at,nir_channel(&at,wide,0),nir_channel(&at,wide,1))));
+         flushed++;
+      }
+      replaced++;
+   }
+   _mesa_hash_table_destroy(map,NULL);
+   nir_progress(true,impl,nir_metadata_none);
+   nir_opt_dce(nir);
+   struct bc250_fsr4_counts remaining={0};
+   nir_shader_alu_pass(nir,bc250_fsr4_count,nir_metadata_all,&remaining);
+   if (replaced != 336 || flushed != groups.count || remaining.dots != 336 || remaining.constant_dots) abort();
+   nir_validate_shader(nir,"after bc250 neighbor grouped compact loop clone");
+   
+   return true;
+}
+
+static bool
+bc250_nested_root(nir_deref_instr *root)
+{
+   if (!root || root->deref_type != nir_deref_type_struct || root->strct.index != 0 ||
+       !glsl_type_is_array(root->type) || glsl_get_array_element(root->type) != glsl_uint_type()) return false;
+   nir_deref_instr *cast = nir_deref_instr_parent(root);
+   if (!cast || cast->deref_type != nir_deref_type_cast ||
+       !nir_deref_mode_is(cast, nir_var_mem_ssbo) ||
+       glsl_get_struct_field_offset(cast->type, 0) != 0) return false;
+   nir_instr *instr = nir_def_instr(cast->parent.ssa);
+   if (instr->type != nir_instr_type_intrinsic) return false;
+   nir_intrinsic_instr *desc = nir_instr_as_intrinsic(instr);
+   if (desc->intrinsic != nir_intrinsic_load_vulkan_descriptor ||
+       nir_intrinsic_desc_type(desc) != nir_descriptor_type_storage_buffer) return false;
+   instr = nir_def_instr(desc->src[0].ssa);
+   if (instr->type != nir_instr_type_intrinsic) return false;
+   nir_intrinsic_instr *resource = nir_instr_as_intrinsic(instr);
+   if (resource->intrinsic != nir_intrinsic_vulkan_resource_index ||
+       nir_intrinsic_desc_set(resource) != 2 || nir_intrinsic_binding(resource) != 0 ||
+       nir_intrinsic_desc_type(resource) != nir_descriptor_type_storage_buffer) return false;
+   nir_scalar index = nir_scalar_chase_movs(nir_get_scalar(resource->src[0].ssa, 0));
+   if (!nir_scalar_is_alu(index) || nir_scalar_alu_op(index) != nir_op_iadd) return false;
+   nir_scalar a = nir_scalar_chase_movs(nir_scalar_chase_alu_src(index, 0));
+   nir_scalar b = nir_scalar_chase_movs(nir_scalar_chase_alu_src(index, 1));
+   if (nir_scalar_is_const(a)) { nir_scalar tmp=a; a=b; b=tmp; }
+   if (!nir_scalar_is_const(b) || nir_scalar_as_uint(b) != 18 || a.comp ||
+       a.def->num_components != 1 || a.def->bit_size != 32) return false;
+   instr = nir_def_instr(a.def);
+   if (instr->type != nir_instr_type_intrinsic) return false;
+   nir_intrinsic_instr *push = nir_instr_as_intrinsic(instr);
+   if (push->intrinsic != nir_intrinsic_load_deref) return false;
+   nir_deref_instr *field = nir_src_as_deref(push->src[0]);
+   if (field->deref_type != nir_deref_type_struct || field->strct.index != 2 ||
+       field->type != glsl_uint_type() || !nir_deref_mode_is(field, nir_var_mem_push_const)) return false;
+   nir_deref_instr *var = nir_deref_instr_parent(field);
+   return var && var->deref_type == nir_deref_type_var && glsl_get_struct_field_offset(var->type, 2) == 12;
+}
+
+static bool
+bc250_nested_inside(nir_cf_node *node, nir_cf_node *parent)
+{
+   for (; node; node=node->parent) if (node==parent) return true;
+   return false;
+}
+
+static nir_loop *
+bc250_nested_owner(nir_cf_node *node)
+{
+   for (node=node->parent;node;node=node->parent)
+      if (node->type==nir_cf_node_loop) return nir_cf_node_as_loop(node);
+   return NULL;
+}
+
+static bool
+bc250_nested_eval(nir_scalar s, const struct bc250_nested_context *ctx,
+                  const uint32_t assignment[3], uint32_t *result, unsigned depth)
+{
+   if (depth>64 || (s.def->bit_size!=32 && s.def->bit_size!=1)) return false;
+   s=nir_scalar_chase_movs(s);
+   for (unsigned i=0;i<ctx->count;i++)
+      if (s.def==ctx->phis[i] && s.comp==0) { *result=assignment[i]; return true; }
+   if (nir_scalar_is_const(s)) { *result=nir_scalar_as_uint(s); return true; }
+   nir_instr *instr=nir_def_instr(s.def);
+   if (instr->type==nir_instr_type_intrinsic) {
+      if (nir_instr_as_intrinsic(instr)->intrinsic!=nir_intrinsic_load_workgroup_id || s.comp!=2) return false;
+      *result=0;return true;
+   }
+   if (!nir_scalar_is_alu(s)) return false;
+   nir_op op=nir_scalar_alu_op(s);
+   if (op!=nir_op_iadd && op!=nir_op_imul && op!=nir_op_iand && op!=nir_op_ior &&
+       op!=nir_op_ishl && op!=nir_op_ushr && op!=nir_op_ubfe && op!=nir_op_ieq) return false;
+   uint32_t a,b,c;
+   if (!bc250_nested_eval(nir_scalar_chase_alu_src(s,0),ctx,assignment,&a,depth+1) ||
+       !bc250_nested_eval(nir_scalar_chase_alu_src(s,1),ctx,assignment,&b,depth+1)) return false;
+   switch (op) {
+   case nir_op_iadd: *result=a+b;break;
+   case nir_op_imul: *result=a*b;break;
+   case nir_op_iand: *result=a&b;break;
+   case nir_op_ior: *result=a|b;break;
+   case nir_op_ishl: *result=a<<(b&31);break;
+   case nir_op_ushr: *result=a>>(b&31);break;
+   case nir_op_ieq: *result=a==b ? UINT32_MAX : 0;break;
+   case nir_op_ubfe:
+      if (!bc250_nested_eval(nir_scalar_chase_alu_src(s,2),ctx,assignment,&c,depth+1) ||
+          b>31 || c>32 || b+c>32) return false;
+      *result=(a>>b)&(c==32 ? UINT32_MAX : (1u<<c)-1u);break;
+   default: UNREACHABLE("validated nested index operation");
+   }
+   return true;
+}
+
+static bool
+bc250_nested_collect(nir_scalar s, struct bc250_nested_context *ctx, unsigned depth)
+{
+   if (depth>64 || s.def->bit_size!=32) return false;
+   s=nir_scalar_chase_movs(s);
+   if (nir_scalar_is_const(s)) return true;
+   nir_instr *instr=nir_def_instr(s.def);
+   if (instr->type==nir_instr_type_phi) {
+      if (s.comp || s.def->num_components!=1) return false;
+      for (unsigned i=0;i<ctx->count;i++) if (ctx->phis[i]==s.def) return true;
+      if (ctx->count==3) return false;
+      ctx->phis[ctx->count++]=s.def;return true;
+   }
+   if (instr->type==nir_instr_type_intrinsic)
+      return nir_instr_as_intrinsic(instr)->intrinsic==nir_intrinsic_load_workgroup_id && s.comp==2;
+   if (!nir_scalar_is_alu(s)) return false;
+   nir_op op=nir_scalar_alu_op(s);
+   if (op!=nir_op_iadd && op!=nir_op_imul && op!=nir_op_iand && op!=nir_op_ior &&
+       op!=nir_op_ishl && op!=nir_op_ushr && op!=nir_op_ubfe) return false;
+   for (unsigned i=0;i<nir_op_infos[op].num_inputs;i++)
+      if (!bc250_nested_collect(nir_scalar_chase_alu_src(s,i),ctx,depth+1)) return false;
+   return true;
+}
+
+static bool
+bc250_nested_trip(nir_def *def, unsigned *trip)
+{
+   if (!def || nir_def_instr(def)->type!=nir_instr_type_phi || def->bit_size!=32 || def->num_components!=1) return false;
+   nir_phi_instr *phi=nir_instr_as_phi(nir_def_instr(def));nir_block *first=phi->instr.block;
+   if (first->cf_node.parent->type!=nir_cf_node_loop) return false;
+   nir_loop *loop=nir_cf_node_as_loop(first->cf_node.parent);
+   if (nir_loop_first_block(loop)!=first || nir_loop_has_continue_construct(loop)) return false;
+   nir_block *last=nir_loop_last_block(loop);
+   if (!last || last==first || !exec_list_is_empty(&last->instr_list)) return false;
+   nir_cf_node *exit_node=nir_cf_node_prev(&last->cf_node);
+   if (!exit_node || exit_node->type!=nir_cf_node_if || exit_node->parent!=&loop->cf_node) return false;
+   nir_if *exit=nir_cf_node_as_if(exit_node);
+   nir_cf_node *before_node=nir_cf_node_prev(exit_node);
+   if (!before_node || before_node->type!=nir_cf_node_block) return false;
+   nir_block *before=nir_cf_node_as_block(before_node);
+   if (!exec_list_is_singular(&exit->then_list) || !exec_list_is_singular(&exit->else_list) ||
+       !exec_list_is_empty(&nir_if_first_else_block(exit)->instr_list)) return false;
+   nir_block *then=nir_if_first_then_block(exit);
+   if (!exec_list_is_singular(&then->instr_list)) return false;
+   nir_instr *jump=nir_block_last_instr(then);
+   if (jump->type!=nir_instr_type_jump || nir_instr_as_jump(jump)->type!=nir_jump_break) return false;
+   /* Nested-loop breaks target their own loops. No other break of this loop,
