+/* The pinned INT8 8K shaders encode masked DWORD stores at byte 0x08000000.
+ * That address lies inside their 332352256-byte scratch allocation. It can
+ * overwrite a live input and race a neighboring invocation at clipped edges.
+ * These exact eight bytecodes use the audited constant only in masked-store
+ * addresses. Redirect it beyond every scratch buffer supported by this provider.
+ * Keep the original stage identity for the separately validated arithmetic pass.
+ */
+static bool
+bc250_resolution_guard_spirv(const struct radv_compiler_info *compiler_info,
+                            const struct radv_shader_stage *stage, bool is_internal,
+                            const uint32_t *spirv, size_t size, uint32_t **patched)
+{
+   *patched = NULL;
+   if (is_internal || compiler_info->debug.family != CHIP_GFX1013 ||
+       stage->stage != MESA_SHADER_COMPUTE || !stage->entrypoint ||
+       strcmp(stage->entrypoint, "main") ||
+       (stage->spec_info && stage->spec_info->mapEntryCount) ||
+       spirv != (const uint32_t *)stage->spirv.data ||
+       (!debug_get_bool_option("BC250_FSR4_RESOLUTION_VARIANTS", false) &&
+        !debug_get_bool_option("BC250_FSR4_RESOLUTION_GUARD", false)))
+      return true;
+   static const struct { size_t size; uint64_t hash; unsigned word; } guards[] = {
+      {108840, 0xfdf595207adeaa9bull, 3993u}, /* pass 1 */
+      {109048, 0xc34ca544b0bfa394ull, 4005u}, /* pass 2 */
+      {190032, 0x3d148c8bbfb1675full, 7293u}, /* pass 4 */
+      {190032, 0xca6a3312a0229b59ull, 7293u}, /* pass 5 */
+      {84476, 0xa1a83a915f310257ull, 811u}, /* pass 9 */
+      {189952, 0x774fa9d9112b1629ull, 7289u}, /* pass 10 */
+      {61308, 0x8a0b34b8c5748a8dull, 719u}, /* pass 11 */
+      {109064, 0x68c8a5b342ff058full, 4009u}, /* pass 12 */
+   };
+   bool candidate = false;
+   for (unsigned i = 0; i < ARRAY_SIZE(guards); i++) candidate |= guards[i].size == size;
+   if (!candidate) return true;
+   uint64_t hash = 14695981039346656037ull;
+   for (size_t i = 0; i < size; i++) hash = (hash ^ ((const uint8_t *)spirv)[i]) * 1099511628211ull;
+   for (unsigned i = 0; i < ARRAY_SIZE(guards); i++) {
+      if (guards[i].size != size || guards[i].hash != hash) continue;
+      const unsigned word = guards[i].word;
+      if (word < 3 || word >= size / 4 || spirv[word - 3] != 0x0004002bu ||
+          spirv[word] != 0x08000000u)
+         return true;
+      *patched = malloc(size);
+      if (!*patched) return false;
+      memcpy(*patched, spirv, size);
+      (*patched)[word] = 0xfffffffcu;
+      return true;
+   }
+   return true;
+}
