+      break;
+   }
    case nir_op_umul24_relaxed: {
       if (dst.regClass() == s1) {
          Operand op1(get_alu_src(ctx, instr->src[0]));
diff --git a/src/amd/vulkan/radv_shader.c b/src/amd/vulkan/radv_shader.c
index c5f78f54d71..4f0d30ea28b 100644
--- a/src/amd/vulkan/radv_shader.c
+++ b/src/amd/vulkan/radv_shader.c
@@ -169,6 +169,121 @@ radv_can_dump_shader_stats(const struct radv_compiler_info *compiler_info, nir_s
    return compiler_info->debug.dump_shader_stats && !is_meta_shader(nir);
 }
 
+
+/* EXP-039A: GFX1013 dense signed-dot prepass.
+ *
+ * FSR4's large INT8 reductions benefit from lowering data x data SDot to
+ * signed i24 MUL/MAD before the ordinary no-hardware-dot algebraic fallback.
+ * Keep this conservative: only compute shaders with at least 2304 packed
+ * signed dot instructions are eligible. This leaves ED7 (2048), 0d64 (512)
+ * and the short 20-dot kernels on the B2 path.
+ */
+struct bc250_dot_density {
+   unsigned sdot;
+   unsigned iadd;
+   unsigned imul;
+   unsigned bcsel;
+};
+
+static bool
+bc250_count_dot_density(nir_builder *b, nir_alu_instr *alu, void *data)
+{
+   (void)b;
+   struct bc250_dot_density *density = data;
+
+   if (alu->op == nir_op_sdot_4x8_iadd)
+      density->sdot++;
+   else if (alu->op == nir_op_iadd)
+      density->iadd++;
+   else if (alu->op == nir_op_imul)
+      density->imul++;
+   else if (alu->op == nir_op_bcsel)
+      density->bcsel++;
+
+   return false;
+}
+
+static bool
+bc250_lower_dense_sdot4x8_one(nir_builder *b, nir_alu_instr *alu, void *data)
+{
+   const bool two_chain = data && *(const bool *)data;
+
+   if (alu->op != nir_op_sdot_4x8_iadd)
+      return false;
+
+   if (nir_src_is_const(alu->src[0].src) || nir_src_is_const(alu->src[1].src))
+      return false;
+
+   b->cursor = nir_before_instr(&alu->instr);
+
+   nir_def *a = nir_ssa_for_alu_src(b, alu, 0);
+   nir_def *bv = nir_ssa_for_alu_src(b, alu, 1);
+   nir_def *c = nir_ssa_for_alu_src(b, alu, 2);
+   nir_def *r;
+
+   if (two_chain) {
+      /* The 2304-SDot family benefits from two short dependency chains:
+       * it avoids the MAD3 spill cluster and can preserve 6-wave occupancy.
+       */
+      nir_def *r01 = nir_build_alu2(b, nir_op_imul24_relaxed,
+                                    nir_extract_i8_imm(b, a, 0),
+                                    nir_extract_i8_imm(b, bv, 0));
+      r01 = nir_imad24_ir3(b, nir_extract_i8_imm(b, a, 1),
+                           nir_extract_i8_imm(b, bv, 1), r01);
+
+      nir_def *r23 = nir_build_alu2(b, nir_op_imul24_relaxed,
+                                    nir_extract_i8_imm(b, a, 2),
+                                    nir_extract_i8_imm(b, bv, 2));
+      r23 = nir_imad24_ir3(b, nir_extract_i8_imm(b, a, 3),
+                           nir_extract_i8_imm(b, bv, 3), r23);
+      r = nir_iadd(b, r01, r23);
+   } else {
+      /* For the other dense reduction families, MAD3 gives the best
+       * measured compiler throughput and does not introduce new spills.
+       */
+      r = nir_build_alu2(b, nir_op_imul24_relaxed,
+                         nir_extract_i8_imm(b, a, 0),
+                         nir_extract_i8_imm(b, bv, 0));
+      for (unsigned i = 1; i < 4; i++) {
+         r = nir_imad24_ir3(b, nir_extract_i8_imm(b, a, i),
+                            nir_extract_i8_imm(b, bv, i), r);
+      }
+   }
+
+   r = nir_iadd(b, r, c);
+   nir_def_replace(&alu->def, r);
+   return true;
+}
+
+static bool
+bc250_lower_dense_sdot4x8(nir_shader *nir)
+{
+   struct bc250_dot_density density = {0};
+   nir_shader_alu_pass(nir, bc250_count_dot_density, nir_metadata_all, &density);
+
+   /* GFX1013: MAD24 wins for dot-dense integer reductions, but not for
+    * sparse dot usage or ED7's add-heavy form.  Use reduction density
+    * rather than shader identity or an exact SDot-count bucket.
+    */
+   /* EXP-040E: occupancy-first gate derived from the full 64-shader A/B.
+    * 1088 and 1152 SDot families never lost resident waves.  In the 2304
+    * family, control-rich forms (>=16 bcsel) also preserved 6 waves, while
+    * the low-control variants fell from 6 to 4.  Keep those pressure-
+    * sensitive and all >2304 families on the proven B2 lowering path. */
+   const bool safe_1088 = density.sdot == 1088;
+   /* Leave low-IMUL 1152 (e955 family) for EXP-042A deferred-SDot,
+    * where the full64 audit showed a much larger win. */
+   const bool safe_1152 = density.sdot == 1152 && density.imul >= 100;
+   const bool safe_2304 = density.sdot == 2304 && density.bcsel >= 16;
+
+   if (!(safe_1088 || safe_1152 || safe_2304))
+      return false;
+
+   const bool two_chain = safe_1152 || safe_2304;
+   return nir_shader_alu_pass(nir, bc250_lower_dense_sdot4x8_one,
+                              nir_metadata_control_flow, (void *)&two_chain);
+}
+
 void
 radv_optimize_nir(struct nir_shader *shader, bool optimize_conservatively)
 {
@@ -790,7 +905,23 @@ radv_shader_spirv_to_nir(const struct radv_compiler_info *compiler_info, struct
       NIR_PASS(_, nir, nir_opt_find_array_copies);
       NIR_PASS(_, nir, nir_lower_vars_to_ssa);
 
-      radv_optimize_nir(nir, false);
+      if (compiler_info->debug.family == CHIP_GFX1013 &&
+          nir->info.stage == MESA_SHADER_COMPUTE) {
+         NIR_PASS(_, nir, bc250_lower_dense_sdot4x8);
+
+         /* EXP-042B: preserve every remaining signed packed SDot through
+          * one full NIR optimization round, then restore real GFX1013
+          * capabilities before lowering. Native packed-dot stays disabled. */
+         const nir_shader_compiler_options *saved_options = nir->options;
+         nir_shader_compiler_options deferred_options = *saved_options;
+         deferred_options.has_sdot_4x8 = true;
+         nir->options = &deferred_options;
+         radv_optimize_nir(nir, false);
+         nir->options = saved_options;
+         radv_optimize_nir(nir, false);
+      } else {
+         radv_optimize_nir(nir, false);
+      }
 
       NIR_PASS(_, nir, nir_opt_memcpy);
       NIR_PASS(_, nir, nir_opt_deref);
