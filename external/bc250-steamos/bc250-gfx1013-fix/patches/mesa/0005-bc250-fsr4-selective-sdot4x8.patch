From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: David Moraza Sanchez <dmorazasanchezmendo@gmail.com>
Date: Mon, 17 Aug 2026 23:56:08 +0000
Subject: [PATCH 5/5] nir: selectively reassociate the signed 4x8 dp4a
 fallback (EXP-028)

Supersedes the earlier unconditional reassociation of sdot_4x8_a_b.
A 64-shader FSR4 capture found that globally reassociating the sum
into a right-leaning chain is a large win on most kernels but causes
catastrophic register pressure and spilling in specific pathological
shaders that accumulate into a constant.

Split the shorthand into sdot_4x8_a_b_balanced (Mesa's original
four-product tree) and sdot_4x8_a_b_reassoc (the right-leaning chain),
and match on whether the sdot_4x8_iadd accumulator is a constant:
constant accumulator keeps the balanced lowering, non-constant
accumulator gets the reassociated one. The constant-matching rule is
listed first so NIR's algebraic pass tries it before the generic rule.

Representative results from the BC-250 FSR4 corpus (Mesa 26.2.0):
hot kernel 8317 goes from 256 pre-sched VGPRs/16681 instructions
(balanced) to 168/15486 (reassociated) as before, while pathological
kernel ed7 - which regressed to 3035 pre-sched VGPRs and 2794 spilled
under unconditional reassociation - stays at the balanced lowering's
1555 pre-sched VGPRs / 1314 spilled.

Verified on the BC-250 (GFX1013) with FSR 4.1.1 in Cyberpunk 2077.

https://github.com/dmorazasanchez/bc250-fsr4/tree/v2
---
 src/compiler/nir/nir_opt_algebraic.py | 22 +++++++++++++++++-----
 1 file changed, 17 insertions(+), 5 deletions(-)

diff --git a/src/compiler/nir/nir_opt_algebraic.py b/src/compiler/nir/nir_opt_algebraic.py
index fd5c6bf00a4..7a081682445 100644
--- a/src/compiler/nir/nir_opt_algebraic.py
+++ b/src/compiler/nir/nir_opt_algebraic.py
@@ -444,10 +444,21 @@ for sz in (16, 32, 64):
 
 # Shorthand for the expansion of just the dot product part of the [iu]dp4a
 # instructions.
-sdot_4x8_a_b = ('iadd', ('iadd', ('imul24_relaxed', ('extract_i8', a, 0), ('extract_i8', b, 0)),
-                                 ('imul24_relaxed', ('extract_i8', a, 1), ('extract_i8', b, 1))),
-                        ('iadd', ('imul24_relaxed', ('extract_i8', a, 2), ('extract_i8', b, 2)),
-                                 ('imul24_relaxed', ('extract_i8', a, 3), ('extract_i8', b, 3))))
+sdot_4x8_a_b_balanced = ('iadd',
+                    ('iadd',
+                     ('imul24_relaxed', ('extract_i8', a, 0), ('extract_i8', b, 0)),
+                     ('imul24_relaxed', ('extract_i8', a, 1), ('extract_i8', b, 1))),
+                    ('iadd',
+                     ('imul24_relaxed', ('extract_i8', a, 2), ('extract_i8', b, 2)),
+                     ('imul24_relaxed', ('extract_i8', a, 3), ('extract_i8', b, 3))))
+
+sdot_4x8_a_b_reassoc = ('iadd',
+                    ('imul24_relaxed', ('extract_i8', a, 3), ('extract_i8', b, 3)),
+                    ('iadd',
+                     ('imul24_relaxed', ('extract_i8', a, 2), ('extract_i8', b, 2)),
+                     ('iadd',
+                      ('imul24_relaxed', ('extract_i8', a, 1), ('extract_i8', b, 1)),
+                      ('imul24_relaxed', ('extract_i8', a, 0), ('extract_i8', b, 0)))))
 udot_4x8_a_b = ('iadd', ('iadd', ('umul24_relaxed', ('extract_u8', a, 0), ('extract_u8', b, 0)),
                                  ('umul24_relaxed', ('extract_u8', a, 1), ('extract_u8', b, 1))),
                         ('iadd', ('umul24_relaxed', ('extract_u8', a, 2), ('extract_u8', b, 2)),
@@ -462,7 +473,8 @@ udot_2x16_a_b = ('iadd', ('umul24_relaxed', ('extract_u16', a, 0), ('extract_u16
                          ('umul24_relaxed', ('extract_u16', a, 1), ('extract_u16', b, 1)))
 
 optimizations.extend([
-   (('sdot_4x8_iadd', a, b, c), ('iadd', sdot_4x8_a_b, c), '!options->has_sdot_4x8'),
+   (('sdot_4x8_iadd', a, b, '#c'), ('iadd', sdot_4x8_a_b_balanced, c), '!options->has_sdot_4x8'),
+   (('sdot_4x8_iadd', a, b, c), ('iadd', sdot_4x8_a_b_reassoc, c), '!options->has_sdot_4x8'),
    (('udot_4x8_uadd', a, b, c), ('iadd', udot_4x8_a_b, c), '!options->has_udot_4x8'),
    (('sudot_4x8_iadd', a, b, c), ('iadd', sudot_4x8_a_b, c), '!options->has_sudot_4x8'),
    (('sdot_2x16_iadd', a, b, c), ('iadd', sdot_2x16_a_b, c), '!options->has_dot_2x16'),
