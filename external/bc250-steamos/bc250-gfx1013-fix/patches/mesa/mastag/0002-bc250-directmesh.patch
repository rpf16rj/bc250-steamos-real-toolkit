+ * implicit, otherwise the reason they are not. */
+static const char *
+ms_implicit_indices_ok(const nir_shader *shader, const ac_nir_lower_ngg_options *options,
+                       unsigned vertices_per_prim)
+{
+   if (!options->bc250_implicit_tris)
