+void
+radv_bc250_submit_profile_print(struct radv_device *device, bool final)
+{
+   const uint64_t now = os_time_get_nano();
+   if (!final && now - __atomic_load_n(&device->bc250_prof_last_ns, __ATOMIC_RELAXED) < 5000000000ull)
+      return;
+   simple_mtx_lock(&device->bc250_prof_mtx);
