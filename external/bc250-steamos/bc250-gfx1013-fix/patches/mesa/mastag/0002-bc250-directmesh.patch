+   bool merge_prep_l2_inv;    /* RADV_BC250_MESH_MERGE_PREP_L2_INV */
+   bool native_task_direct;   /* BC250_NATIVE_TASK_DIRECT || RADV_BC250_NATIVE_TASK */
