+static const char *
+bc250_prof_qf_name(enum radv_queue_family qf)
+{
+   switch (qf) {
+   case RADV_QUEUE_GENERAL:
+      return "gfx";
+   case RADV_QUEUE_COMPUTE:
+      return "ace";
+   case RADV_QUEUE_TRANSFER:
+      return "sdma";
+   case RADV_QUEUE_SPARSE:
+      return "sparse";
+   default:
+      return "other";
+   }
+}
+
+static void
+bc250_prof_add(struct radv_queue *queue, enum radv_bc250_prof_field f, uint64_t v)
+{
+   __atomic_fetch_add(&queue->bc250_prof.v[f], v, __ATOMIC_RELAXED);
+}
+
+void
+radv_bc250_submit_profile_present(struct radv_queue *queue, uint64_t ns)
+{
+   bc250_prof_add(queue, RADV_BC250_PROF_PRESENT_NS, ns);
+   bc250_prof_add(queue, RADV_BC250_PROF_PRESENTS, 1);
+}
