+         snprintf(line, sizeof(line),
+                  "BC250_SUBMIT_PROFILE %s t=%.1f dt=%.1f q=%u.%u qf=%s calls=%" PRIu64 " calls_per_s=%.1f"
+                  " total_us=%.2f probe_us=%.2f driver_us=%.2f radv_us=%.2f bolist_us=%.2f cs_ioctl_us=%.2f"
+                  " zero_us=%.2f timer_us=%.2f post_us=%.2f probes=%.2f probes_skipped=%.2f resets=%.2f"
+                  " cs_per_call=%.2f cs_ioctl_us_per_cs=%.2f handles_per_cs=%.1f ibs_per_cs=%.2f"
