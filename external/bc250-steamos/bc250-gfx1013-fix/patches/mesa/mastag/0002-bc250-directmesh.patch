+static inline bool
+vk_sync_bc250_known_submitted(const struct vk_sync *sync, uint64_t wait_value)
+{
+   if (sync->flags & VK_SYNC_IS_SHARED)
+      return false;
+   const uint64_t known = __atomic_load_n(&sync->bc250_known, __ATOMIC_ACQUIRE);
+   if (sync->flags & VK_SYNC_IS_TIMELINE)
+      return wait_value <= known;
+   return known != 0;
+}
+
+static inline void
+vk_sync_bc250_note_submitted(struct vk_sync *sync, uint64_t value)
+{
+   if (sync->flags & VK_SYNC_IS_SHARED)
+      return;
+   if (!(sync->flags & VK_SYNC_IS_TIMELINE)) {
+      __atomic_store_n(&sync->bc250_known, 1, __ATOMIC_RELEASE);
+      return;
+   }
+   uint64_t cur = __atomic_load_n(&sync->bc250_known, __ATOMIC_RELAXED);
+   while (cur < value &&
+          !__atomic_compare_exchange_n(&sync->bc250_known, &cur, value, true, __ATOMIC_RELEASE, __ATOMIC_RELAXED))
+      ;
+}
+
+static inline void
+vk_sync_bc250_note_unknown(struct vk_sync *sync)
+{
+   /* Binary payload consumed / reset / replaced. A timeline only goes back to
+    * "nothing known" when its payload is replaced (import). */
+   __atomic_store_n(&sync->bc250_known, 0, __ATOMIC_RELEASE);
+}
