+   /** BC250 fork (vk_device::bc250_known_signals): timeline: the highest value
+    * known to be attached in the kernel; binary: nonzero while a payload is
+    * known to be attached (signal accepted, not consumed/reset since).
+    * Only maintained and read when the device switch is on; never trusted for
+    * VK_SYNC_IS_SHARED syncs (other processes may signal or consume them). */
+   uint64_t bc250_known;
