+bool
+radv_bc250_pipeline_binary_is_plan(const struct radv_pipeline_binary *binary)
+{
+   uint64_t magic = 0;
+   if (binary->size >= sizeof(magic))
+      memcpy(&magic, binary->data, sizeof(magic));
+   return magic == RADV_BC250_PLAN_BINARY_MAGIC;
