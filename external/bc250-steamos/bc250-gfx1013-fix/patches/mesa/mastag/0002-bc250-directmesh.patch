+         v[RADV_BC250_PROF_VK_PROBE_NS] = __atomic_load_n(&q->vk.bc250_prof.probe_ns, __ATOMIC_RELAXED);
+         v[RADV_BC250_PROF_VK_PROBES] = __atomic_load_n(&q->vk.bc250_prof.probes, __ATOMIC_RELAXED);
+         v[RADV_BC250_PROF_VK_PROBES_SKIPPED] = __atomic_load_n(&q->vk.bc250_prof.probes_skipped, __ATOMIC_RELAXED);
+         v[RADV_BC250_PROF_VK_POST_NS] = __atomic_load_n(&q->vk.bc250_prof.post_ns, __ATOMIC_RELAXED);
+         v[RADV_BC250_PROF_VK_RESETS] = __atomic_load_n(&q->vk.bc250_prof.resets, __ATOMIC_RELAXED);
+         for (unsigned k = 0; k < RADV_BC250_PROF_FIELDS; k++) {
