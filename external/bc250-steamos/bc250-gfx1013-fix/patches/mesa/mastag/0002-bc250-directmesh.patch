+                  d[RADV_BC250_PROF_VK_TOTAL_NS] / c / 1e3, d[RADV_BC250_PROF_VK_PROBE_NS] / c / 1e3,
+                  d[RADV_BC250_PROF_DRIVER_NS] / c / 1e3, driver_rest / c / 1e3,
+                  d[RADV_BC250_PROF_BOLIST_NS] / c / 1e3, d[RADV_BC250_PROF_CS_IOCTL_NS] / c / 1e3,
+                  d[RADV_BC250_PROF_ZERO_NS] / c / 1e3, d[RADV_BC250_PROF_TIMER_NS] / c / 1e3,
+                  d[RADV_BC250_PROF_VK_POST_NS] / c / 1e3, d[RADV_BC250_PROF_VK_PROBES] / c,
+                  d[RADV_BC250_PROF_VK_PROBES_SKIPPED] / c, d[RADV_BC250_PROF_VK_RESETS] / c,
+                  d[RADV_BC250_PROF_CS_IOCTLS] / c, d[RADV_BC250_PROF_CS_IOCTL_NS] / cs / 1e3,
+                  d[RADV_BC250_PROF_HANDLES] / cs, d[RADV_BC250_PROF_IBS] / cs, d[RADV_BC250_PROF_DRIVER_CALLS],
+                  d[RADV_BC250_PROF_PRESENTS],
