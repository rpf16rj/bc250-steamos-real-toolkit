+                  device->load_grid_size_from_user_sgpr ||
+                  (stage->stage == MESA_SHADER_TASK && pdev->info.family == CHIP_GFX1013 &&
+                   pdev->info.gfx_level >= GFX10_3 && pdev->info.has_gfx1013_task_shading),
             });
    NIR_PASS(_, stage->nir, radv_nir_lower_abi, gfx_level, stage, gfx_state, pdev->info.address32_hi);
 
diff --git a/src/amd/vulkan/radv_queue.c b/src/amd/vulkan/radv_queue.c
