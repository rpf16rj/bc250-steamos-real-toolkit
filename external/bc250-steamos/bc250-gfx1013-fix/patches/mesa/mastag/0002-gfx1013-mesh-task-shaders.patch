From 5822b318716b073185efeccf5340796cd948da4d Mon Sep 17 00:00:00 2001
From: DryhoppedIPA <DryhoppedIPA@users.noreply.github.com>
Date: Sat, 8 Aug 2026 04:53:11 +0000
Subject: [PATCH 2/4] radv,aco: native mesh and task shaders on GFX1013

Rebase the experimental GFX1013 mesh/task path. Keep the GFX1013 hardware workarounds from the original patch, but require a GFX10.3 software level for exposing mesh/task features so the path stays dormant until RADV_GFX103 is explicitly enabled.
---
 src/amd/common/ac_gpu_info.c                  | 11 +++++-
 src/amd/common/ac_gpu_info.h                  |  2 +
 src/amd/compiler/aco_shader_info.h            |  1 +
 .../instruction_selection/aco_isel_setup.cpp  |  6 ++-
 src/amd/vulkan/radv_cmd_buffer.c              | 32 +++++++++++----
 src/amd/vulkan/radv_physical_device.c         | 39 +++++++++++++------
 src/amd/vulkan/radv_pipeline.c                |  5 ++-
 src/amd/vulkan/radv_queue.c                   |  6 ++-
 src/amd/vulkan/radv_shader.c                  |  3 ++
 src/amd/vulkan/radv_shader_args.c             |  4 +-
 10 files changed, 83 insertions(+), 26 deletions(-)

diff --git a/src/amd/common/ac_gpu_info.c b/src/amd/common/ac_gpu_info.c
index 249c2cb..19bbbb7 100644
--- a/src/amd/common/ac_gpu_info.c
+++ b/src/amd/common/ac_gpu_info.c
@@ -970,9 +970,16 @@ void ac_fill_bug_info(struct radeon_info *info)
 
    /* Firmware bug with DISPATCH_TASKMESH_INDIRECT_MULTI_ACE packets.
     * On old MEC FW versions, it hangs the GPU when indirect count is zero.
+    * GFX1013 firmware 144 exhibits the same hang despite retaining GFX10.1
+    * identity, so its firmware version is not governed by the GFX10.3 cutoff.
     */
-   info->has_taskmesh_indirect0_bug = info->gfx_level == GFX10_3 &&
-                                      info->mec_fw_version < 100;
+   info->has_taskmesh_indirect0_bug =
+      (info->gfx_level == GFX10_3 && info->mec_fw_version < 100) ||
+      info->family == CHIP_GFX1013;
+
+   /* Hardware capabilities used by RADV's opt-in GFX1013 mesh/task path. */
+   info->has_gfx1013_mesh_shading = info->family == CHIP_GFX1013;
+   info->has_gfx1013_task_shading = info->has_gfx1013_mesh_shading;
 
    info->has_export_conflict_bug = info->gfx_level == GFX11;
 
diff --git a/src/amd/common/ac_gpu_info.h b/src/amd/common/ac_gpu_info.h
index 2c736ec..d3d25af 100644
--- a/src/amd/common/ac_gpu_info.h
+++ b/src/amd/common/ac_gpu_info.h
@@ -283,6 +283,8 @@ struct radeon_info {
    bool has_vrs_ds_export_bug;
    bool has_vrs_export_bug;
    bool has_taskmesh_indirect0_bug;
+   bool has_gfx1013_mesh_shading;
+   bool has_gfx1013_task_shading;
    bool sdma_supports_sparse;      /* Whether SDMA can safely access sparse resources. */
    bool sdma_supports_compression; /* Whether SDMA supports DCC and HTILE. */
    bool has_set_context_pairs;
diff --git a/src/amd/compiler/aco_shader_info.h b/src/amd/compiler/aco_shader_info.h
index 56f230b..3c6def8 100644
--- a/src/amd/compiler/aco_shader_info.h
+++ b/src/amd/compiler/aco_shader_info.h
@@ -149,6 +149,7 @@ struct aco_compiler_options {
    bool record_asm;
    bool record_ir;
    bool record_stats;
+   bool has_mesh_shading;
    bool optimisations_disabled;
    uint8_t enable_mrt_output_nan_fixup;
    bool wgp_mode;
diff --git a/src/amd/compiler/instruction_selection/aco_isel_setup.cpp b/src/amd/compiler/instruction_selection/aco_isel_setup.cpp
index c4d28a1..e18fc03 100644
--- a/src/amd/compiler/instruction_selection/aco_isel_setup.cpp
+++ b/src/amd/compiler/instruction_selection/aco_isel_setup.cpp
@@ -783,9 +783,11 @@ setup_isel_context(Program* program, unsigned shader_count, struct nir_shader* c
    program->workgroup_size = program->info.workgroup_size;
    assert(program->workgroup_size);
 
-   /* Mesh shading only works on GFX10.3+. */
+   /* Mesh shading normally requires GFX10.3+. GFX1013 can use the
+    * experimental path when RADV explicitly enables its mesh capability.
+    */
    ASSERTED bool mesh_shading = ctx.stage.has(SWStage::TS) || ctx.stage.has(SWStage::MS);
-   assert(!mesh_shading || ctx.program->gfx_level >= GFX10_3);
+   assert(!mesh_shading || options->has_mesh_shading);
 
    setup_tcs_info(&ctx);
 
diff --git a/src/amd/vulkan/radv_cmd_buffer.c b/src/amd/vulkan/radv_cmd_buffer.c
index 3a1f98a..cfa5b51 100644
--- a/src/amd/vulkan/radv_cmd_buffer.c
+++ b/src/amd/vulkan/radv_cmd_buffer.c
@@ -3145,7 +3145,8 @@ radv_emit_hw_ngg(struct radv_cmd_buffer *cmd_buffer, const struct radv_shader *e
        *
        * Requirement: GE_CNTL.VERT_GRP_SIZE = VGT_GS_ONCHIP_CNTL.ES_VERTS_PER_SUBGRP - 5
        */
-      if (pdev->info.gfx_level == GFX10 && es_type != MESA_SHADER_TESS_EVAL && ngg_state->hw_max_esverts != 256) {
+      if (pdev->info.gfx_level == GFX10 && shader->info.stage != MESA_SHADER_MESH &&
+          es_type != MESA_SHADER_TESS_EVAL && ngg_state->hw_max_esverts != 256) {
          ge_cntl &= C_03096C_VERT_GRP_SIZE;
 
          if (ngg_state->hw_max_esverts > 5) {
@@ -8774,10 +8775,13 @@ radv_bind_pre_rast_shader(struct radv_cmd_buffer *cmd_buffer, const struct radv_
    }
 
    if (mesh_shading != cmd_buffer->state.mesh_shading) {
-      /* Re-emit VRS state because the combiner is different (vertex vs primitive). Re-emit
-       * primitive topology because the mesh shading pipeline clobbered it.
+      /* Re-emit primitive topology because the mesh shading pipeline clobbered
+       * it. Real GFX10.3+ hardware also needs VRS state; GFX1013 has no FSR
+       * hardware even when RADV_GFX103 promotes its software gfx_level.
        */
-      cmd_buffer->state.dirty |= RADV_CMD_DIRTY_FSR_STATE | RADV_CMD_DIRTY_VGT_PRIM_STATE;
+      cmd_buffer->state.dirty |= RADV_CMD_DIRTY_VGT_PRIM_STATE;
+      if (pdev->info.gfx_level >= GFX10_3 && pdev->info.family != CHIP_GFX1013)
+         cmd_buffer->state.dirty |= RADV_CMD_DIRTY_FSR_STATE;
    }
 
    /* Determine if this shader is the last VGT shader. */
@@ -11472,6 +11476,7 @@ radv_emit_indirect_taskmesh_draw_packets(const struct radv_device *device, struc
    const struct radv_physical_device *pdev = radv_device_physical(device);
    const uint32_t view_mask = cmd_state->render.view_mask;
    const unsigned num_views = MAX2(1, util_bitcount(view_mask));
+   const bool gfx1013_skip_zero_pair = workaround_cond_va && pdev->info.family == CHIP_GFX1013;
    unsigned ace_predication_size = num_views * 11; /* DISPATCH_TASKMESH_INDIRECT_MULTI_ACE size */
 
    if (pdev->info.has_taskmesh_indirect0_bug && info->count_va) {
@@ -11490,8 +11495,15 @@ radv_emit_indirect_taskmesh_draw_packets(const struct radv_device *device, struc
       ac_emit_cp_copy_data(ace_cs->b, COPY_DATA_IMM, COPY_DATA_DST_MEM, 1, workaround_cond_va,
                            AC_CP_COPY_DATA_WR_CONFIRM, false);
 
-      /* 2x COND_EXEC + 1x COPY_DATA + Nx DISPATCH_TASKMESH_DIRECT_ACE */
-      ace_predication_size += 2 * 5 + 6 + 6 * num_views;
+      if (gfx1013_skip_zero_pair) {
+         /* GFX1013 also hangs on the zero-dimensional direct ACE fallback.
+          * Predicate the normal ACE and matching GFX packets on count instead.
+          */
+         ace_predication_size += 5 + 6; /* 1x COND_EXEC + 1x COPY_DATA */
+      } else {
+         /* 2x COND_EXEC + 1x COPY_DATA + Nx DISPATCH_TASKMESH_DIRECT_ACE */
+         ace_predication_size += 2 * 5 + 6 + 6 * num_views;
+      }
    }
 
    radv_cs_emit_compute_predication(device, cmd_state, ace_cs, cmd_state->mec_inv_pred_va,
@@ -11508,6 +11520,9 @@ radv_emit_indirect_taskmesh_draw_packets(const struct radv_device *device, struc
    if (!view_mask) {
       radv_cs_emit_dispatch_taskmesh_indirect_multi_ace_packet(device, cmd_state, ace_cs, info->indirect_va,
                                                                info->count, info->count_va, info->stride);
+      if (gfx1013_skip_zero_pair)
+         ac_emit_cp_cond_exec(cs->b, pdev->info.gfx_level, info->count_va,
+                              4 /* DISPATCH_TASKMESH_GFX size */);
       radv_cs_emit_dispatch_taskmesh_gfx_packet(device, cmd_state, cs);
    } else {
       u_foreach_bit (view, view_mask) {
@@ -11515,11 +11530,14 @@ radv_emit_indirect_taskmesh_draw_packets(const struct radv_device *device, struc
 
          radv_cs_emit_dispatch_taskmesh_indirect_multi_ace_packet(device, cmd_state, ace_cs, info->indirect_va,
                                                                   info->count, info->count_va, info->stride);
+         if (gfx1013_skip_zero_pair)
+            ac_emit_cp_cond_exec(cs->b, pdev->info.gfx_level, info->count_va,
+                                 4 /* DISPATCH_TASKMESH_GFX size */);
          radv_cs_emit_dispatch_taskmesh_gfx_packet(device, cmd_state, cs);
       }
    }
 
-   if (workaround_cond_va) {
+   if (workaround_cond_va && !gfx1013_skip_zero_pair) {
       ac_emit_cp_cond_exec(ace_cs->b, pdev->info.gfx_level, workaround_cond_va,
                            6 * num_views /* Nx DISPATCH_TASKMESH_DIRECT_ACE */);
 
diff --git a/src/amd/vulkan/radv_physical_device.c b/src/amd/vulkan/radv_physical_device.c
index 3abd949..7c6c823 100644
--- a/src/amd/vulkan/radv_physical_device.c
+++ b/src/amd/vulkan/radv_physical_device.c
@@ -63,14 +63,27 @@ radv_perf_query_supported(const struct radv_physical_device *pdev)
 }
 
 static bool
-radv_taskmesh_enabled(const struct radv_physical_device *pdev)
+radv_mesh_enabled(const struct radv_physical_device *pdev)
 {
    const struct radv_instance *instance = radv_physical_device_instance(pdev);
 
    if (instance->debug_flags & RADV_DEBUG_NO_MESH_SHADER)
       return false;
 
-   return pdev->use_ngg && !pdev->use_llvm && pdev->info.gfx_level >= GFX10_3 && radv_compute_queue_enabled(pdev);
+   /* For GFX1013, gfx_level reaches GFX10_3 only when RADV_GFX103=1 is
+    * explicitly requested. Keep the hardware capability bit as an additional
+    * guard while leaving native GFX10.3+ devices unchanged.
+    */
+   return pdev->use_ngg && !pdev->use_llvm && pdev->info.gfx_level >= GFX10_3 &&
+          (pdev->info.family != CHIP_GFX1013 || pdev->info.has_gfx1013_mesh_shading);
+}
+
+static bool
+radv_task_enabled(const struct radv_physical_device *pdev)
+{
+   return radv_mesh_enabled(pdev) &&
+          (pdev->info.family != CHIP_GFX1013 || pdev->info.has_gfx1013_task_shading) &&
+          radv_compute_queue_enabled(pdev);
 }
 
 bool
@@ -812,7 +825,7 @@ radv_physical_device_get_supported_extensions(const struct radv_physical_device
       .EXT_map_memory_placed = true,
       .EXT_memory_budget = true,
       .EXT_memory_priority = true,
-      .EXT_mesh_shader = radv_taskmesh_enabled(pdev),
+      .EXT_mesh_shader = radv_mesh_enabled(pdev),
       .EXT_multi_draw = true,
       .EXT_mutable_descriptor_type = true, /* Trivial promotion from VALVE. */
       .EXT_nested_command_buffer = true,
@@ -907,7 +920,10 @@ static void
 radv_physical_device_get_features(const struct radv_physical_device *pdev, struct vk_features *features)
 {
    const struct radv_instance *instance = radv_physical_device_instance(pdev);
-   bool taskmesh_en = radv_taskmesh_enabled(pdev);
+   bool mesh_en = radv_mesh_enabled(pdev);
+   bool task_en = radv_task_enabled(pdev);
+   bool full_mesh_features =
+      mesh_en && pdev->info.gfx_level >= GFX10_3 && pdev->info.family != CHIP_GFX1013;
    bool has_perf_query = radv_perf_query_supported(pdev);
    bool has_shader_image_float_minmax = pdev->info.gfx_level != GFX8 && pdev->info.gfx_level != GFX9 &&
                                         pdev->info.gfx_level != GFX11 && pdev->info.gfx_level != GFX11_5;
@@ -1259,10 +1275,10 @@ radv_physical_device_get_features(const struct radv_physical_device *pdev, struc
       .minLod = true,
 
       /* VK_EXT_mesh_shader */
-      .meshShader = taskmesh_en,
-      .taskShader = taskmesh_en,
-      .multiviewMeshShader = taskmesh_en,
-      .primitiveFragmentShadingRateMeshShader = taskmesh_en,
+      .meshShader = mesh_en,
+      .taskShader = task_en,
+      .multiviewMeshShader = full_mesh_features,
+      .primitiveFragmentShadingRateMeshShader = full_mesh_features,
       .meshShaderQueries = false,
 
       /* VK_EXT_depth_clip_control */
@@ -1657,8 +1673,9 @@ radv_get_physical_device_properties(struct radv_physical_device *pdev)
    const bool has_fp16 = radv_shader_fp16_enabled(pdev);
    const bool enable_sparse = radv_sparse_enabled(pdev);
 
-   VkShaderStageFlags taskmesh_stages =
-      radv_taskmesh_enabled(pdev) ? VK_SHADER_STAGE_MESH_BIT_EXT | VK_SHADER_STAGE_TASK_BIT_EXT : 0;
+   VkShaderStageFlags taskmesh_stages = radv_mesh_enabled(pdev) ? VK_SHADER_STAGE_MESH_BIT_EXT : 0;
+   if (radv_task_enabled(pdev))
+      taskmesh_stages |= VK_SHADER_STAGE_TASK_BIT_EXT;
    VkShaderStageFlags rt_stages = radv_enable_rt(pdev) ? RADV_RT_STAGE_BITS : 0;
 
    bool accel_dot = pdev->info.compiler_info.has_accelerated_dot_product;
@@ -2214,7 +2231,7 @@ radv_get_physical_device_properties(struct radv_physical_device *pdev)
       .pipelineBinaryCompressedData = false,
 
       /* VK_KHR_compute_shader_derivatives */
-      .meshAndTaskShaderDerivatives = radv_taskmesh_enabled(pdev),
+      .meshAndTaskShaderDerivatives = radv_task_enabled(pdev),
 
       /* VK_EXT_device_generated_commands */
       .maxIndirectPipelineCount = 4096,
diff --git a/src/amd/vulkan/radv_pipeline.c b/src/amd/vulkan/radv_pipeline.c
index de01e10..9897569 100644
--- a/src/amd/vulkan/radv_pipeline.c
+++ b/src/amd/vulkan/radv_pipeline.c
@@ -513,7 +513,10 @@ radv_postprocess_nir(struct radv_device *device, const struct radv_graphics_stat
                .wave_size = stage->info.wave_size,
                .workgroup_size = stage->info.workgroup_size,
                .use_llvm = use_llvm,
