       aco_compile_shader(&ac_opts, &ac_info, shader_count, shaders, &args->ac, &radv_aco_build_shader_binary,
                          (void **)&binary);
diff --git a/src/amd/vulkan/radv_shader_args.c b/src/amd/vulkan/radv_shader_args.c
index 62baa82..930c6a7 100644
--- a/src/amd/vulkan/radv_shader_args.c
+++ b/src/amd/vulkan/radv_shader_args.c
@@ -617,7 +617,9 @@ declare_shader_args(struct radv_shader_args_state *state, const struct radv_devi
       declare_global_input_sgprs(state, gfx_level, info, user_sgpr_info);
 
       if (info->cs.uses_grid_size) {
-         if (device->load_grid_size_from_user_sgpr)
+         if (device->load_grid_size_from_user_sgpr ||
+             (stage == MESA_SHADER_TASK && pdev->info.family == CHIP_GFX1013 &&
+              pdev->info.gfx_level >= GFX10_3 && pdev->info.has_gfx1013_task_shading))
             RADV_ADD_UD_ARG(state, 3, AC_ARG_VALUE, ac.num_work_groups, AC_UD_CS_GRID_SIZE);
          else
             RADV_ADD_UD_ARG(state, 2, AC_ARG_CONST_ADDR, ac.num_work_groups, AC_UD_CS_GRID_SIZE);
