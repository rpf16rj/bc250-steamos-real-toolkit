    bool optimisations_disabled;
    uint8_t enable_mrt_output_nan_fixup;
    bool wgp_mode;
diff --git a/src/amd/compiler/instruction_selection/aco_isel_setup.cpp b/src/amd/compiler/instruction_selection/aco_isel_setup.cpp
index 3c0a9bb1889..f1efbe156d7 100644
--- a/src/amd/compiler/instruction_selection/aco_isel_setup.cpp
+++ b/src/amd/compiler/instruction_selection/aco_isel_setup.cpp
@@ -775,9 +775,11 @@ setup_isel_context(Program* program, unsigned shader_count, struct nir_shader* c
    program->workgroup_size = program->info.workgroup_size;
    assert(program->workgroup_size);
 
-   /* Mesh shading only works on GFX10.3+. */
+   /* Mesh shading normally requires GFX10.3+. GFX1013 can use the
+    * experimental path when RADV explicitly enables its mesh capability.
+    */
    ASSERTED bool mesh_shading = ctx.stage.has(SWStage::TS) || ctx.stage.has(SWStage::MS);
-   assert(!mesh_shading || ctx.program->gfx_level >= GFX10_3);
+   assert(!mesh_shading || options->has_mesh_shading);
 
