diff --git a/src/amd/vulkan/radv_cmd_buffer.c b/src/amd/vulkan/radv_cmd_buffer.c
index 09e10b3b16a..e2ba24bb829 100644
--- a/src/amd/vulkan/radv_cmd_buffer.c
+++ b/src/amd/vulkan/radv_cmd_buffer.c
@@ -3195,7 +3195,8 @@ radv_emit_hw_ngg(struct radv_cmd_buffer *cmd_buffer, const struct radv_shader *e
        *
        * Requirement: GE_CNTL.VERT_GRP_SIZE = VGT_GS_ONCHIP_CNTL.ES_VERTS_PER_SUBGRP - 5
        */
-      if (pdev->info.gfx_level == GFX10 && es_type != MESA_SHADER_TESS_EVAL && ngg_state->hw_max_esverts != 256) {
+      if (pdev->info.gfx_level == GFX10 && shader->info.stage != MESA_SHADER_MESH &&
+          es_type != MESA_SHADER_TESS_EVAL && ngg_state->hw_max_esverts != 256) {
          ge_cntl &= C_03096C_VERT_GRP_SIZE;
 
          if (ngg_state->hw_max_esverts > 5) {
@@ -8849,10 +8850,13 @@ radv_bind_pre_rast_shader(struct radv_cmd_buffer *cmd_buffer, const struct radv_
    }
 
    if ((shader->info.stage == MESA_SHADER_MESH) != !!(cmd_buffer->state.active_stages & VK_SHADER_STAGE_MESH_BIT_EXT)) {
-      /* Re-emit VRS state because the combiner is different (vertex vs primitive). Re-emit
-       * primitive topology because the mesh shading pipeline clobbered it.
+      /* Re-emit primitive topology because the mesh shading pipeline clobbered
+       * it. Real GFX10.3+ hardware also needs VRS state; GFX1013 has no FSR
+       * hardware even when RADV_GFX103 promotes its software gfx_level.
        */
-      cmd_buffer->state.dirty |= RADV_CMD_DIRTY_FSR_STATE | RADV_CMD_DIRTY_VGT_PRIM_STATE;
+      cmd_buffer->state.dirty |= RADV_CMD_DIRTY_VGT_PRIM_STATE;
+      if (pdev->info.gfx_level >= GFX10_3 && pdev->info.family != CHIP_GFX1013)
+         cmd_buffer->state.dirty |= RADV_CMD_DIRTY_FSR_STATE;
    }
 
    if (cmd_buffer->state.force_vrs_per_vertex != shader->info.force_vrs_per_vertex) {
@@ -11922,6 +11926,7 @@ radv_emit_indirect_taskmesh_draw_packets(const struct radv_device *device, struc
    const struct radv_physical_device *pdev = radv_device_physical(device);
    const uint32_t view_mask = cmd_state->render.view_mask;
    const unsigned num_views = MAX2(1, util_bitcount(view_mask));
+   const bool gfx1013_skip_zero_pair = workaround_cond_va && pdev->info.family == CHIP_GFX1013;
    unsigned ace_predication_size = num_views * 11; /* DISPATCH_TASKMESH_INDIRECT_MULTI_ACE size */
 
    if (pdev->info.has_taskmesh_indirect0_bug && info->count_va) {
@@ -11940,8 +11945,15 @@ radv_emit_indirect_taskmesh_draw_packets(const struct radv_device *device, struc
       ac_emit_cp_copy_data(ace_cs->b, COPY_DATA_IMM, COPY_DATA_DST_MEM, 1, workaround_cond_va,
                            AC_CP_COPY_DATA_WR_CONFIRM, false);
 
-      /* 2x COND_EXEC + 1x COPY_DATA + Nx DISPATCH_TASKMESH_DIRECT_ACE */
-      ace_predication_size += 2 * 5 + 6 + 6 * num_views;
+      if (gfx1013_skip_zero_pair) {
+         /* GFX1013 also hangs on the zero-dimensional direct ACE fallback.
+          * Predicate the normal ACE and matching GFX packets on count instead.
+          */
+         ace_predication_size += 5 + 6; /* 1x COND_EXEC + 1x COPY_DATA */
+      } else {
+         /* 2x COND_EXEC + 1x COPY_DATA + Nx DISPATCH_TASKMESH_DIRECT_ACE */
+         ace_predication_size += 2 * 5 + 6 + 6 * num_views;
+      }
    }
 
    radv_cs_emit_compute_predication(device, cmd_state, ace_cs, cmd_state->cond_render.mec_inv_pred_va,
@@ -11958,6 +11970,9 @@ radv_emit_indirect_taskmesh_draw_packets(const struct radv_device *device, struc
    if (!view_mask) {
       radv_cs_emit_dispatch_taskmesh_indirect_multi_ace_packet(device, cmd_state, ace_cs, info->indirect_va,
                                                                info->count, info->count_va, info->stride);
+      if (gfx1013_skip_zero_pair)
+         ac_emit_cp_cond_exec(cs->b, pdev->info.gfx_level, info->count_va,
+                              4 /* DISPATCH_TASKMESH_GFX size */);
       radv_cs_emit_dispatch_taskmesh_gfx_packet(device, cmd_state, cs);
    } else {
       u_foreach_bit (view, view_mask) {
@@ -11965,11 +11980,14 @@ radv_emit_indirect_taskmesh_draw_packets(const struct radv_device *device, struc
 
          radv_cs_emit_dispatch_taskmesh_indirect_multi_ace_packet(device, cmd_state, ace_cs, info->indirect_va,
                                                                   info->count, info->count_va, info->stride);
+         if (gfx1013_skip_zero_pair)
+            ac_emit_cp_cond_exec(cs->b, pdev->info.gfx_level, info->count_va,
+                                 4 /* DISPATCH_TASKMESH_GFX size */);
          radv_cs_emit_dispatch_taskmesh_gfx_packet(device, cmd_state, cs);
       }
    }
 
-   if (workaround_cond_va) {
+   if (workaround_cond_va && !gfx1013_skip_zero_pair) {
       ac_emit_cp_cond_exec(ace_cs->b, pdev->info.gfx_level, workaround_cond_va,
                            6 * num_views /* Nx DISPATCH_TASKMESH_DIRECT_ACE */);
 
