+static int cyan_skillfish_get_current_gfxclk(struct smu_context *smu,
+					     uint32_t *value, uint32_t fallback)
+{
+	struct cyan_skillfish_metrics_cache *cache = smu->smu_table.metrics_table;
+	unsigned long flags, now = jiffies;
+	unsigned int cache_ms = cs_gfxclk_cache_ms;
+	int ret;
+
+	if (cache_ms) {
+		spin_lock_irqsave(&cache->gfxclk_lock, flags);
+		if (cache->gfxclk_valid &&
+		    time_before(now, cache->gfxclk_time +
+				msecs_to_jiffies(cache_ms))) {
+			*value = cache->gfxclk;
+			spin_unlock_irqrestore(&cache->gfxclk_lock, flags);
+			return 0;
+		}
+		spin_unlock_irqrestore(&cache->gfxclk_lock, flags);
+	}
+
+	ret = smu_cmn_send_smc_msg(smu, SMU_MSG_GetGfxclkFrequency, value);
+	if (ret && !cyan_skillfish_use_hybrid_metrics()) {
+		*value = fallback;
+		ret = 0;
+	}
+
+	if (!ret && cache_ms) {
+		spin_lock_irqsave(&cache->gfxclk_lock, flags);
+		cache->gfxclk = *value;
+		cache->gfxclk_time = jiffies;
+		cache->gfxclk_valid = true;
+		spin_unlock_irqrestore(&cache->gfxclk_lock, flags);
+	}
+
+	return ret;
+}
