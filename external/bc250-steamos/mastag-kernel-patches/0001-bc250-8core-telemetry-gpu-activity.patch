+		smu, &gfxclk, metrics->Current.GfxclkFrequency);
+	if (ret)
+		size += sysfs_emit_at(buf, size, "gfx:      n/a          %4u C\n",
+				      metrics->Current.GfxTemperature / 100);
+	else
+		size += sysfs_emit_at(buf, size, "gfx:   %5uMHz          %4u C\n",
+				      gfxclk, metrics->Current.GfxTemperature / 100);
+
+	size += sysfs_emit_at(buf, size, "soc:   %5uMHz          %4u C\n",
+			      metrics->Current.SocclkFrequency,
+			      metrics->Current.SocTemperature / 100);
+	size += sysfs_emit_at(buf, size, "vclk:  %5uMHz\n",
+			      metrics->Current.VclkFrequency);
+	size += sysfs_emit_at(buf, size, "dclk:  %5uMHz\n",
+			      metrics->Current.DclkFrequency);
+	size += sysfs_emit_at(buf, size, "mem:   %5uMHz\n",
+			      metrics->Current.MemclkFrequency);
+	size += sysfs_emit_at(buf, size, "edge:                    %4u C\n",
+			      metrics->Current.EdgeTemperature / 100);
+
+	size += sysfs_emit_at(buf, size, "\n");
+	for (i = 0; i < 2; i++)
+		size += sysfs_emit_at(buf, size, "pd %s: %5umV  %4uA  %4uW\n",
+				      i == 0 ? "cpu" : "gpu",
+				      metrics->Current.Voltage[i],
+				      metrics->Current.Current[i] / 1000,
+				      metrics->Current.Power[i] / 1000);
+	size += sysfs_emit_at(buf, size, "pd socket:          %4uW\n",
+			      metrics->Current.CurrentSocketPower / 1000);
+
+	size += sysfs_emit_at(buf, size, "\nthrottle: 0x%x\n\n",
+			      metrics->Current.ThrottlerStatus);
+
+	*size_ptr = size;
+	return 0;
+}
