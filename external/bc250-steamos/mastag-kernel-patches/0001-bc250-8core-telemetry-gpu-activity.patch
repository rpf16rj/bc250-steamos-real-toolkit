+static int cyan_skillfish_emit_smu_table(struct smu_context *smu, char *buf,
+					 int *size_ptr)
+{
+	struct smu_table_context *smu_table = &smu->smu_table;
+	SmuMetrics_t *metrics = (SmuMetrics_t *)smu_table->metrics_table;
+	int size = *size_ptr;
+	uint32_t gfxclk = 0;
+	bool hybrid;
+	int ret, i;
+
+	ret = cyan_skillfish_refresh_metrics_table(smu);
+	if (ret)
+		return ret;
+
+	hybrid = cyan_skillfish_use_hybrid_metrics();
+
+	size += sysfs_emit_at(buf, size, "layout: %s\n",
+			      hybrid ? "8-core hybrid" : "6-core stock");
+
+	if (hybrid) {
+		/*
+		 * Reinterpret the Current table using the 8-core layout. Per-core
+		 * coverage is not uniform, so print "n/a" where the firmware has
+		 * no slot rather than a value belonging to a different field.
+		 */
+		SmuMetricsTable_hybrid_t hcur;
+
+		memcpy(&hcur, &metrics->Current, sizeof(hcur));
+
+		size += sysfs_emit_at(buf, size,
+				      "\ncore     clk     power    temp    C0%%\n");
+		for (i = 0; i < 8; i++) {
+			size += sysfs_emit_at(buf, size, "core %d: %5uMHz", i,
+					      hcur.CoreFrequency[i]);
+			if (i >= 1)
+				size += sysfs_emit_at(buf, size, "  %5uW",
+						      hcur.CorePower[i - 1] / 1000);
+			else
+				size += sysfs_emit_at(buf, size, "     n/a");
+			if (i == 4 || i == 5)
+				size += sysfs_emit_at(buf, size, "  %4u C",
+						      hcur.CoreTemperature[i - 4] / 100);
+			else
+				size += sysfs_emit_at(buf, size, "     n/a");
+			if (i <= 6)
+				size += sysfs_emit_at(buf, size, "  %4u\n",
+						      hcur.C0Residency[i]);
+			else
+				size += sysfs_emit_at(buf, size, "   n/a\n");
+		}
+
+		size += sysfs_emit_at(buf, size, "\n");
+		for (i = 0; i < 2; i++)
+			size += sysfs_emit_at(buf, size,
+					      "L3 #%d: %5uMHz          %4u C\n",
+					      i, hcur.L3Frequency[i],
+					      hcur.L3Temperature[i] / 100);
+	} else {
+		size += sysfs_emit_at(buf, size,
+				      "\ncore     clk     power    temp    C0%%\n");
+		for (i = 0; i < 6; i++)
+			size += sysfs_emit_at(buf, size,
+					      "core %d: %5uMHz  %5uW  %4u C  %4u\n",
+					      i,
+					      metrics->Current.CoreFrequency[i],
+					      metrics->Current.CorePower[i] / 1000,
+					      metrics->Current.CoreTemperature[i] / 100,
+					      metrics->Current.C0Residency[i]);
+
+		size += sysfs_emit_at(buf, size, "\n");
+		for (i = 0; i < 2; i++)
+			size += sysfs_emit_at(buf, size,
+					      "L3 #%d: %5uMHz          %4u C\n",
+					      i, metrics->Current.L3Frequency[i],
+					      metrics->Current.L3Temperature[i] / 100);
+	}
+
+	/*
+	 * In the hybrid layout the stock GfxclkFrequency slot is occupied by
+	 * C0Residency[6]. Reuse the cached direct SMU mailbox helper instead of
+	 * interpreting that slot or refreshing the metrics table a second time.
+	 */
+	size += sysfs_emit_at(buf, size, "\n");
